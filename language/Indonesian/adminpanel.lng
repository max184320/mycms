's_not_found'           =>   "Tidak ada yang ditemukan",
'system_find'           =>   "Pencarian berdasarkan pengaturan",
'opt_sys_inden'			=>	 "Penyedia untuk notifikasi IndexNow",
'opt_sys_indend'		=>	 "Pilih penyedia notifikasi IndexNow yang akan digunakan untuk memberi tahu mesin pencari. Pilihan penyedia tidak memengaruhi mesin pencari mana yang akan diberi tahu, karena pada akhirnya semuanya akan diberi tahu secara otomatis. Namun, pilihan penyedia memengaruhi kecepatan respons pemberitahuan, jadi pilih penyedia yang merespons situs Anda paling cepat dan yang lokasinya paling dekat.",
'opt_sys_qemo'			=>	 "Mode pengeditan cepat publikasi di situs:",
'opt_sys_qemod'			=>	 "Anda dapat memilih mode yang akan digunakan untuk pengeditan cepat di situs. Jika mode hanya bidang yang telah diisi dipilih, saat pengeditan cepat hanya bidang yang sebelumnya telah diisi pada berita ketika ditambahkan yang akan ditampilkan. Jika mode pengeditan semua bidang dipilih, maka dalam pengeditan cepat semua bidang yang tersedia untuk publikasi ini dapat diedit dan diisi.",
'opt_sys_qemo1'			=>	 "Hanya bidang yang sebelumnya terisi",
