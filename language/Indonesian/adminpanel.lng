// 9.5
'group_mcmd'			=>	"Jumlah maksimum komentar per hari",
'hint_gmcmd'			=>	"Tentukan jumlah maksimum komentar yang boleh ditambahkan pengguna per hari. Untuk menghapus batas ini, biarkan bidang kosong atau tentukan 0.",
'group_max_images'		=>	"Jumlah maksimum gambar untuk diunggah dalam satu publikasi",
'hint_max_images'		=>	"Jika pengguna diizinkan mengunggah gambar untuk berita ke server, Anda dapat menetapkan batas jumlah maksimum gambar yang boleh diunggah pengguna untuk satu berita. Untuk menghapus batas ini, biarkan bidang kosong atau tentukan 0.",
'group_max_files'		=>	"Jumlah maksimum file untuk diunggah dalam satu publikasi",
'hint_max_files'		=>	"Jika pengguna diizinkan mengunggah file untuk berita ke server, Anda dapat menetapkan batas jumlah maksimum file yang boleh diunggah pengguna untuk satu berita. Untuk menghapus batas ini, biarkan bidang kosong atau tentukan 0.",
'error_max_images'		=>	"Jumlah maksimum gambar yang diizinkan telah diunggah",
