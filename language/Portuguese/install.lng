51, .5);\">\r\n                            Notificação de adição de comentário no site\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"background-color:#ffffff; color:#000000; text-align:left; padding:20px; border-bottom-left-radius:6px; border-bottom-right-radius:6px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                            Prezado {%username_to%},<br><br>notificamos que um comentário foi adicionado a uma notícia no site {$url} na qual você estava inscrito.<br><br>------------------------------------------------<br>Breve informação sobre o comentário<br>------------------------------------------------<br><br>Autor: {%username%}<br>Data de adição: {%date%}<br>Link para a notícia: {%link%}<br><br>------------------------------------------------<br>Texto do comentário<br>------------------------------------------------<br><br>{%text%}<br><br>------------------------------------------------<br><br>Se você não deseja mais receber notificações de novos comentários para esta notícia, siga este link: <a href=\"{%unsubscribe%}\" target=\"_blank\">{%unsubscribe%}</a><br><br>Atenciosamente,<br>Administração {$url}\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n\r\n</html>",
'install_64'	=>	"<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Notificação de recebimento de mensagem pessoal no site</title>\r\n    <style type=\"text/css\">\r\n        html,\r\n        body {\r\n          font-family: system-ui, sans-serif;\r\n          line-height: 1.5;\r\n          font-size: 14px;\r\n        }\r\n        \r\n        p {\r\n          margin-top: 0;\r\n          margin-bottom: 11px;\r\n        }\r\n        \r\n        p:last-child {\r\n          margin-bottom: 0;\r\n        }\r\n        \r\n        a:active,\r\n        a:visited,\r\n        a:link {\r\n          color: #4C6891;\r\n          text-decoration: none;\r\n        }\r\n        \r\n        a:hover {\r\n          color: #4C6891;\r\n          text-decoration: underline;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body style=\"margin:0; padding:0; background-color:#f0f0f0; font-family: system-ui, sans-serif; font-size:14px;\">\r\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; font-family: system-ui, sans-serif; font-size:14px;\">\r\n        <tr>\r\n            <td align=\"center\" style=\"padding:20px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: separate; border-spacing: 0; max-width:1024px; background-color:#ffffff; border-radius:10px; box-shadow:0 16px 16px -10px rgba(34,47,62,.15),0 0 40px 1px rgba(34,47,62,.15); font-family: system-ui, sans-serif; font-size:14px;\">\r\n                    <tr>\r\n                        <td style=\"background-color:#4C6891; color:#ffffff; padding-left:20px; padding-right:20px; padding-top:12px; padding-bottom:12px; vertical-align:middle; border-top-left-radius:6px; border-top-right-radius:6px; font-family: system-ui, sans-serif; font-size:15px;text-shadow:1px 1px 2px rgba(51, 51, 51, .5);\">\r\n                            Notificação de recebimento de mensagem pessoal no site\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"background-color:#ffffff; color:#000000; text-align:left; padding:20px; border-bottom-left-radius:6px; border-bottom-right-radius:6px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                            Prezado {%username%},<br><br>notificamos que uma mensagem pessoal foi enviada para você no site {$url}.<br><br>------------------------------------------------<br>Breve informação sobre a mensagem<br>------------------------------------------------<br><br>Remetente: {%fromusername%}<br>Data de recebimento: {%date%}<br>Assunto: {%title%}<br><br>------------------------------------------------<br>Texto da mensagem<br>------------------------------------------------<br><br>{%text%}<br><br>Atenciosamente,<br>Administração {$url}\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n\r\n</html>",
'install_65'	=>	"<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Notificação de conexão de rede social à conta</title>\r\n    <style type=\"text/css\">\r\n        html,\r\n        body {\r\n          font-family: system-ui, sans-serif;\r\n          line-height: 1.5;\r\n          font-size: 14px;\r\n        }\r\n        \r\n        p {\r\n          margin-top: 0;\r\n          margin-bottom: 11px;\r\n        }\r\n        \r\n        p:last-child {\r\n          margin-bottom: 0;\r\n        }\r\n        \r\n        a:active,\r\n        a:visited,\r\n        a:link {\r\n          color: #4C6891;\r\n          text-decoration: none;\r\n        }\r\n        \r\n        a:hover {\r\n          color: #4C6891;\r\n          text-decoration: underline;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body style=\"margin:0; padding:0; background-color:#f0f0f0; font-family: system-ui, sans-serif; font-size:14px;\">\r\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; font-family: system-ui, sans-serif; font-size:14px;\">\r\n        <tr>\r\n            <td align=\"center\" style=\"padding:20px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: separate; border-spacing: 0; max-width:1024px; background-color:#ffffff; border-radius:10px; box-shadow:0 16px 16px -10px rgba(34,47,62,.15),0 0 40px 1px rgba(34,47,62,.15); font-family: system-ui, sans-serif; font-size:14px;\">\r\n                    <tr>\r\n                        <td style=\"background-color:#4C6891; color:#ffffff; padding-left:20px; padding-right:20px; padding-top:12px; padding-bottom:12px; vertical-align:middle; border-top-left-radius:6px; border-top-right-radius:6px; font-family: system-ui, sans-serif; font-size:15px;text-shadow:1px 1px 2px rgba(51, 51, 51, .5);\">\r\n                            Notificação de conexão de rede social à conta\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"background-color:#ffffff; color:#000000; text-align:left; padding:20px; border-bottom-left-radius:6px; border-bottom-right-radius:6px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                            Prezado {%username%},<br><br>Você solicitou a vinculação da sua conta no site {$url} com a sua conta na rede social {%network%}. No entanto, por razões de segurança, você precisa confirmar esta ação no seguinte link:<br><br>------------------------------------------------<br><a href=\"{%link%}\" target=\"_blank\">{%link%}</a><br>------------------------------------------------<br><br>Se você não fez esta solicitação, simplesmente exclua este e-mail; os dados da sua conta estão guardados em um local seguro e inacessível a terceiros.<br><br>Endereço IP do remetente: {%ip%}<br><br>Atenciosamente,<br>Administração {$url}\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n\r\n</html>",
'install_66'	=>	"<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>{%title%}</title>\r\n    <style type=\"text/css\">\r\n        html,body{\r\n          font-family: system-ui, sans-serif;\r\n          line-height: 1.5;\r\n          font-size: 14px;\r\n        }\r\n        p {\r\n          margin-top: 0;\r\n          margin-bottom: 11px;\r\n        }\r\n        p:last-child {\r\n          margin-bottom: 0;\r\n        }     \r\n        a:active,\r\n        a:visited,\r\n        a:link {\r\n          color: #4C6891;\r\n          text-decoration:none;\r\n        }\r\n        \r\n        a:hover {\r\n          color: #4C6891;\r\n          text-decoration: underline;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body style=\"margin:0; padding:0; background-color:#f0f0f0; font-family: system-ui, sans-serif; font-size:14px;\">\r\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; font-family: system-ui, sans-serif; font-size:14px;\">\r\n        <tr>\r\n            <td align=\"center\" style=\"padding:20px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: separate; border-spacing: 0; max-width:1024px; background-color:#ffffff; border-radius:10px; box-shadow:0 16px 16px -10px rgba(34,47,62,.15),0 0 40px 1px rgba(34,47,62,.15); font-family: system-ui, sans-serif; font-size:14px;\">\r\n                    <tr>\r\n                        <td style=\"background-color:#4C6891; color:#ffffff; padding-left:20px; padding-right:20px; padding-top:12px; padding-bottom:12px; vertical-align:middle; border-top-left-radius:6px; border-top-right-radius:6px; font-family: system-ui, sans-serif; font-size:15px;text-shadow:1px 1px 2px rgba(51, 51, 51, .5);\">\r\n                            {%title%}\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"background-color:#ffffff; color:#000000; text-align:left; padding:20px; border-bottom-left-radius:6px; border-bottom-right-radius:6px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n                            {%content%}\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n\r\n</html>",
'install_67'	=>	"<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Autenticação de dois fatores</title>\r\n  <style type=\"text/css\">\r\n    html,\r\n    body {\r\n      font-family: system-ui, sans-serif;\r\n      line-height: 1.5;\r\n      font-size: 14px;\r\n    }\r\n\r\n    p {\r\n      margin-top: 0;\r\n      margin-bottom: 11px;\r\n    }\r\n\r\n    p:last-child {\r\n      margin-bottom: 0;\r\n    }\r\n\r\n    a:active,\r\n    a:visited,\r\n    a:link {\r\n      color: #4C6891;\r\n      text-decoration: none;\r\n    }\r\n\r\n    a:hover {\r\n      color: #4C6891;\r\n      text-decoration: underline;\r\n    }\r\n  </style>\r\n</head>\r\n<body style=\"margin:0; padding:0; background-color:#f0f0f0; font-family: system-ui, sans-serif; font-size:14px;\">\r\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; font-family: system-ui, sans-serif; font-size:14px;\">\r\n    <tr>\r\n      <td align=\"center\" style=\"padding:20px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: separate; border-spacing: 0; max-width:1024px; background-color:#ffffff; border-radius:10px; box-shadow:0 16px 16px -10px rgba(34,47,62,.15),0 0 40px 1px rgba(34,47,62,.15); font-family: system-ui, sans-serif; font-size:14px;\">\r\n          <tr>\r\n            <td style=\"background-color:#4C6891; color:#ffffff; padding-left:20px; padding-right:20px; padding-top:12px; padding-bottom:12px; vertical-align:middle; border-top-left-radius:6px; border-top-right-radius:6px; font-family: system-ui, sans-serif; font-size:15px;text-shadow:1px 1px 2px rgba(51, 51, 51, .5);\">\r\n              Autenticação de dois fatores\r\n            </td>\r\n          </tr>\r\n          <tr>\r\n            <td style=\"background-color:#ffffff; color:#000000; text-align:left; padding:20px; border-bottom-left-radius:6px; border-bottom-right-radius:6px; font-family: system-ui, sans-serif; font-size:14px;\">\r\n{%username%},<br><br>Este e-mail foi enviado do site {$url}<br><br>Você recebeu este e-mail porque a autenticação de dois fatores está ativada para sua conta. Para fazer login no site, você precisa inserir o código PIN recebido.<br><br>------------------------------------------------<br>Código PIN:<br>------------------------------------------------<br><br>{%pin%}<br><br>------------------------------------------------<br>Se você não fez login no nosso site, sua senha é conhecida por terceiros. Você deve acessar imediatamente o site com seu login e senha e alterar sua senha em seu perfil.<br><br>Endereço IP do usuário que inseriu a senha: {%ip%}<br><br>Atenciosamente,<br>Administração {$url}\r\n           </td>\r\n          </tr>\r\n        </table>\r\n      </td>\r\n    </tr>\r\n  </table>\r\n</body>\r\n</html>",

