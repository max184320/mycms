'opt_sys_mbccd'			=>	"Se você selecionar &#39;Ativado&#39;, ao enviar mensagens, vários destinatários serão indicados como destinatários, o que reduz o tempo total de envio de mensagens e a quantidade de mensagens enviadas.",

'b_select'				=>	"Atribuir",
