'rsschannel_del'        =>  "Tem certeza de que deseja excluir este canal RSS? Esta ação não pode ser desfeita.",
'usergroup_del'         =>  "Tem certeza de que deseja excluir este grupo de usuários? Esta ação não pode ser desfeita.",
'banners_c_opt'         =>  "Exibição do bloco entre os comentários",
