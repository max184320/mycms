'user_timezone'			=>	"Fuso orario:",
'system_default'		=>	"Impostazioni di sistema predefinite",
'user_err_5'			=>	"I campi aggiuntivi contengono valori non validi per la pubblicazione.",
'links_m_act'			=>	"Sostituzione:",
