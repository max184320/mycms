'plugins_upgr_s1'		=>	"يتوفر إصدار جديد لهذه الإضافة",
'plugins_upgr_s2'		=>	"هل ترغب في تحديث هذه الإضافة إلى الإصدار الحالي؟",
'plugins_upgr_s3'		=>	"تحديث",
'opt_sys_rtp_4'			=>  "&#39;أعجبني&#39; و &#39;لم يعجبني&#39;",
// 13.1

// 13.0
'upgr_dbtitle'			=>	"تحويل قاعدة البيانات",
'upgr_dbtitle_1'		=>	"تحويل قاعدة البيانات إلى ترميز utf-8",
'upgr_dbinfo'			=>	"لمتابعة العمل، يجب تحويل قاعدة البيانات والقوالب الخاصة بك إلى ترميز utf-8. سيحاول DataLife Engine تحويل قاعدة البيانات والقوالب تلقائياً، ولكن في قواعد البيانات الكبيرة جداً قد لا تكفي حدود الخادم لذلك. لذا، قبل المتابعة، يجب عليك عمل نسخة احتياطية لقاعدة البيانات والقوالب، حتى تتمكن من إجراء التحويل اليدوي في حال حدوث مشكلات.",
'upgr_file'				=>	"الاسم",
'upgr_file_1'			=>	"لا توجد صلاحيات كتابة",
'upgr_file_2'			=>	"تم اكتشاف عدم وجود صلاحيات كتابة. يجب عليك ضبط التصريح <b>CHMOD 777</b> للمجلدات، وضبط التصريح <b>CHMOD 666</b> للملفات لمتابعة العمل:",
'upgr_minsql'			=>	"إصدار MySQL المثبت على خادمك هو <b>{version}</b>، ولتحويل قاعدة البيانات يلزم إصدار MySQL لا يقل عن 5.5.3",
'upgr_btn_1'			=>	"التحقق مرة أخرى",
'upgr_btn_2'			=>	"بدء التحويل",
'upgr_c_err'			=>	"يجب عليك حل المشكلات المذكورة لمتابعة العمل.",
'upgr_noclose'			=>	"تنبيه: جاري تحويل بيانات الموقع، لا تغلق هذه النافذة حتى تكتمل العملية تماماً",
'upgr_next'				=>	"متابعة",
'upgr_all_conv'			=>	"لا يلزم تحويل قاعدة البيانات. جميع الجداول بالترميز الحالي.",
'upgr_table_conv'		=>	"تحويل الجدول:",
'upgr_templ_conv'		=>	"تحويل القوالب ...",
'upgr_sett_conv'		=>	"تحويل الإعدادات ...",
'upgr_error'			=>	"<span class=\"text-danger\">خطأ في تنفيذ العملية</span>",
'upgr_utf8'				=>	"<b>تنبيه:</b><br>ترميز قاعدة البيانات الخاصة بك هو utf-8 العادي. لدعم جميع رموز هذا الترميز بشكل كامل، من الضروري استخدام ترميز utf8mb4 ذو الأربعة بايت. باستخدام ترميز utf8mb4 يمكنك، على سبيل المثال، إضافة دعم لرموز Emoji والعديد من الرموز الأخرى لموقعك. يمكنك تحويل قاعدة البيانات الخاصة بك عبر الرابط: <a href=\"?mod=upgrade&action=dbconvert&subaction=onlymb4\" >تحويل قاعدة البيانات</a>",
'upgr_demo'				=>	"<b>تنبيه:</b><br>يوجد على خادمك ملفات من النسخة التجريبية (Demo) ذات الكود المصدري المغلق. ومع ذلك، فقد قمت بشراء وتفعيل الترخيص، وبالتالي يمكنك تحديث الملفات على الخادم بملفات النسخة المدفوعة ذات الكود المصدري المفتوح، لتتمكن مثلاً من استخدام نظام الإضافات في الموقع. يمكنك تحديث ملفاتك عبر الرابط: <a href=\"?mod=upgrade\" >تحديث ملفات DataLife Engine</a>",
'upgr_demo_1'			=>	"أنت تستخدم النسخة التجريبية من سكريبت DataLife Engine. في النسخة التجريبية، يكون الكود المصدري للسكريبت مغلقاً، وللأسف نظام الإضافات غير متاح لك لأنه يتطلب كوداً مصدرياً مفتوحاً. يجب عليك شراء ترخيص، وتحديث ملفات السكريبت بملفات النسخة المدفوعة ذات الكود المصدري المفتوح.",
'upgr_notadm'			=>	"لمتابعة عمل السكريبت، من الضروري إجراء التحديث. قم بتسجيل الدخول إلى لوحة تحكم السكريبت كمسؤول للموقع",
'upgr_dbtitle_2'		=>	"معالج تحديث DataLife Engine",
'upgr_dbtitle_3'		=>	"تحديث السكريبت إلى الإصدار الحالي",
'upgr_info'				=>	"سيتم الآن تحديث قاعدة البيانات الخاصة بك إلى الإصدار الحالي من السكريبت. سيتم تحديث قاعدة البيانات خطوة بخطوة من الإصدار <b>{oldversion}</b> إلى <b>{newversion}</b>.",
'upgr_all_upg'			=>	"لا يلزم تحديث السكريبت. أنت تستخدم الإصدار الحالي من السكريبت.",
'upgr_act_info'			=>	"مرحباً بك في نظام التحديث التلقائي لـ DataLife Engine. قبل متابعة التحديث، تأكد من عمل نسخة احتياطية لملفاتك على الخادم ونسخة احتياطية لقاعدة البيانات، وإلا في حال حدوث مشكلات، لن يكون من الممكن استعادة بياناتك.<br><br>لمتابعة تحديث السكريبت، يجب إدخال مفتاح الترخيص الخاص بك. للتحديث التلقائي للسكريبت، يلزم وجود اتصال بالإنترنت بين خادمك وموقع https://dle-news.com/",
'upgr_noclose_2'		=>	"أثناء تحديث الموقع، لا تغلق هذه النافذة حتى تكتمل العملية تماماً",
'upgr_no_upg_files'		=>	"التحديث من الإصدار <b>{version}</b> غير ممكن للأسف. ملفات التحديث المطلوبة مفقودة.",
'upgr_db_ver'			=>	"تحديث السكريبت إلى الإصدار:",
'upgr_db_success'		=>	"اكتمل تحديث السكريبت إلى الإصدار <b>{version}</b>. قم بإجراء التغييرات في قوالبك وفقاً لقائمة التغييرات المنشورة على الموقع: <a href=\"https://dle-news.com/templates-changelog.html\" target=\"_blank\">https://dle-news.com/templates-changelog.html</a>",
'upgr_db_errors'		=>	"حدثت الأخطاء التالية أثناء تحديث السكريبت:",
'upgr_db_query'			=>	"الاستعلام:",
'upgr_db_errt'			=>	"الخطأ:",
'upgr_f_error_1'		=>	"فشل الاتصال بخادم تحديث DataLife Engine. حاول مرة أخرى لاحقاً. من الممكن أيضاً أن تكون الاتصالات بالمواقع الخارجية محظورة على خادمك، وفي هذه الحالة يجب عليك تحديث DataLife Engine يدوياً.",
'upgr_f_error_2'		=>	"تم إدخال مفتاح ترخيص غير صحيح",
'upgr_f_error_3'		=>	"انتهت صلاحية ترخيصك. لتحديث السكريبت في موقعك، يجب عليك تجديد ترخيصك في ملفك الشخصي على موقع dle-news.com",
'upgr_f_error_4'		=>	"مفتاحك مسجل لنطاق آخر. لا يمكنك تحديث السكريبت على هذا النطاق باستخدام هذا المفتاح",
