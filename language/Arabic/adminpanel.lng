// 10.1
'opt_sys_amet'			=>	"التوليد التلقائي لعلامات الميتا &#39;description&#39; و &#39;keywords&#39; للمنشورات",
'opt_sys_ametd'			=>	"يمكنك تفعيل التعبئة التلقائية لعلامات الميتا &#39;description&#39; و &#39;keywords&#39; للمنشورات. إذا لم يتم ملء هذه الحقول عند إضافة منشورات إلى الموقع، فسيقوم السكربت بإنشائها تلقائيًا.",
'opt_sys_iprest'		=>	"قائمة عناوين IP المسموح لها بتسجيل الدخول إلى لوحة تحكم السكربت",
'opt_sys_iprestd'		=>	"يمكنك تقييد تسجيل الدخول إلى لوحة التحكم لعناوين IP محددة فقط. تنبيه: كن حذرًا عند تغيير هذا الإعداد. سيكون الوصول إلى لوحة التحكم متاحًا فقط من عناوين IP المحددة. يمكنك تحديد عدة عناوين، واحد في كل سطر. يمكنك تحديد عنوان IP كامل أو قناع، على سبيل المثال: 192.48.25.71 أو 129.42.*.* لعدم وضع أي قيود على IP، اترك هذا الحقل فارغًا.",
'opt_sys_r6'			=>	"تفعيل، تصفية ضعيفة",
'group_fspam'			=>	"تفعيل الحماية التلقائية من السبام عند كتابة التعليقات",
'hint_fspam'			=>	"يتيح هذا الخيار تفعيل الحماية التلقائية من السبام لهذه المجموعة عند كتابة التعليقات على الموقع. تتم الحماية باستخدام المورد السحابي http://www.stopforumspam.com/. يقوم هذا المورد بتخزين وتوفير معلومات حول عدد هائل من مرسلي السبام من جميع أنحاء العالم، مما يسمح بمنع السبام على الموقع بناءً على هذه المعلومات.",
'opt_sys_html5'			=>	"استخدام مشغل HTML5 كشغل أساسي عند تشغيل الفيديو",
'opt_sys_html5d'		=>	"إذا كان &#39;مفعل&#39;، فعند إدراج فيديو بتنسيق mp4 وعند إدراج فيديو من خدمة Youtube، سيتم استخدام مشغل HTML5 بدلاً من مشغل الفلاش، مما يسمح بمشاهدة الفيديو على موقعك ليس فقط في المتصفح العادي، ولكن أيضًا على الأجهزة المحمولة (iphone، ipad، android).",
'opt_sys_rfc'			=>	"البحث عن المنشورات المتشابهة فقط في نفس فئات الخبر نفسه",
'opt_sys_rfcd'			=>	"إذا كان &#39;مفعل&#39;، فعند البحث عن أخبار مماثلة، سيتم أخذ الفئة التي ينتمي إليها المنشور في الاعتبار. وسيتم عرض الأخبار من نفس الفئة فقط، أو الفئات الفرعية (إذا كان مسموحًا بعرض الأخبار من الفئات الفرعية). إذا كان &#39;معطل&#39;، فسيتم البحث عن المنشورات المتشابهة في جميع الفئات.",
'opt_links'				=>	"الروابط المتقاطعة",
'opt_linksc'			=>	"في هذا القسم، يمكنك إنشاء روابط متقاطعة عبر الموقع بناءً على كلمات رئيسية مختلفة.",
'add_links'				=>	"إضافة رابط جديد",
'links_not_found'		=>	"لم تقم بإنشاء روابط متقاطعة بعد",
'opt_linkshelp'			=>	"في هذا القسم، يمكنك إنشاء روابط متقاطعة عبر الموقع بناءً على كلمات رئيسية مختلفة. عند إنشاء رابط، يمكنك تحديد كلمة رئيسية وعنوان URL على موقعك أو على أي مورد خارجي آخر. عند العثور على هذه الكلمة الرئيسية في موقعك، سيتم استبدال هذه الكلمة برابط قابل للنقر يؤدي إلى عنوان URL المحدد. يتم البحث في الأخبار والتعليقات والقوالب، أي في جميع أنحاء موقعك.<br /><br />يمكنك عند إنشاء كلمة رئيسية استخدام التصريفات، على سبيل المثال يمكنك تحديد الكلمة: <b>Ivanov</b>، ويمكنك تحديد <b>Ivan(ov|ova|ovu)</b>، وعندها سيتم استبدال الكلمات Ivanov، Ivanova، Ivanovu، إلخ.",
'add_links_new'			=>	"إضافة رابط جديد",
'add_links_tag'			=>	"أدخل الكلمة الرئيسية:",
'add_links_url'			=>	"أدخل عنوان URL للرابط:",
'add_links_one'			=>	"مراعاة حالة الأحرف",
'tagscloud_del_2'		=>	"من وحدة الروابط المتقاطعة؟",
'mass_links_err'		=>	"لم تقم باختيار كلمات رئيسية لإجراء العمليات عليها.",
'links_tag'				=>	"الكلمة الرئيسية:",
'links_url'				=>	"عنوان URL للرابط للاستبدال:",
'opt_sys_links'			=>	"تفعيل دعم وحدة &#39;الروابط المتقاطعة&#39;",
'opt_sys_linksd'		=>	"يسمح تعطيل هذه الوحدة بتوفير استعلامات قاعدة البيانات وتقليل وقت إنشاء الصفحة. إذا كنت لا تستخدم الروابط المتقاطعة على الموقع، فقم بتعطيلها.",
'module_disabled'		=>	"تم تعطيل هذه الوحدة في إعدادات السكربت. لتفعيل هذه الوحدة، انتقل إلى إعدادات السكربت في قسم تحسين استعلامات قاعدة البيانات وقم بتفعيل دعم هذه الوحدة.",
'links_err'				=>	"الكلمة الرئيسية تحتوي على رموز غير مسموح بها",
