$template_lang = [
    '{{rtl_prefix}}' => (($lang['direction'] ?? 'ltr') === 'rtl') ? "_rtl" : "",
    '{{direction}}'  => (($lang['direction'] ?? 'ltr') === 'rtl') ? "rtl" : "ltr",
    '{{Add comment}}' => "ارسال نظر",
    '{{Name}}' => "نام شما",
    '{{E-Mail}}' => "ایمیل شما",
