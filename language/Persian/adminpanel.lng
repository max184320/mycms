'plugins_name'			=>	"نام پلاگین:",
'plugins_name_h'		=>	"نام پلاگین الزامی است و نمی&#39;تواند بیش از 100 کاراکتر باشد",
'plugins_descr'			=>	"توضیح کوتاه پلاگین:",
'plugins_ver'			=>	"نسخه پلاگین:",
'plugins_dlever'		=>	"نسخه DLE:",
'plugins_dleverh'		=>	"حداقل نسخه DLE مورد نیاز برای اجرای این پلاگین. اگر نمی&#39;خواهید محدودیتی برای این پلاگین اعمال کنید، این فیلد را خالی بگذارید",
'plugins_icon_h'		=>	"مسیر کامل آیکون پلاگین را از ریشه سایت خود وارد کنید. به عنوان مثال engine/skins/images/my_icon.png",
'plugins_vc_1'			=>	"فقط",
'plugins_vc_2'			=>	"و بالاتر",
'plugins_vc_3'			=>	"و پایین&#39;تر",
'plugins_myinstall'		=>	"هنگام نصب پلاگین:",
'plugins_myupgrade'		=>	"هنگام به‌روزرسانی پلاگین:",
'plugins_myenable'		=>	"هنگام فعال کردن پلاگین:",
'plugins_mydisable'		=>	"هنگام غیرفعال کردن پلاگین:",
'plugins_mydelete'		=>	"هنگام حذف پلاگین:",
'plugins_myinfo'		=>	"هنگام نوشتن کوئری&#39;های MySQL، می&#39;توانید از تگ&#39;های سرویس زیر نیز استفاده کنید:<br><br><b>{prefix}</b> - این تگ با پیشوند جداولی که هنگام نصب اسکریپت مشخص شده و توسط DataLife Engine برای جداول خود استفاده می&#39;شود، جایگزین خواهد شد.<br><b>{userprefix}</b> - این تگ با پیشوند جداول مورد استفاده برای کار با داده&#39;های کاربران، هنگام استفاده از ثبت&#39;نام و ورود یکپارچه در چندین سایت متصل، جایگزین خواهد شد.<br><b>{charset}</b> - این تگ با کدگذاری جداول پایگاه داده که اسکریپت استفاده می&#39;کند، مانند utf8 یا utf8mb4 جایگزین خواهد شد.<br><b>{engine}</b> - این تگ با موتور MySQL که DLE برای پایگاه داده استفاده می&#39;کند، جایگزین خواهد شد. این مقادیر می&#39;توانند InnoDB یا MyISAM باشند.<br><br><b>توجه:</b> هنگام نصب پلاگین، تریگر فعال&#39;سازی پلاگین نیز به طور خودکار فعال می&#39;شود، اما هنگام حذف پلاگین، تریگر غیرفعال&#39;سازی پلاگین اجرا نخواهد شد.",
'plugins_myinfo_1'		=>	"می&#39;توانید کوئری&#39;های MySQL پایگاه داده را که هنگام انجام اقدامات خاص روی پلاگین اجرا می&#39;شوند، مشخص کنید:",
'plugins_nerror'		=>	"وارد کردن نام پلاگین الزامی است",
'plugins_nerror_1'		=>	"پلاگینی با این نام قبلاً در سایت نصب شده است",
'plugins_nerror_2'		=>	"این پلاگین با نسخه نصب شده DLE سازگار نیست. برای کارکرد این پلاگین نسخه DLE <b>{version}</b> {versioncompare} مورد نیاز است. نسخه شما DataLife Engine <b>{dleversion}</b> می&#39;باشد",
'plugins_addfile'		=>	"افزودن فایل",
'plugins_addact'		=>	"افزودن عملیات",
'plugins_filename'		=>	"نام فایل:",
'plugins_file_h'		=>	"نام فایلی را که این عملیات برای آن انجام می&#39;شود مشخص کنید. فقط باید فایل&#39;های php یا lng را ذکر کنید. مسیر فایل باید نسبت به ریشه سایت شما باشد، به عنوان مثال engine/modules/main.php",
'plugins_f_del'			=>	"آیا واقعاً می&#39;خواهید تمام عملیات روی این فایل را حذف کنید؟",
'plugins_a_del'			=>	"آیا واقعاً می&#39;خواهید عملیات انتخاب شده را حذف کنید؟",
'plugins_a_del_1'		=>	"حذف عملیات",
'plugins_aсt_l1'		=>	"جستجو و جایگزینی",
'plugins_aсt_l2'		=>	"جستجو و افزودن در بالا",
'plugins_aсt_l3'		=>	"جستجو و افزودن در پایین",
'plugins_aсt_l4'		=>	"جایگزینی کل فایل",
'plugins_aсt_l5'		=>	"ایجاد فایل جدید",
'plugins_aсt_l6'		=>	"جستجو:",
'plugins_aсt_l7'		=>	"جایگزینی با:",
'plugins_aсt_l8'		=>	"افزودن در بالا:",
'plugins_aсt_l9'		=>	"افزودن در پایین:",
'plugins_aсt_l10'		=>	"محتوای فایل:",
'plugins_upload'		=>	"آپلود پلاگین در سایت",
'plugins_errors'		=>	"خطاهایی در عملکرد این پلاگین ثبت شده است.",
'plugins_errors_1'		=>	"نمایش خطاها",
'plugins_errors_2'		=>	"پاکسازی خطاها",
'plugins_errors_3'		=>	"خطایی یافت نشد",
'plugins_errors_4'		=>	"کد یافت نشد:",
'plugins_errors_5'		=>	"مشکل عمومی",
'stat_secfault_5'		=>	"<b>توصیه امنیتی:</b><br><br>پس از اتمام افزودن و ویرایش پلاگین&#39;ها، برای امنیت بیشتر، توصیه می&#39;کنیم سیستم پلاگین را فقط به حالت خواندن تغییر دهید. برای این کار، فایل <b>engine/classes/plugins.class.php</b> را باز کرده و در آن <b>define(&#39;PLUGINS_READ_ONLY&#39;, false);</b> را پیدا کرده و با <b>define(&#39;PLUGINS_READ_ONLY&#39;, true);</b> جایگزین کنید.<br><br>این کار پلاگین&#39;های شما را فقط در حالت اجرا و خواندن قرار می&#39;دهد. آن&#39;ها همچنان کار خواهند کرد، اما نمی&#39;توان آن&#39;ها را تغییر داد یا پلاگین جدیدی اضافه کرد. به این ترتیب شما از سایت خود در برابر تغییرات محافظت می&#39;کنید، حتی اگر افراد غیرمجاز کنترل پنل مدیریت اسکریپت را به دست بگیرند.",
'plugins_errors_6'		=>	"سیستم پلاگین در حالت فقط خواندنی کار می&#39;کند. مدیر سایت انجام هرگونه اقدام روی پلاگین&#39;ها را ممنوع کرده است. برای باز کردن قفل اقدامات روی پلاگین&#39;ها، باید فایل <b>engine/classes/plugins.class.php</b> را باز کرده و در آن <b>define(&#39;PLUGINS_READ_ONLY&#39;, true);</b> را پیدا کرده و با <b>define(&#39;PLUGINS_READ_ONLY&#39;, false);</b> جایگزین کنید.",
'plugins_errors_7'		=>	"فایل <b>{file}</b> در لیست فایل&#39;های محافظت شده قرار دارد. این فایل نمی&#39;تواند توسط سیستم پلاگین تغییر یابد.",
'plugins_errors_8'		=>	"برای آپلود پلاگین&#39;ها فقط می&#39;توان از فایل&#39;های XML و ZIP استفاده کرد.",
'plugins_errors_9'		=>	"پلاگینی در آرشیو شما یافت نشد. فایل پلاگین باید در ریشه آرشیو باشد و دارای پسوند xml باشد.",
'plugins_errors_10'		=>	"در آرشیو شما فایل&#39;های اصلی DataLife Engine که بخشی از توزیع هستند، یافت شد. آرشیو فقط می&#39;تواند شامل فایل&#39;های اضافی مورد نیاز برای کارکرد پلاگین باشد. تغییرات در فایل&#39;های استاندارد باید در فایل XML پلاگین شما شرح داده شود.",
'related_not_found'		=>	"مقاله مشابهی در سایت یافت نشد.",
'no_referer'			=>	"هدر HTTP_REFERER نامعتبر یا تعریف نشده است. این هدر برای انجام این عمل الزامی است. اگر نام پنل مدیریت را در تنظیمات تغییر داده&#39;اید، مطمئن شوید که در پنل و دقیقاً در آدرس تغییر یافته هستید. همچنین ممکن است از یک صفحه غیرمجاز به این صفحه آمده باشید یا پشت یک سرور پروکسی باشید که هدر HTTP_REFERER را حذف کرده است. در صورت استفاده از سرور پروکسی، آن را برای ارسال هدر صحیح HTTP_REFERER تنظیم کنید یا آن را غیرفعال کنید.",
'only_unread_pm'		=>	"فقط پیام&#39;های شخصی خوانده شده",
