'mail_twofactor_info'	=>	"هنگام نوشتن قالب برای این پیام می‌توانید از تگ‌های زیر استفاده کنید:<br /><b>{%username%}</b> - نام کاربری<br /><b>{%pin%}</b> - کد پین یک‌بار مصرف برای احراز هویت<br /><b>{%ip%}</b> - آدرس IP فرستنده",
