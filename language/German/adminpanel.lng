'addnews_xf_alert_2'    =>  "Das Feld <b>{field}</b> muss mindestens <b>{count}</b> Zeichen enthalten",
'addnews_xf_alert_3'    =>  "Das Feld <b>{field}</b> darf höchstens <b>{count}</b> Zeichen enthalten",
'group_acn'             =>  "Senden von Beschwerden über Beiträge erlauben",
'group_acnd'            =>  "Wenn diese Einstellung aktiviert ist, können Benutzer auf der Website Beschwerden über veröffentlichte Beiträge einreichen.",
'group_acc'             =>  "Senden von Beschwerden über Kommentare erlauben",
