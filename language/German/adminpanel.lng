// 17.3
'com_gast'              =>  "Gast:",
'opt_sys_wwws'          =>  "Weiterleitung von WWW-Domain aktivieren",
'opt_sys_wwwsd'         =>  "Wenn diese Einstellung aktiviert ist, werden Benutzer, die Ihre Website über die WWW-Domain aufrufen, automatisch auf die Domain ohne WWW weitergeleitet. Wenn ein Benutzer beispielsweise www.site.ru aufruft, wird er automatisch auf site.ru weitergeleitet.",
'filter_search_11'      =>  "Vollständiger Name",
'filter_search_12'      =>  "Wohnort",
'filter_search_13'      =>  "Über mich",
'filter_search_14'      =>  "Signatur",
'search_nousers'        =>  "Keine Benutzer nach den von Ihnen gewählten Kriterien gefunden",
'opt_sys_mpml'          =>  "Anzahl der persönlichen Nachrichten pro Seite",
'opt_sys_mpmld'         =>  "Geben Sie die Anzahl der persönlichen Nachrichten an, die in der Liste der empfangenen Nachrichten auf der Website angezeigt werden sollen. Wenn es mehr Nachrichten gibt, werden sie auf mehrere Seiten aufgeteilt.",
'rsschannel_del'        =>  "Möchten Sie diesen RSS-Kanal wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden.",
'usergroup_del'         =>  "Möchten Sie diese Benutzergruppe wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden.",
'banners_c_opt'         =>  "Anzeige des Blocks zwischen Kommentaren",
'banners_c'             =>  "Position zwischen den Kommentaren / Nein - wird nicht angezeigt",
'opt_sys_coua'          =>  "Liste der Länder, für die der Besuch und das Betrachten der Website erlaubt ist",
'opt_sys_couad'         =>  "Sie können eine kommagetrennte Liste von Ländern festlegen, für die das Betrachten der Website erlaubt ist. Wenn Sie keine Einschränkungen festlegen möchten, lassen Sie dieses Feld leer. Wenn die Liste festgelegt ist, wird der Zugriff erlaubt, wenn sich der Besucher in einem der angegebenen Länder befindet; für alle anderen Länder wird der Zugriff verweigert.",
'opt_sys_coua1'         =>  "Liste der Länder, für die der Besuch und das Betrachten der Website verboten ist",
'opt_sys_couad1'        =>  "Sie können eine kommagetrennte Liste von Ländern festlegen, für die das Betrachten der Website verboten ist. Wenn Sie keine Einschränkungen festlegen möchten, lassen Sie dieses Feld leer. Wenn die Liste festgelegt ist, wird der Zugriff verweigert, wenn sich der Besucher in einem der angegebenen Länder befindet; für alle anderen Länder wird der Zugriff erlaubt.",
'opt_sys_coua2'         =>  "Liste der Länder, für die der Zugriff auf das Administrationspanel erlaubt ist",
'opt_sys_couad2'        =>  "Sie können eine kommagetrennte Liste von Ländern festlegen, für die der Login in das DataLife Engine Administrationspanel erlaubt ist. Wenn Sie keine Einschränkungen festlegen möchten, lassen Sie dieses Feld leer. Wenn die Liste festgelegt ist, wird die Autorisierung im Administrationspanel erlaubt, wenn sich der Besucher in einem der angegebenen Länder befindet; für alle anderen Länder wird sie verboten.",
'opt_sys_coua3'         =>  "Liste der Länder, für die der Zugriff auf das Administrationspanel verboten ist",
'opt_sys_couad3'        =>  "Sie können eine kommagetrennte Liste von Ländern festlegen, für die der Login in das DataLife Engine Administrationspanel verboten ist. Wenn Sie keine Einschränkungen festlegen möchten, lassen Sie dieses Feld leer. Wenn die Liste festgelegt ist, wird die Autorisierung im Administrationspanel verboten, wenn sich der Besucher in einem der angegebenen Länder befindet; für alle anderen Länder wird sie erlaubt.",
'opt_sys_coua5'         =>  "Beschreibung des Grundes für die länderspezifische Zugriffssperre",
'opt_sys_couad5'        =>  "Geben Sie die Informationsnachricht an, die der Besucher sieht, wenn Sie den Zugriff auf die Website nach Ländern eingeschränkt haben und er sich in einem für den Zugriff gesperrten Land befindet. Die Verwendung von HTML-Tags ist zulässig.",
'opt_sys_couad4'        =>  "Die Liste wird im ISO-3166-1 Alpha-2 Format angegeben. Sie können die Werte durch Kommas trennen, z. B. RU, BY, KZ. Eine Liste der Ländercodes finden Sie auf der Seite <a href=\"https://en.wikipedia.org/wiki/List_of_ISO_3166_country_codes\" target=\"_blank\">https://en.wikipedia.org/wiki/List_of_ISO_3166_country_codes</a>",
'country_declined'       => "Sie befinden sich in einem Land, aus dem der Zugriff auf das DataLife Engine Administrationspanel eingeschränkt ist.",
// 17.3

// 17.2
'opt_sys_cpml'          =>  "Anzahl der Kommentare pro Seite bei der Anzeige der Liste aller neuesten Kommentare",
'opt_sys_cpmld'         =>  "Geben Sie an, wie viele Kommentare pro Seite bei der Anzeige der Liste aller neuesten Kommentare ausgegeben werden sollen.",
'opt_sys_max_new'       =>  "Anzahl der Stunden, in denen ein Beitrag als neu gilt",
'opt_sys_max_newd'      =>  "Geben Sie die maximale Anzahl an Stunden ein, in denen ein Beitrag nach dem Hinzufügen auf der Website als neu gilt. Diese Einstellung wird für die Tags [new] Text [/new] in Templates verwendet, um neue Nachrichten zu markieren. Die Zeit wird in Stunden ab dem Zeitpunkt des Hinzufügens angegeben. Zum Beispiel bedeutet 24, dass der Beitrag für einen Tag als neu gilt.",
'opt_sys_max_upd'       =>  "Anzahl der Stunden, in denen ein Beitrag als aktualisiert gilt",
'opt_sys_max_updd'      =>  "Geben Sie die maximale Anzahl an Stunden ein, in denen ein Beitrag nach der Bearbeitung als aktualisiert gilt. Diese Einstellung wird für die Tags [updated] Text [/updated] in Templates verwendet, um aktualisierte Nachrichten zu markieren. Die Zeit wird in Stunden ab dem Zeitpunkt der Bearbeitung angegeben. Zum Beispiel bedeutet 24, dass der Beitrag für einen Tag als aktualisiert gilt.",
'v_closed'              =>  "Umfrage für Abstimmungen schließen",
'hint_vclosed'          =>  "Wenn die Umfrage geschlossen wird, wird sie weiterhin im Beitrag angezeigt, aber die Benutzer können keine Stimmen mehr abgeben und sehen nur noch die Umfrageergebnisse.",
'v_closed_date'         =>  "Diese Umfrage wurde am {date} geschlossen",
'xfield_xi36'           =>  "Sie können die Mindestanzahl an Zeichen festlegen, die in diesem Feld beim Verfassen eines Beitrags erforderlich sind. Wenn Sie diese Einschränkung nicht festlegen möchten, lassen Sie das Feld leer.",
'xfield_xi37'           =>  "Sie können die maximale Anzahl an Zeichen festlegen, die in diesem Feld beim Verfassen eines Beitrags zulässig sind. Wenn Sie diese Einschränkung nicht festlegen möchten, lassen Sie das Feld leer.",
'xfield_f36'            =>  "Mindestanzahl der Zeichen im Feld",
