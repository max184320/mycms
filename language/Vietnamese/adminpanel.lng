'banner_mviews'			=>	"Số lượt xem tối đa",
'banner_mcounts'		=>	"Số lượt nhấp tối đa",
'hint_bviews'			=>	"Bạn có thể chỉ định số lượt xem tối đa, sau khi đạt tới mức đó banner sẽ không còn hiển thị nữa. Nếu bạn không muốn áp đặt giới hạn, hãy để trống trường này.",
'hint_bcounts'			=>	"Bạn có thể chỉ định số lượt nhấp tối đa, sau khi đạt tới mức đó banner sẽ không còn hiển thị nữa. Nếu bạn không muốn áp đặt giới hạn, hãy để trống trường này.",
'banner_clear_1'		=>	"Xóa lượt xem",
'banner_clear_2'		=>	"Xóa lượt nhấp",
'page_header_1'			=>	"Tiêu đề trang",
'page_header_2'			=>	"Mô tả trang",
'page_header_3'			=>	"Văn bản có thể hiển thị trên các trang của trang web, cho phép HTML",
'find_rpolls'			=>	"Thăm dò và bình chọn",
'news_mdel'				=>	"Xóa các mục chờ kiểm duyệt",
'news_mdelconfirm'		=>	"Bạn có chắc chắn muốn xóa tất cả các tin tức đang chờ kiểm duyệt của người dùng này không?",
'comm_mcdelconfirm'		=>	"Bạn có chắc chắn muốn xóa tất cả các bình luận đang chờ kiểm duyệt của người dùng này không?",
'links_area_8'			=>	"Chỉ trong các trang tĩnh",
'links_area_9'			=>	"Trong các trang tĩnh, tin tức, bình luận",
'opt_sys_dfc'			=>	"Bật chặn việc nhúng trang web vào frame",
'opt_sys_dfcd'			=>	"Khi bật cài đặt này, script sẽ tự động chặn việc hiển thị trang web của bạn nếu nó được nhúng vào iframe trên một trang web khác. Nhờ đó bạn có thể ngăn chặn các cuộc tấn công như clickjacking.",
'xfield_xhtmljs'		=>	"Mã HTML hoặc JS thuần",
'xfield_xhtmljs_1'		=>	"Khi sử dụng loại trường bổ sung này, bạn có thể thêm vào bài viết bất kỳ mã HTML hoặc JS thuần nào. Mã này sẽ được hiển thị trên trang web mà không qua lọc hay thay đổi. Hãy cẩn thận, trường này cho phép thêm bất kỳ mã nào, vì vậy hãy chỉ định những nhóm người dùng nào được phép thêm trường này. Khuyến nghị chỉ cấp các quyền như vậy cho nhóm &#039;Quản trị viên&#039;.",
'xfield_xhtmljs_2'		=>	"Xem trước trường này không khả dụng vì lý do bảo mật",
'xfield_separator'		=>	"Dấu phân cách cho danh sách liên kết chéo",
'xfield_separator_1'	=>	"Nếu các giá trị của trường được dùng làm liên kết chéo, bạn có thể chỉ định dấu phân cách sẽ được sử dụng giữa các từ trong danh sách liên kết khi hiển thị bài viết. Cũng cho phép sử dụng mã HTML. Nếu để trống cài đặt này, dấu phẩy sẽ được sử dụng",
'cat_d_main'			=>  "Cấm xuất bản trên trang chủ",
