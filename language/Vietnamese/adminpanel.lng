'plugins_list'			=>	"Danh sách plugin",
'plugins_name'			=>	"Tên plugin:",
'plugins_name_h'		=>	"Tên plugin là trường bắt buộc và không được chứa quá 100 ký tự",
'plugins_descr'			=>	"Mô tả ngắn của plugin:",
'plugins_ver'			=>	"Phiên bản plugin:",
'plugins_dlever'		=>	"Phiên bản DLE:",
'plugins_dleverh'		=>	"Phiên bản DLE tối thiểu cần thiết để plugin này hoạt động. Nếu bạn không muốn áp đặt hạn chế cho plugin này, hãy để trống trường này",
'plugins_icon_h'		=>	"Chỉ định đường dẫn đầy đủ tới biểu tượng của plugin bắt đầu từ thư mục gốc của trang web của bạn. Ví dụ engine/skins/images/my_icon.png",
'plugins_vc_1'			=>	"chỉ",
'plugins_vc_2'			=>	"và cao hơn",
'plugins_vc_3'			=>	"và thấp hơn",
'plugins_myinstall'		=>	"Khi cài đặt plugin:",
'plugins_myupgrade'		=>	"Khi cập nhật plugin:",
'plugins_myenable'		=>	"Khi bật plugin:",
'plugins_mydisable'		=>	"Khi tắt plugin:",
'plugins_mydelete'		=>	"Khi xóa plugin:",
'plugins_myinfo'		=>	"Khi viết các truy vấn MySQL, bạn cũng có thể sử dụng các thẻ dịch vụ sau:<br><br><b>{prefix}</b> - thẻ này sẽ được thay bằng tiền tố bảng đã được chỉ định khi cài đặt script và được DataLife Engine sử dụng cho các bảng riêng của mình.<br><b>{userprefix}</b> - thẻ này sẽ được thay bằng tiền tố bảng dùng để làm việc với dữ liệu người dùng khi sử dụng đăng ký và ủy quyền thống nhất trên nhiều trang web được hợp nhất.<br><b>{charset}</b> - thẻ này sẽ được thay bằng mã hóa của các bảng cơ sở dữ liệu mà script sử dụng, ví dụ utf8 hoặc utf8mb4.<br><b>{engine}</b> - thẻ này sẽ được thay bằng engine MySQL mà DLE sử dụng cho cơ sở dữ liệu. Đây có thể là các giá trị InnoDB hoặc MyISAM.<br><br><b>Lưu ý:</b> khi cài đặt plugin, trigger bật plugin cũng sẽ tự động được kích hoạt, còn khi xóa plugin thì trigger tắt plugin sẽ không được kích hoạt.",
'plugins_myinfo_1'		=>	"Bạn có thể chỉ định các truy vấn MySQL tới cơ sở dữ liệu sẽ được thực hiện khi tiến hành những hành động nhất định với plugin:",
'plugins_nerror'		=>	"Tên plugin là trường bắt buộc",
'plugins_nerror_1'		=>	"Plugin với tên này đã được cài đặt trên trang web",
'plugins_nerror_2'		=>	"Plugin này không tương thích với phiên bản DLE đã cài đặt. Để plugin này hoạt động cần phiên bản DLE <b>{version}</b> {versioncompare}. Phiên bản DataLife Engine của bạn là <b>{dleversion}</b>",
'plugins_addfile'		=>	"Thêm tệp",
'plugins_addact'		=>	"Thêm hành động",
'plugins_filename'		=>	"Tên tệp:",
'plugins_file_h'		=>	"Chỉ định tên tệp mà hành động này sẽ áp dụng. Chỉ nên chỉ định các tệp php hoặc lng. Đường dẫn tới tệp phải được chỉ định tương đối so với thư mục gốc của trang web, ví dụ engine/modules/main.php",
'plugins_f_del'			=>	"Bạn có thực sự muốn xóa tất cả các hành động đối với tệp này không?",
'plugins_a_del'			=>	"Bạn có thực sự muốn xóa hành động đã chọn không?",
'plugins_a_del_1'		=>	"Xóa hành động",
