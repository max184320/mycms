'plugins_aсt_l3'		=>	"Tìm và thêm ở dưới",
'plugins_aсt_l4'		=>	"Thay thế toàn bộ tệp",
'plugins_aсt_l5'		=>	"Tạo tệp mới",
'plugins_aсt_l6'		=>	"Tìm:",
