// 12.1
'admin_logs_all'		=>	"Danh sách tất cả các hành động trong bảng quản trị của script",
'admin_logs_auth'		=>	"Danh sách các lần thử xác thực không thành công của những người dùng có quyền truy cập bảng quản trị",
'opt_sys_own404'		=>	"Sử dụng trang riêng cho lỗi 404",
'opt_sys_own404d'		=>	"Khi bật tùy chọn này, trong trường hợp script cần hiển thị thông báo rằng nội dung cần thiết không tồn tại, nó sẽ không sử dụng thông báo hệ thống tích hợp sẵn mà sẽ dùng một trang riêng biệt mà bạn cần đặt trong thư mục gốc của trang web với tên 404.html, tức là trang của bạn phải nằm chẳng hạn tại địa chỉ http://yoursite.com/404.html",
'settings_panel_9'		=>	"Màu sắc",
'opt_sys_ownip'			=>	"HTTP header để nhận địa chỉ IP của người dùng",
'opt_sys_ownipd'		=>	"Theo mặc định, script nhận IP của khách truy cập từ header toàn cục REMOTE_ADDR, đây là một phương thức đáng tin cậy và an toàn. Hãy để trống cài đặt này để script hoạt động theo mặc định. Tuy nhiên, khi sử dụng các dịch vụ proxy khác nhau, ví dụ khi bật bảo vệ chống tấn công DDOS, có thể cần lấy địa chỉ IP từ các header khác. Trong cài đặt này, bạn có thể chỉ định header cần dùng để lấy IP, ví dụ HTTP_X_FORWARDED_FOR. Địa chỉ IP của bạn nhận được theo cài đặt này là: ",
'stat_sec_ip'			=>	"<b>Cảnh báo lỗi bảo mật:</b><br>Trong cài đặt của script đã chỉ định một HTTP header không hợp lệ để lấy địa chỉ IP của người dùng. Với cài đặt này không thể lấy được địa chỉ IP của người dùng. Hãy thay đổi giá trị sang giá trị chính xác.",
'mail_news' 	  		=>  "Tin mới đang chờ kiểm duyệt",
