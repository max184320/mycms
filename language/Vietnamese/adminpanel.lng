'plugins_aсt_l9'		=>	"Thêm ở dưới:",
'plugins_aсt_l10'		=>	"Nội dung tệp:",
'plugins_upload'		=>	"Tải plugin lên trang web",
'plugins_errors'		=>	"Đã ghi nhận lỗi trong hoạt động của plugin này.",
'plugins_errors_1'		=>	"Hiển thị lỗi",
'plugins_errors_2'		=>	"Xóa lỗi",
'plugins_errors_3'		=>	"Không phát hiện lỗi",
'plugins_errors_4'		=>	"Không tìm thấy mã:",
'plugins_errors_5'		=>	"Sự cố chung",
'stat_secfault_5'		=>	"<b>Khuyến nghị bảo mật:</b><br><br>Sau khi bạn hoàn tất việc thêm và chỉnh sửa plugin, vì lý do bảo mật, chúng tôi khuyến nghị chuyển hệ thống plugin sang chế độ chỉ đọc. Để làm điều này, hãy mở tệp <b>engine/classes/plugins.class.php</b>, tìm trong đó <b>define('PLUGINS_READ_ONLY', false);</b> và thay bằng <b>define('PLUGINS_READ_ONLY', true);</b><br><br>Điều này sẽ chuyển plugin của bạn sang chế độ chỉ hoạt động và chỉ đọc. Chúng vẫn sẽ tiếp tục hoạt động, nhưng sẽ không thể chỉnh sửa và cũng không thể thêm plugin mới. Bằng cách đó, bạn sẽ bảo vệ trang web của mình khỏi các sửa đổi ngay cả khi người ngoài có được quyền kiểm soát bảng quản trị của script.",
'plugins_errors_6'		=>	"Hệ thống plugin đang hoạt động ở chế độ chỉ đọc. Quản trị viên của trang web đã cấm thực hiện bất kỳ hành động nào với plugin. Để mở khóa các thao tác với plugin, bạn cần mở tệp <b>engine/classes/plugins.class.php</b>, tìm trong đó <b>define('PLUGINS_READ_ONLY', true);</b> và thay bằng <b>define('PLUGINS_READ_ONLY', false);</b>",
'plugins_errors_7'		=>	"Tệp <b>{file}</b> nằm trong danh sách các tệp được bảo vệ. Nó không thể bị sửa đổi bằng hệ thống plugin.",
'plugins_errors_8'		=>	"Chỉ có thể sử dụng tệp XML và ZIP để tải plugin lên.",
'plugins_errors_9'		=>	"Không tìm thấy plugin trong tệp lưu trữ của bạn. Tệp plugin phải nằm ở thư mục gốc của tệp lưu trữ và có phần mở rộng xml",
'plugins_errors_10'		=>	"Trong tệp lưu trữ của bạn đã phát hiện sự hiện diện của các tệp gốc của Datalife Engine nằm trong bộ phân phối. Tệp lưu trữ chỉ có thể chứa các tệp bổ sung cần thiết để plugin hoạt động. Những thay đổi trong các tệp tiêu chuẩn phải được mô tả trong tệp XML của plugin của bạn",
'related_not_found'		=>	"Không tìm thấy bài viết tương tự trên trang web.",
'no_referer'			=>	"HTTP header HTTP_REFERER không hợp lệ hoặc không được xác định. Để thực hiện hành động này, header này là bắt buộc. Nếu bạn đã đổi tên bảng quản trị trong cài đặt, hãy đảm bảo rằng bạn đang ở trong bảng quản trị và đúng theo địa chỉ đã đổi tên. Cũng có thể bạn đã truy cập trang này từ một trang không được phép hoặc bạn đang đứng sau một máy chủ proxy đã xóa header HTTP_REFERER. Trong trường hợp sử dụng máy chủ proxy, hãy cấu hình nó để truyền header HTTP_REFERER chính xác hoặc tắt nó đi.",
'only_unread_pm'		=>	"Chỉ tin nhắn cá nhân đã đọc",
'disabled_comments'		=>	"Cấm bình luận",
'disabled_news'			=>	"Cấm bài viết",
'have_poll'				=>	"Đã đặt cuộc thăm dò cho bài viết",
'have_pass'				=>	"Đã đặt mật khẩu cho bài viết",
'add_s_5' 	    		=>  "Xem trên trang web",
'opt_sys_plugins'		=>	"Bật hỗ trợ mô-đun &#039;Plugin&#039;",
'opt_sys_pluginsd'		=>	"Việc tắt mô-đun này giúp tiết kiệm các truy vấn tới cơ sở dữ liệu và giảm thời gian tạo trang. Nếu bạn không sử dụng các plugin bổ sung cho script, hãy tắt chúng.",
