'add_links_one'			=>	"Phân biệt chữ hoa chữ thường",
'tagscloud_del_2'		=>	"khỏi mô-đun liên kết chéo?",
'mass_links_err'		=>	"Bạn chưa chọn từ khóa nào để thực hiện thao tác với chúng.",
