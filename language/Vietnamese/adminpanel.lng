// 11.3
'delete_selected'		=>	"Bạn có thực sự muốn xóa các tệp đã chọn không? Hành động này sẽ không thể hoàn tác.",
'find_rbanners'			=>	"Tài liệu quảng cáo",
'rebuild_s_1'			=>  "Bắt đầu tái tạo từ:",
'rebuild_s_2'			=>  "bài viết (nhập 0 nếu muốn bắt đầu tái tạo từ đầu)",
'rebuild_s_3'			=>  "bình luận (nhập 0 nếu muốn bắt đầu tái tạo từ đầu)",
'opt_crebuild'			=>  "Tái tạo bình luận",
'rebuild_cinfo'			=>  "Tiện ích này thực hiện tái tạo tất cả bình luận trên trang web. Hành động này cần được thực hiện nếu bạn đã thay đổi các cài đặt của script mà để có hiệu lực cần phải lưu lại bình luận để những thay đổi đó cũng hiển thị trong các bình luận cũ. Hoặc khi bạn có thay đổi riêng trong trình phân tích của script, ví dụ như thay đổi ở các thẻ BB. Hoặc để các tính năng mới của script được thêm trong các phiên bản mới bắt đầu có hiệu lực.<br /><br /><b>Cảnh báo:</b> Trước khi bắt đầu, đừng quên tạo bản sao lưu cơ sở dữ liệu, vì hành động này trong trường hợp hoạt động không chính xác hoặc không đúng như mong đợi sẽ không thể hoàn tác.",
'stat_m_fail_1'			=>	"<b>Cảnh báo:</b><br>Bạn đã bật bộ nhớ đệm Memcache trong cài đặt máy chủ, nhưng trên máy chủ của bạn chưa cài đặt phần mở rộng PHP Memcached. Bạn cần liên hệ với bộ phận hỗ trợ của nhà cung cấp hosting để cài đặt phần mở rộng này cho PHP.",
'opt_sys_mcac'			=>  "Số trang của trang web cần được cache khi hiển thị bài viết ngắn",
'opt_sys_mcacd'			=>  "Chỉ định số lượng trang trong phần điều hướng của trang web mà đối với chúng cần thực hiện cache việc hiển thị tin tức ngắn. Việc tạo và cập nhật bộ nhớ đệm cũng là thao tác tiêu tốn tài nguyên, vì vậy việc tạo cache cho các trang ít truy cập là không hiệu quả. Ví dụ, nếu bạn chỉ định 10 thì 10 trang đầu tiên trong điều hướng của trang web sẽ được cache, còn các trang tiếp theo thì không. Việc tăng số lượng trang dẫn đến tiêu tốn thêm dung lượng đĩa.",
'opt_sys_https'			=>  "Luôn sử dụng giao thức HTTPS",
'opt_sys_httpsd'		=>  "Nếu bật cài đặt này, những người dùng truy cập trang web của bạn qua giao thức HTTP thông thường sẽ tự động được chuyển hướng sang sử dụng kết nối SSL bảo mật.",
'group_fuf'				=>  "Cho phép gửi tệp qua biểu mẫu phản hồi",
'group_fufd'			=>  "Khi bật cài đặt này, người dùng sẽ có thể gửi kèm các tệp đính kèm cùng với thư trong biểu mẫu phản hồi.",
'group_fuf2'			=>  "Số lượng tệp tối đa có thể gửi qua biểu mẫu phản hồi",
'group_fufd2'			=>  "Trong trường hợp cho phép người dùng gửi tệp qua biểu mẫu phản hồi, bạn có thể chỉ định số lượng tệp tối đa mà người dùng có thể gửi.",
'group_fuf3'			=>  "Kích thước tối đa của tất cả các tệp được phép gửi qua biểu mẫu phản hồi (tính bằng kilobyte)",
'group_fufd3'			=>  "Chỉ định tổng kích thước tối đa tính bằng kilobyte của tất cả các tệp được phép gửi trong thư qua biểu mẫu phản hồi.",
'group_fuf4'			=>  "Phần mở rộng tệp được phép gửi qua biểu mẫu phản hồi",
'group_fufd4'			=>  "Chỉ định bằng dấu phẩy các phần mở rộng của tệp được phép gửi trong thư qua biểu mẫu phản hồi",
'sess_error'			=>	"Phiên người dùng của bạn đã hết hạn, hãy tải lại trang trong trình duyệt và nếu cần thì đăng nhập lại vào trang web.",
'opt_redirects'			=>	"Chuyển hướng",
