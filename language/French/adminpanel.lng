// 16.1

// 16.0
'error_max_queue'       =>   "Le nombre maximum de fichiers autorisés pour le téléchargement a été dépassé",
'files_public'          =>   "Publique",
'files_private'         =>   "Privé",
'opt_sys_fa'            =>   "Mode d&#39;accès aux fichiers de stockage",
'opt_sys_fad'           =>   "Dans ce paramètre, vous pouvez spécifier quels droits d&#39;accès seront attribués aux fichiers après leur téléchargement sur le serveur. Le mode privé signifie que l&#39;accès complet ne sera disponible qu&#39;au nom du propriétaire du fichier sur le serveur, le mode public signifie que tous les utilisateurs du serveur bénéficieront d&#39;un accès complet. Pour faciliter la gestion des fichiers, par exemple via FTP et sur un serveur local, il est recommandé d&#39;installer le mode public, cependant, certains services externes peuvent nécessiter l&#39;activation du mode privé. Par exemple, le stockage Cloudflare S3.",
'opt_sys_maxfilesh'     =>   "Taille du paquet en mégaoctets lors du téléchargement de fichiers",
'opt_sys_maxfileshd'    =>   "Lors du téléchargement de fichiers volumineux, ces fichiers sont divisés en packages distincts afin de ne pas dépasser les limites fixées sur le serveur. Vous pouvez spécifier la taille du paquet de données qui sera envoyé au serveur à la fois; il est indiqué en mégaoctets. Moins il y a de paquets envoyés, plus le téléchargement vers le serveur sera rapide. Ce paramètre est destiné aux utilisateurs expérimentés, ne le modifiez pas si vous ne savez pas à quoi il sert. La taille par défaut des paquets est de 1,5, ce qui signifie que des paquets d&#39;un mégaoctet et demi chacun seront envoyés.",
'opt_sys_imfs_7'        =>   "Serveur WebDAV",
'opt_sys_imfwe'         =>   "Adresse du serveur WebDAV",
'opt_sys_imfwed'        =>   "Spécifiez l&#39;URL HTTP pour vous connecter au stockage WebDAV externe. Par exemple https://website.com",
'opt_sys_imfweu'        =>   "Nom d&#39;utilisateur pour se connecter à WebDAV",
'opt_sys_imfweud'       =>   "Spécifiez le nom d&#39;utilisateur pour vous connecter au serveur WebDAV",
'opt_sys_imfwep'        =>   "Mot de passe de connexion à WebDAV",
'opt_sys_imfwepd'       =>   "Spécifiez le mot de passe pour vous connecter au serveur WebDAV",
'hours_diffs'           =>   "cha|s|sa|sov",
'minutes_diffs'         =>   "minute|tu|t",
'time_diffs'            =>   "retour",
