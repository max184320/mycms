'admin_check_30'	=>	"בהגדרות האתר שלך מורשה שימוש במספר תבניות בו-זמנית והמשתמשים יכולים לשנות אותן כראות עיניהם. אפשרות זו דורשת מהסקריפט לבצע מטמון נתונים נוסף בשרת. כדי להשבית הגדרה זו, עבור אל <b>הגדרות סקריפט &raquo; הגדרות למשתמשים</b>, והשבת אפשרות זו.",
'admin_check_31'	=>	"באתר שלך מופעלת שליחת הודעות דוא&#34;ל למשתמשים בעת קבלת הודעות אישיות. השבתת אפשרות זו מאפשרת להפחית מעט את העומס על השרת. כדי להשבית הגדרה זו, עבור אל <b>הגדרות סקריפט &raquo; הגדרות למשתמשים</b>, והשבת אפשרות זו.",
'admin_check_32'	=>	"עבור הקבוצה <b>&#39;{name}&#39;</b> חסמת צפייה בפרסומים מקטגוריות מסוימות. בעת הפעלת חסימה זו, הסקריפט נאלץ לבצע בחירות מידע מורכבות ממסד הנתונים. כדי להשבית הגדרה זו, עבור אל <b>הגדרות קבוצות משתמשים</b>, והשבת אפשרות זו.",
'admin_check_33'	=>	"אפשרת למשתמשים להירשם לעדכוני תגובות בחדשות. בעת הפעלת אפשרות זו, משתמשים שנרשמו לתגובות יקבלו הודעות מתאימות בדוא&#34;ל בעת הופעת תגובות חדשות. עם זאת, עם מספר רב של משתמשים ומספר רב של רשומים, שליחת המכתבים עלולה לקחת זמן רב למדי. כדי להשבית הגדרה זו, עבור אל <b>הגדרות סקריפט &raquo; הגדרת תגובות</b>, והשבת אפשרות זו.",
// 9.4

));
