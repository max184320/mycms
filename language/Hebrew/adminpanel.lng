'plugins_pinfo_1'		=>	"ניתן לציין קוד PHP שיבוצע בעת ביצוע פעולות מסוימות עם התוסף בלוח הבקרה:",
'plugins_aсt_l12'		=>	"החלף מהמופע:",
'plugins_rep_hint'		=>	"ציינו מאיזה מופע יש לבצע את ההחלפה, אם הקוד מופיע מספר פעמים בקובץ. לדוגמה, אם שורה מסוימת מופיעה מספר פעמים ואתם צריכים להחליף החל מהמופע השני, ציינו 2. אם יש צורך להחליף את כל המופעים, השאירו שדה זה ריק.",
'plugins_needp'			=>	"נדרשת נוכחות של תוסף:",
'plugins_needp_h'		=>	"ציינו את שם התוסף הנוסף הנדרש לפעולת תוסף זה. במקרה שהתוסף אינו דורש תוספים אחרים, השאירו שדה זה ריק. ניתן גם לציין מספר תוספים מופרדים בפסיק.",
'plugins_nerror_3'		=>	"תוסף זה דורש נוכחות חובה של תוסף נוסף מותקן: «{plugin}»",
'filter_search_7'		=>	"שם",
'filter_search_8'		=>	"תיאור",
'filter_search_9'		=>	"טקסט הדף",
'drop_search'			=>	"איפוס חישוף",
'change_domain'			=>	"העברת האתר לדומיין אחר",
'old_domain'			=>	"הזינו את שם הדומיין הישן:",
'new_domain'			=>	"הזינו את שם הדומיין החדש:",
'change_domain_h'		=>	"שימו לב, העברת דומיין תוביל לשינוי מידע על הדומיין בפרסומים, הגדרות, ואווטארים של משתמשים. לפני שתתחילו, צרו גיבוי של מסד הנתונים וההגדרות. יש להזין את שם הדומיין החדש במלואו, כולל הפרוטוקול ולוכסן בסוף.",
