'opt_sys_couad'         =>  "ניתן לציין רשימת מדינות המופרדות בפסיקים המורשות לצפות באתר. אם אינך רוצה להגדיר מגבלות, השאר שדה זה ריק. אם הרשימה מוגדרת, ואם המבקר נמצא באחת המדינות שצוינו, הצפייה תתאפשר; עבור כל מדינה אחרת היא תיחסם.",
'opt_sys_coua1'         =>  "רשימת מדינות האסורות בביקור וצפייה באתר",
'opt_sys_couad1'        =>  "ניתן לציין רשימת מדינות המופרדות בפסיקים האסורות לצפייה באתר. אם אינך רוצה להגדיר מגבלות, השאר שדה זה ריק. אם הרשימה מוגדרת, ואם המבקר נמצא באחת המדינות שצוינו, הצפייה תיחסם; עבור כל מדינה אחרת היא תתאפשר.",
'opt_sys_coua2'         =>  "רשימת מדינות המורשות להיכנס ללוח הבקרה",
'opt_sys_couad2'        =>  "ניתן לציין רשימת מדינות המופרדות בפסיקים המורשות להיכנס ללוח הבקרה של DataLife Engine. אם אינך רוצה להגדיר מגבלות, השאר שדה זה ריק. אם הרשימה מוגדרת, ואם המבקר נמצא באחת המדינות שצוינו, תתאפשר לו התחברות ללוח הבקרה; עבור כל מדינה אחרת היא תיחסם.",
'opt_sys_coua3'         =>  "רשימת מדינות האסורות בכניסה ללוח הבקרה",
'opt_sys_couad3'        =>  "ניתן לציין רשימת מדינות המופרדות בפסיקים האסורות בכניסה ללוח הבקרה של DataLife Engine. אם אינך רוצה להגדיר מגבלות, השאר שדה זה ריק. אם הרשימה מוגדרת, ואם המבקר נמצא באחת המדינות שצוינו, תיחסם לו האפשרות להתחבר ללוח הבקרה; עבור כל מדינה אחרת היא תתאפשר.",
'opt_sys_coua5'         =>  "תיאור סיבת חסימת הגישה לאתר לפי מדינה",
'opt_sys_couad5'        =>  "ציין הודעת מידע שתוצג למבקר במקרה שהגבלת את הגישה לאתר לפי מדינות והוא נמצא במדינה חסומה. ניתן להשתמש בתגיות HTML.",
'opt_sys_couad4'        =>  "הרשימה נקבעת כשתי אותיות לפי תקן ISO-3166-1. ניתן לציין ערכים מופרדים בפסיקים, למשל RU, BY, KZ. ניתן לצפות ברשימת קודי המדינות בעמוד <a href=\"https://en.wikipedia.org/wiki/List_of_ISO_3166_country_codes\" target=\"_blank\">https://en.wikipedia.org/wiki/List_of_ISO_3166_country_codes</a>",
