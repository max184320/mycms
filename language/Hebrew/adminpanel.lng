// 11.3
'delete_selected'		=>	"האם אתה בטוח שברצונך למחוק את הקבצים שנבחרו? לא ניתן יהיה לבטל פעולה זו.",
'find_rbanners'			=>	"חומרי פרסום",
'rebuild_s_1'			=>  "התחל בנייה מחדש מ:",
'rebuild_s_2'			=>  "פרסום (הזן 0 אם ברצונך להתחיל את הבנייה מחדש מההתחלה)",
'rebuild_s_3'			=>  "תגובה (הזן 0 אם ברצונך להתחיל את הבנייה מחדש מההתחלה)",
'opt_crebuild'			=>  "בנייה מחדש של תגובות",
'rebuild_cinfo'			=>  "כלי זה מבצע בנייה מחדש של כל התגובות באתר. יש לבצע פעולה זו אם ביצעת שינויים בהגדרות הסקריפט הדורשים שמירה מחדש של תגובות כדי שיוצגו גם בתגובות ישנות. או במקרה של שינויים במנתח (parser) של הסקריפט, למשל שינויים בתגי BB. או כדי להחיל תכונות חדשות של הסקריפט שנוספו בגרסאות חדשות.<br /><br /><b>שימו לב:</b> לפני ההתחלה, אל תשכחו ליצור עותק גיבוי של מסד הנתונים, שכן לא ניתן יהיה לבטל פעולה זו במקרה של עבודה לא תקינה או לא צפויה.",
'stat_m_fail_1'			=>	"<b>שימו לב:</b><br>הפעלת מטמון Memcache בהגדרות השרת, אך הרחבת ה-PHP Memcached אינה מותקנת בשרת שלך. עליך לפנות לתמיכת האחסון שלך כדי להתקין הרחבה זו עבור PHP.",
'opt_sys_mcac'			=>  "מספר דפי האתר שיש לשמור במטמון בעת הצגת פרסומים קצרים",
'opt_sys_mcacd'			=>  "ציין את מספר הדפים בניווט האתר שעבורם יבוצע מטמון של פלט החדשות הקצרות. יצירה ועדכון של המטמון הן פעולות עתירות משאבים, ולכן יצירת מטמון לדפים עם מעט ביקורים אינה יעילה. לדוגמה, אם תציין 10, עשרת הדפים הראשונים בניווט האתר יישמרו במטמון, והדפים הבאים לא. הגדלת מספר הדפים מובילה לצריכת שטח דיסק נוסף.",
'opt_sys_https'			=>  "השתמש תמיד בפרוטוקול HTTPS",
'opt_sys_httpsd'		=>  "אם הגדרה זו מופעלת, משתמשים הנכנסים לאתר שלך באמצעות פרוטוקול HTTP רגיל יופנו אוטומטית לשימוש בחיבור SSL מאובטח.",
'group_fuf'				=>  "אפשר שליחת קבצים במשוב",
'group_fufd'			=>  "כאשר הגדרה זו מופעלת, משתמשים יוכלו לשלוח קבצים מצורפים יחד עם הודעות במשוב.",
'group_fuf2'			=>  "מספר מרבי של קבצים לשליחה במשוב",
'group_fufd2'			=>  "במקרה של מתן אישור למשתמשים לשלוח קבצים דרך המשוב, ניתן לציין את מספר הקבצים המרבי שמשתמש יכול לשלוח.",
'group_fuf3'			=>  "גודל מרבי של כל הקבצים המותרים לשליחה דרך המשוב (בקילובייט)",
'group_fufd3'			=>  "ציין את הגודל המרבי של כל הקבצים בקילובייט המותר לשליחה בהודעה דרך המשוב.",
'group_fuf4'			=>  "סיומות קבצים המורשות לשליחה דרך המשוב",
'group_fufd4'			=>  "ציין מופרדים בפסיקים את סיומות הקבצים המורשות לשליחה בהודעות דרך המשוב",
'sess_error'			=>	"תוקף סשן המשתמש שלך פג, רענן את הדף בדפדפן ובמידת הצורך היכנס לאתר מחדש.",
'opt_redirects'			=>	"הפניות",
'opt_redirectsc'		=>	"במדור זה ניתן ליצור הפניות שונות מדף אחד למשנהו.",
'opt_redirectshelp'		=>	"במדור זה ניתן ליצור הפניות מדפים מסוימים לאחרים. ניתן לבצע הפניה מדף באתר שלך לכתובת URL אחרת באתר שלך או למשאב חיצוני. כמו כן, ניתן לציין קבוצת כתובות URL באמצעות הסימן &#39;*&#39;, המציין חיפוש לפי כל תו. לדוגמה, ציון /page/*/ יבצע הפניה מהדפים /page/1/, /page/2/, /page/כל טקסט/ וכו&#39;.",
