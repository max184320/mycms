'xfield_xw4'			=>	"חבר את העורך בעת הוספה או עריכה של פרסומים עבור שדה זה",
'opt_sys_cc'			=>	"ניקוי מטמון כפוי:",
'opt_sys_ccd'			=>	"באפשרותך לקבוע מרווח דקות שלאחריו יבוצע ניקוי מטמון כפוי. לדוגמה, אם תקבע 30, המטמון ינוקה כל 30 דקות. הגדרה זו שימושית אם אתה מפרסם חדשות לתאריך עתידי והמטמון מופעל באתר. אם תקבע 0, ניקוי המטמון יתבצע אוטומטית ככל שהמידע בבסיס הנתונים משתנה. אם אינך משתמש בפרסום חדשות לתאריך עתידי, מומלץ לקבוע 0.",
'opt_sys_r1'			=>	"השבת",
