'mail_newsletter_info'	=>	"בעת כתיבת תבנית להודעה זו תוכל להשתמש בתגיות הבאות:<br /><b>{%title%}</b> - כותרת ההודעה הנשלחת<br /><b>{%content%}</b> - טקסט ההודעה הנשלחת, שנכתב בעורך לפני שליחת ההודעות<br /><b>{%charset%}</b> - קידוד האתר שלך<br /><b>{%unsubscribe%}</b> - קישור לביטול המנוי לדיוור",
