'opt_sys_cpml'          =>  "מספר תגובות לעמוד בעת צפייה בעמוד כל התגובות האחרונות",
'opt_sys_cpmld'         =>  "ציין כמה תגובות להציג בעמוד בעת צפייה בעמוד כל התגובות האחרונות.",
'opt_sys_max_new'       =>  "מספר השעות שבהן פרסום ייחשב כחדש",
'opt_sys_max_newd'      =>  "הזן את המספר המרבי של שעות שבהן פרסום ייחשב כחדש לאחר הוספתו לאתר. הגדרה זו משמשת עבור תגיות [new] טקסט [/new] בתבניות לסימון חדשות חדשות. הזמן מצוין בשעות מרגע הוספת הפרסום לאתר. למשל 24, יציין שהחדשה נחשבת לחדשה במשך יממה.",
'opt_sys_max_upd'       =>  "מספר השעות שבהן פרסום ייחשב כמעודכן",
'opt_sys_max_updd'      =>  "הזן את המספר המרבי של שעות שבהן פרסום ייחשב כמעודכן לאחר עריכתו. הגדרה זו משמשת עבור תגיות [updated] טקסט [/updated] בתבניות לסימון חדשות מעודכנות. הזמן מצוין בשעות מרגע עריכת הפרסום. למשל 24, יציין שהחדשה נחשבת למעודכנת במשך יממה.",
'v_closed'              =>  "סגור סקר להצבעות",
'hint_vclosed'          =>  "במקרה של סגירת סקר, הוא ימשיך להופיע בפרסום, אך משתמשים לא יוכלו עוד להצביע בו, אלא יראו רק את תוצאות הסקר",
'v_closed_date'         =>  "סקר זה נסגר ב-{date}",
