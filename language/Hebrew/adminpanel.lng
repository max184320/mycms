'rsschannel_del'        =>  "האם אתה באמת רוצה למחוק ערוץ RSS זה? לא ניתן יהיה לבטל פעולה זו.",
'usergroup_del'         =>  "האם אתה באמת רוצה למחוק קבוצת משתמשים זו? לא ניתן יהיה לבטל פעולה זו.",
'banners_c_opt'         =>  "הצגת בלוק בין תגובות",
