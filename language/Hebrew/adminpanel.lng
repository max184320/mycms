// 16.0
'error_max_queue'       =>   "חריגה ממספר הקבצים המרבי המותר להעלאה",
'files_public'          =>   "ציבורי",
'files_private'         =>   "פרטי",
'opt_sys_fa'            =>   "מצב גישה לקבצים באחסון",
'opt_sys_fad'           =>   "בהגדרה זו באפשרותך לציין אילו הרשאות גישה יוקצו לקבצים לאחר העלאתם לשרת. מצב פרטי פירושו שגישה מלאה תהיה זמינה רק בשם בעל הקובץ בשרת, מצב ציבורי פירושו שלכל המשתמשים בשרת תינתן גישה מלאה. לניהול קל של קבצים, למשל, באמצעות FTP ובשרת מקומי, מומלץ להגדיר מצב ציבורי, אך שירותים חיצוניים מסוימים עשויים לדרוש הפעלה חובה של מצב פרטי. לדוגמה, אחסון Cloudflare S3.",
'opt_sys_maxfilesh'     =>   "גודל חבילה במגה-בייט בעת העלאת קבצים",
'opt_sys_maxfileshd'    =>   "בעת העלאת קבצים גדולים, קבצים אלו מחולקים לחבילות נפרדות כדי לא לחרוג מהמגבלות המוגדרות בשרת. באפשרותך לציין את גודל חבילת הנתונים שתישלח לשרת בכל פעם, היא מצוינת במגה-בייט. ככל שיישלחו פחות חבילות, כך ההעלאה לשרת תהיה מהירה יותר. הגדרה זו מיועדת למשתמשים מנוסים, אל תשנה אותה אם אינך יודע למה היא מיועדת. גודל החבילה המחדל הוא 1.5, מה שאומר שיישלחו חבילות של מגה-בייט וחצי כל אחת.",
