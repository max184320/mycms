'dumper_32'				=>	"שגיאה: אתה מנסה לשחזר מסד נתונים שאינו תואם לגרסת הסקריפט. שחזור מסדי נתונים מגרסאות אחרות עלול לשבש את מבנה מסד הנתונים ולהוביל לחוסר תפקוד של הסקריפט.",
'send_pm'				=>	"שלח הודעה",
