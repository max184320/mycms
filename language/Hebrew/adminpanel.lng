// 10.1
'opt_sys_amet'			=>	"יצירה אוטומטית של תגי מטא &#39;description&#39; ו-&#39;keywords&#39; עבור פרסומים",
'opt_sys_ametd'			=>	"באפשרותך להפעיל מילוי אוטומטי של תגי מטא &#39;description&#39; ו-&#39;keywords&#39; עבור פרסומים. אם בעת הוספת פרסומים לאתר שדות אלו לא מולאו, הסקריפט ייצור אותם אוטומטית.",
'opt_sys_iprest'		=>	"רשימת כתובות IP המורשות להתחבר ללוח הבקרה של הסקריפט",
'opt_sys_iprestd'		=>	"באפשרותך להגביל את ההתחברות ללוח הבקרה לכתובות IP מסוימות בלבד. שים לב, היה זהיר בעת שינוי הגדרה זו. הגישה ללוח הבקרה תתאפשר רק מכתובות ה-IP שצוינו. ניתן לציין מספר כתובות, אחת בכל שורה. ניתן לציין כתובת IP מלאה או מסכה, לדוגמה: 192.48.25.71 או 129.42.*.* כדי לא להגדיר הגבלות IP, השאר שדה זה ריק.",
'opt_sys_r6'			=>	"הפעל, סינון חלש",
'group_fspam'			=>	"הפעל הגנה אוטומטית מפני ספאם בעת כתיבת תגובות",
'hint_fspam'			=>	"אפשרות זו מאפשרת להפעיל הגנה אוטומטית מפני ספאם עבור קבוצה זו בעת כתיבת תגובות באתר. ההגנה מתבצעת באמצעות שימוש במשאב הענן http://www.stopforumspam.com/. משאב זה מאחסן ומספק מידע על מספר עצום של ספאמרים מכל העולם, מה שמאפשר למנוע ספאם באתר על בסיס מידע זה.",
'opt_sys_html5'			=>	"השתמש בנגן HTML5 כנגן ראשי להפעלת וידאו",
'opt_sys_html5d'		=>	"אם &#39;מופעל&#39;, אז בעת הטמעת וידאו בפורמט mp4 ובעת הטמעת וידאו משירות Youtube ייעשה שימוש בנגן HTML5 במקום נגן פלאש, מה שיאפשר לצפות בוידאו באתר שלך לא רק בדפדפן רגיל, אלא גם במכשירים ניידים (iphone, ipad, android).",
'opt_sys_rfc'			=>	"חפש פרסומים דומים רק באותן קטגוריות שבהן נמצאת הידיעה עצמה",
'opt_sys_rfcd'			=>	"אם &#39;מופעל&#39;, אז בעת חיפוש חדשות דומות, תילקח בחשבון הקטגוריה שאליה שייך הפרסום. ויוצגו רק חדשות מאותה קטגוריה או מתתי-קטגוריות (אם מותרת הצגת חדשות מתתי-קטגוריות). אם &#39;מושבת&#39;, יבוצע חיפוש של פרסומים דומים מכל הקטגוריות.",
'opt_links'				=>	"קישורים צולבים",
'opt_linksc'			=>	"במדור זה באפשרותך ליצור קישורים צולבים באתר לפי מילות מפתח שונות.",
'add_links'				=>	"הוסף קישור חדש",
'links_not_found'		=>	"עדיין לא יצרת קישורים צולבים",
'opt_linkshelp'			=>	"במדור זה באפשרותך ליצור קישורים צולבים באתר לפי מילות מפתח שונות. בעת יצירת קישור, באפשרותך לציין מילת מפתח וכתובת URL באתר שלך או בכל משאב חיצוני אחר. כאשר מילת מפתח זו תימצא באתר שלך, היא תוחלף בקישור לחיץ המוביל לכתובת ה-URL שצוינה. החיפוש מתבצע בחדשות, תגובות, תבניות, כלומר בכל רחבי האתר שלך.<br /><br />באפשרותך להשתמש בהטיות בעת יצירת מילת מפתח, למשל באפשרותך להגדיר את המילה: <b>Ivanov</b>, או להגדיר <b>Ivan(ov|ova|ovu)</b>, ואז יוחלפו המילים Ivanov, Ivanova, Ivanovu וכו&#39;.",
'add_links_new'			=>	"הוספת קישור חדש",
'add_links_tag'			=>	"הזן מילת מפתח:",
'add_links_url'			=>	"הזן URL של הקישור:",
'add_links_one'			=>	"התחשב ברישיות (Case Sensitive)",
'tagscloud_del_2'		=>	"ממודול הקישורים הצולבים?",
'mass_links_err'		=>	"לא בחרת מילות מפתח לביצוע פעולות.",
