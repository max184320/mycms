// 9.8
'media_upload_st14'		=>	"העלה קובץ מהמחשב",
'opt_sys_adr'			=>	"אמת משתמשים בדומיין ובכל תת-הדומיינים שלו",
'opt_sys_adrd'			=>	"אם &#39;מופעל&#39;, אז משתמשים שמתחברים לאתר יאומתו בדומיין ובכל תת-הדומיינים שלו. לדוגמה, אם משתמש התחבר לדומיין ברמה שנייה domen.ru, נתוני האימות שלו יהיו זמינים גם בתת-דומיין test.domen.ru ובכל תת-דומיין אחר. הפעלת הגדרה זו נחוצה למשתמשים שמתקינים את הסקריפט בדומיין ובתת-דומיינים ורוצים ליצור אימות מבקרים מאוחד עבורם. בעת השבתת הגדרה זו, נתוני האימות של המשתמשים יחולו רק על הדומיין שבו הותקן הסקריפט. השבתת הגדרה זו נחוצה אם אתה יוצר אתרים עצמאיים בדומיין ובתת-דומיינים.",
'edit_upp'				=>	"מספר משתמשים לדף:",
'mark_spam_ok'			=>	"המשתמש סומן כספאמר. כל התגובות שלו נמחקו, וכן נאסר עליו לפרסם חדשות ותגובות באתר. לרענן דף זה?",
'mark_spam_error'		=>	"לא ניתן לסמן משתמש זה כ-«ספאמר». לרענן דף זה?",
'mark_spam_ok_1'		=>	"סומן על ידי הנהלת האתר כ-«ספאמר».",
'mark_spam_ok_2'		=>	"המשתמש סומן כספאמר. כל החדשות שלו הממתינות למודרציה נמחקו, וכן נאסר עליו לפרסם חדשות ותגובות באתר. לעבור לדף עריכת החדשות?",
