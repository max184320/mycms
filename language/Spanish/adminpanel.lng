'plugins_myupgrade'		=>	"Al actualizar el plugin:",
'plugins_myenable'		=>	"Al activar el plugin:",
'plugins_mydisable'		=>	"Al desactivar el plugin:",
'plugins_mydelete'		=>	"Al eliminar el plugin:",
'plugins_myinfo'		=>	"Al escribir consultas MySQL también puede utilizar las siguientes etiquetas de servicio:<br><br><b>{prefix}</b> - esta etiqueta será reemplazada por el prefijo de las tablas indicado durante la instalación del script, utilizado por DataLife Engine para sus propias tablas.<br><b>{userprefix}</b> - esta etiqueta será reemplazada por el prefijo de las tablas utilizado para trabajar con los datos de usuario, al usar el registro y autorización únicos en varios sitios unidos.<br><b>{charset}</b> - esta etiqueta será reemplazada por la codificación de las tablas de la base de datos que utiliza el script, por ejemplo: utf8 o utf8mb4.<br><b>{engine}</b> - esta etiqueta será reemplazada por el motor MySQL que utiliza DLE para la base de datos. Pueden ser los valores InnoDB o MyISAM.<br><br><b>Tenga en cuenta:</b> al instalar el plugin también se ejecutará automáticamente el activador de activación del plugin, y al eliminar el plugin, el activador de desactivación del plugin no se ejecutará.",
'plugins_myinfo_1'		=>	"Puede indicar consultas MySQL a la base de datos que se ejecutarán al realizar ciertas acciones con el plugin:",
'plugins_nerror'		=>	"El nombre del plugin es obligatorio",
'plugins_nerror_1'		=>	"Ya hay un plugin con este nombre instalado en el sitio",
'plugins_nerror_2'		=>	"Este plugin no es compatible con la versión de DLE instalada. Para el funcionamiento de este plugin se requiere la versión de DLE <b>{version}</b> {versioncompare}. Su versión de DataLife Engine es <b>{dleversion}</b>",
'plugins_addfile'		=>	"Añadir archivo",
'plugins_addact'		=>	"Añadir acción",
'plugins_filename'		=>	"Nombre del archivo:",
'plugins_file_h'		=>	"Indique el nombre del archivo para el cual se realizará esta acción. Debe indicar solo archivos .php o .lng. La ruta al archivo debe indicarse relativa a la raíz de su sitio, por ejemplo: engine/modules/main.php",
'plugins_f_del'			=>	"¿Realmente desea eliminar todas las acciones sobre este archivo?",
'plugins_a_del'			=>	"¿Realmente desea eliminar la acción seleccionada?",
'plugins_a_del_1'		=>	"Eliminar acción",
