'opt_sys_rscd'			=>  "Al activar este ajuste, el sistema interno de registro en DataLife Engine se desactiva, y solo podrán autorizarse en su sitio los usuarios que tengan cuentas en redes sociales",
'login_box_1'			=>  "Introduzca su nombre de usuario",
