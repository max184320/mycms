$lang = array_merge($lang, array (

// 14.2
'admin_check_37'	=>	"Su sitio tiene habilitada la opción de mostrar toda la información sobre el autor de la publicación desde su perfil. Esta función realiza consultas complejas a la base de datos para obtener información, lo que genera una carga significativa en la misma. Para desactivar este ajuste, vaya a <b>Configuración del script &raquo; Optimización de consultas a la base de datos</b> y desactive esta opción.",// 14.2
// 14.2

// 12.1
'admin_check_36'	=>	"Ha activado el recuento de visualizaciones para los materiales publicitarios. Esta función aumenta el número de peticiones a la base de datos. Para desactivar este ajuste, vaya a la sección de configuración de materiales publicitarios y desactive el seguimiento de impresiones de los mismos.",
// 12.1

// 11.2
'admin_check_35'	=>	"Ha activado el recuento del número de publicaciones para cada categoría. Esta función aumenta el número de consultas a la base de datos por parte del script. Para desactivar este ajuste, vaya a <b>Configuración del script &raquo; Optimización de consultas a la base de datos</b> y desactive esta opción.",
