// 9.4

// 9.3
'change_mail_subj'	=>	"ई-मेल पता बदलने का अनुरोध",
'change_mail'		=>	"<li>प्रिय आगंतुक! आपने अपना ई-मेल पता बदल लिया है। साइट प्रशासन को सभी दर्ज ई-मेल पतों के वास्तविक होने की आवश्यकता है। 10 मिनट के भीतर (या उससे पहले) आपको अगले चरण के निर्देशों के साथ एक पत्र प्राप्त होगा। यदि आपको इस समय के दौरान पुष्टि पत्र प्राप्त नहीं हुआ है, तो संभवतः यह स्पैम फ़ोल्डर में चला गया है। कृपया उस फ़ोल्डर की जाँच करें। अन्यथा, दूसरे ई-मेल पते का उपयोग करके पुन: प्रयास करें या साइट प्रशासक से संपर्क करें।</li>",
'change_mail_1'		=>	"प्रिय {name}! आपका ई-मेल पता बदलने का अनुरोध:",
'change_mail_2'		=>	"स्वीकार कर लिया गया है।",
'change_mail_3'		=>	"साइट पर ई-मेल पता बदलने के लिए, आपको लिंक का पालन करना होगा:",
'change_mail_4'		=>	"आप साइट पर लॉग इन नहीं हैं। ई-मेल पता बदलने के लिए, आपको अपने लॉगिन और पासवर्ड के साथ साइट पर लॉग इन करना होगा, फिर ई-मेल बदलने के लिए इस लिंक पर जाना होगा।",
'change_mail_5'		=>	"ई-मेल बदलना संभव नहीं है। आप किसी अन्य लॉगिन के साथ लॉग इन हैं या इस उपयोगकर्ता ने साइट पर ई-मेल बदलने का अनुरोध नहीं किया है।",
'change_mail_6'		=>	"साइट पर आपका ई-मेल सफलतापूर्वक बदल दिया गया है।",
'news_info_7'		=>	"साइट प्रशासक ने पंजीकरण के बाद {days} दिनों तक लेख जोड़ने पर रोक लगा दी है।",
'news_info_8'		=>	"साइट प्रशासक ने पंजीकरण के बाद {days} दिनों तक टिप्पणियाँ जोड़ने पर रोक लगा दी है।",
'vote_not_allow'	=>	"आप साइट पर मतदान में भाग नहीं ले सकते।",
'add_to_ignore'		=>	"क्या आप वाकई प्रेषक को अनदेखा किए गए उपयोगकर्ताओं की सूची में जोड़ना चाहते हैं?",
'ignore_error'		=>	"आप खुद को अनदेखा नहीं कर सकते।",
'ignore_error_1'	=>	"यह प्रेषक पहले से ही अनदेखा किए गए उपयोगकर्ताओं की सूची में है।",
'ignore_error_2'	=>	"आप व्यवस्थापक समूहों के उपयोगकर्ताओं को अनदेखा नहीं कर सकते।",
'ignore_ok'			=>	"प्रेषक को अनदेखा किए गए उपयोगकर्ताओं की सूची में जोड़ दिया गया है। अब आपको इस उपयोगकर्ता से संदेश प्राप्त नहीं होंगे। आप अपनी साइट प्रोफ़ाइल में उपयोगकर्ता को अनब्लॉक कर सकते हैं।",
'del_from_ignore'	=>	"क्या आप वाकई उपयोगकर्ता को अनदेखा किए गए उपयोगकर्ताओं की सूची से हटाना चाहते हैं?",
