'editor_wisywig'        =>  "दृश्य संपादक (Visual Editor)",
'opt_sys_coua6'         =>  "आपके IP को ध्यान में रखते हुए आपके देश की पहचान इस रूप में की गई है:",
'opt_sys_coua7'         =>  "प्रतिबंधित देशों के बॉट्स को साइट देखने की अनुमति दें",
'opt_sys_couad7'        =>  "यदि आपने कुछ देशों के लिए साइट देखने पर प्रतिबंध लगा दिया है, तो आप उन देशों के बॉट्स द्वारा साइट देखने की अनुमति को चालू या बंद कर सकते हैं। उदाहरण के लिए, ताकि सर्च बॉट आपकी साइट को इंडेक्स कर सकें, भले ही वे किसी प्रतिबंधित देश से आ रहे हों।",
'opt_sys_coua8'         =>  "VPN के उपयोग को रोकें",
'opt_sys_couad8'        =>  "इस सेटिंग को सक्षम करने पर, यदि कोई उपयोगकर्ता ऐसे देश से साइट पर आता है जहाँ देखना प्रतिबंधित है, तो उसे याद रखा जाएगा और उसकी पहुँच को ब्लॉक कर दिया जाएगा, भले ही वह VPN सर्वर का उपयोग करके साइट पर आए।",
'opt_sys_coua9'         =>  "देश प्राप्त करने के लिए CloudFlare का उपयोग करें",
'opt_sys_couad9'        =>  "यदि आपकी साइट CloudFlare सेवा से जुड़ी है और उसके माध्यम से प्रॉक्सी की जा रही है, तो आप इस सेवा से विज़िटर का देश प्राप्त करना सक्षम कर सकते हैं। इस मामले में, स्थानीय डेटाबेस का उपयोग नहीं किया जाएगा, जिससे सर्वर पर लोड कम हो जाता है, और कुछ मामलों में डेटा अधिक सटीक हो सकता है।",
'opt_sys_fgl'           =>  "फीडबैक में डिफ़ॉल्ट उपयोगकर्ता",
'opt_sys_fgld'          =>  "उन उपयोगकर्ता समूहों को निर्दिष्ट करें जिनके उपयोगकर्ता साइट पर फीडबैक फ़ॉर्म में डिफ़ॉल्ट रूप से प्रदर्शित होंगे, यदि ईमेल किसी विशिष्ट उपयोगकर्ता को नहीं भेजा जा रहा है।",
'settings_panel_14'     =>  "एडिटर सेटिंग्स",
'settings_panel_15'     =>  "क्लासिक दृश्य",
'settings_panel_16'     =>  "लाइट दृश्य",
'settings_panel_17'     =>  "एडिटर की ऑटो हाइट",
'rss_add_source'        =>  "सोर्स लिंक जोड़ें",
'rss_add_source_1'      =>  "संक्षिप्त विवरण में जोड़ें",
'rss_add_source_2'      =>  "पूर्ण विवरण में जोड़ें",
'rss_add_source_3'      =>  "संक्षिप्त और पूर्ण विवरण में जोड़ें",
'banner_country'        =>  "इन देशों में देखने की अनुमति दें:",
'banner_country_1'      =>  "इन देशों में देखने पर प्रतिबंध लगाएं:",
'banner_country_2'      =>  "सूची ISO-3166-1 मानक के अनुसार दो अक्षरों के रूप में दी गई है। आप अल्पविराम द्वारा अलग किए गए मान सूचीबद्ध कर सकते हैं, उदाहरण के लिए RU, BY, KZ",
'group_max_ncr'         =>  "नकारात्मक रेटिंग देने पर प्रतिबंध",
'hint_max_ncr'          =>  "प्रति दिन उन टिप्पणियों की अधिकतम संख्या दर्ज करें जिन पर उपयोगकर्ता को नकारात्मक रेटिंग या डिसलाइक देने की अनुमति है, उदाहरण के लिए, 2 सेट करने पर, उपयोगकर्ता प्रति दिन केवल दो बार अलग-अलग टिप्पणियों पर नकारात्मक रेटिंग दे सकेगा। सकारात्मक रेटिंग की संख्या सीमित नहीं है। यदि आप नकारात्मक रेटिंग की संख्या पर प्रतिबंध हटाना चाहते हैं, तो 0 दर्ज करें।",
'hint_max_ncr_1'        =>  "प्रति दिन उन पोस्टों की अधिकतम संख्या दर्ज करें जिन पर उपयोगकर्ता को नकारात्मक रेटिंग या डिसलाइक देने की अनुमति है, उदाहरण के लिए, 2 सेट करने पर, उपयोगकर्ता प्रति दिन केवल दो बार अलग-अलग पोस्टों पर नकारात्मक रेटिंग दे सकेगा। सकारात्मक रेटिंग की संख्या सीमित नहीं है। यदि आप नकारात्मक रेटिंग की संख्या पर प्रतिबंध हटाना चाहते हैं, तो 0 दर्ज करें।",
'disable_config'        =>  "इस सेटिंग को अक्षम करें",
'disable_config_1'      =>  "सेटिंग सफलतापूर्वक अक्षम कर दी गई है",
'disable_config_2'      =>  "अमान्य सेटिंग पैरामीटर",
'disable_config_3'      =>  "क्या आप वाकई इस सेटिंग को अक्षम करना चाहते हैं?",
'banned_from'           =>  "खाता उपयोगकर्ता द्वारा ब्लॉक किया गया था: <b>{name}</b>",
'opt_sys_aim'           =>  "AI असिस्टेंट सपोर्ट सक्षम करें",
'opt_sys_aimd'          =>  "इस सेटिंग को सक्षम करने पर, आप साइट पर पोस्ट लिखने में सहायता के लिए AI असिस्टेंट का उपयोग कर सकते हैं। इस विकल्प को सक्षम करते समय, आपको API एक्सेस पैरामीटर निर्दिष्ट करने होंगे, साथ ही उन उपयोगकर्ता समूहों को भी निर्दिष्ट करना होगा जिन्हें AI उपयोग करने की अनुमति है।",
'opt_sys_aim1'          =>  "AI असिस्टेंट API एक्सेस की",
'opt_sys_aim1d'         =>  "चयनित न्यूरल नेटवर्क के लिए ऑथेंटिकेशन और एक्सेस के लिए आपकी सीक्रेट की।<br><br><b>कहाँ से प्राप्त करें और कैसे निर्दिष्ट करें:</b><ul><li><b>OpenAI, Anthropic, Grok, OpenRouter:</b> सीक्रेट की संबंधित प्रदाता के व्यक्तिगत खाते से प्राप्त की जाती है।</li><li><b>Google Gemini:</b> की <b>Google AI Studio</b> में बनाई जाती है।</li><li><b>Yandex GPT:</b> आपको Yandex Cloud कंसोल में अपने सर्विस अकाउंट के लिए «API-key» बनाना होगा (अस्थायी IAM-token के साथ भ्रमित न हों)।</li></ul><b>तकनीकी जानकारी:</b><br>स्क्रिप्ट स्वचालित रूप से प्रत्येक सिस्टम के लिए आवश्यक ऑथेंटिकेशन विधि लागू करती है: <i>Authorization: Bearer</i> (OpenAI/Grok के लिए), <i>x-api-key</i> (Anthropic के लिए), <i>Api-Key</i> (Yandex के लिए) या Google Gemini के लिए एड्रेस में की का सीधा ट्रांसमिशन।",
'opt_sys_aim2'          =>  "AI असिस्टेंट एक्सेस पॉइंट के लिए URL एड्रेस",
'opt_sys_aim2d'         =>  "अपने API प्रदाता का एड्रेस (Endpoint) दर्ज करें। स्क्रिप्ट एड्रेस में कीवर्ड द्वारा स्वचालित रूप से सिस्टम (OpenAI, Google, Anthropic या Yandex) का पता लगा लेगी।<br><br><b>एड्रेस के उदाहरण:</b><ul><li><b>OpenAI Chat Completions API / OpenRouter / Grok:</b> https://api.openai.com/v1/chat/completions</li><li><b>OpenAI Responses API:</b> https://api.openai.com/v1/responses</li><li><b>Anthropic (Claude):</b> https://api.anthropic.com/v1/messages</li><li><b>Yandex GPT:</b> https://llm.api.cloud.yandex.net/foundationModels/v1/completion</li><li><b>Google Gemini:</b> Google में मॉडल का नाम सीधे URL में निर्दिष्ट किया जाता है। <br>उदाहरण के लिए Gemini 1.5 Flash के लिए: <br>https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:streamGenerateContent</li></ul> आप किसी भी सेवा के लिए अपना स्वयं का पाथ निर्दिष्ट कर सकते हैं जो उपरोक्त प्रोटोकॉल का समर्थन करती है। इस प्रकार, यदि आपके देश के लिए AI API तक सीधी पहुँच प्रतिबंधित है, तो आप किसी भी ऐसी सेवा का उपयोग कर सकते हैं जो आपके देश के लिए ये सेवाएँ प्रदान करती है। उदाहरण के लिए, Russia के लिए यह https://proxyapi.ru/ सेवा हो सकती है।",
'opt_sys_aim3'          =>  "भाषा मॉडल चुनें",
'opt_sys_aim3d'         =>  "काम करने के लिए न्यूरल नेटवर्क मॉडल का आइडेंटिफायर।<br><br><b>कैसे भरें:</b><ul><li><b>Google Gemini:</b> आप इस फ़ील्ड को खाली छोड़ सकते हैं (मॉडल पहले से ही आपके द्वारा ऊपर API URL फ़ील्ड में सेट किया गया है)।</li><li><b>OpenAI:</b> उदाहरण के लिए gpt-4o या gpt-4o-mini।</li><li><b>Anthropic:</b> उदाहरण के लिए claude-3-5-sonnet-latest।</li><li><b>Grok:</b> उदाहरण के लिए grok-2-1212 या grok-beta।</li><li><b>Yandex GPT:</b> आपका Folder ID gpt://YOUR_FOLDER_ID/yandexgpt/latest फॉर्मेट में निर्दिष्ट है।</li><li><b>OpenRouter:</b> मॉडल प्रदाता प्रीफिक्स के साथ निर्दिष्ट है, उदाहरण के लिए google/gemini-2.0-flash-001।</li></ul>",
'opt_sys_aim4'          =>  "max_tokens पैरामीटर के लिए टोकन की अधिकतम संख्या",
'opt_sys_aim4d'         =>  "आप असिस्टेंट के उत्तर में टोकन की अधिकतम संख्या निर्दिष्ट कर सकते हैं। चूंकि API एक्सेस सशुल्क है, इसलिए बहुत अधिक मान निर्दिष्ट न करें, क्योंकि इससे आपके बैलेंस पर खर्च बढ़ सकता है। इस पैरामीटर का उपयोग न करने के लिए, इस फ़ील्ड को खाली छोड़ दें।",
'opt_sys_aim5'          =>  "भाषा मॉडल के उत्तर की प्रकृति (Temperature)",
'opt_sys_aim5d'         =>  "उत्तर की प्रकृति 0 से 1 तक के संख्यात्मक मान के रूप में सेट की जाती है। मान शून्य के जितना करीब होगा, उत्तर उतना ही सटीक होगा, एक के जितना करीब होगा उत्तर उतना ही रचनात्मक होगा। उदाहरण के लिए, 0.5 का अर्थ है संतुलित उत्तर।",
'opt_sys_aim6'          =>  "वे उपयोगकर्ता समूह जिन्हें AI असिस्टेंट का उपयोग करने की अनुमति है",
'opt_sys_aim6d'         =>  "चूंकि API आधारित AI तक पहुँच सशुल्क है, इसलिए बैलेंस पर अधिक खर्च से बचने के लिए केवल विश्वसनीय उपयोगकर्ताओं को ऐसी पहुँच प्रदान करने की अनुशंसा की जाती है।",
'ai_command_1'          =>  "इस टेक्स्ट के मुख्य बिंदुओं और अवधारणाओं को सारांश में लिखें।",
'ai_command_2'          =>  "इस टेक्स्ट को बिना वर्तनी की गलतियों के, सही व्याकरण और अधिक वर्णनात्मक भाषा के साथ, मूल अर्थ खोए बिना लेखन के सर्वोत्तम तरीकों का उपयोग करके फिर से लिखें।",
'ai_command_3'          =>  "इस टेक्स्ट को सरल भाषा का उपयोग करके फिर से लिखें और टेक्स्ट की जटिलता को कम करें ताकि इसे समझना आसान हो सके।",
'ai_command_4'          =>  "टेक्स्ट को अधिक समझने योग्य बनाने और सामग्री की मात्रा बढ़ाने के लिए वर्णनात्मक भाषा और अधिक विस्तृत स्पष्टीकरण का उपयोग करके इस टेक्स्ट को और विस्तार से लिखें।",
'ai_command_5'          =>  "अर्थ बदले बिना या किसी मुख्य जानकारी को खोए बिना इस टेक्स्ट में सभी दोहराए गए, फालतू या महत्वहीन प्रविष्टियों को हटा दें ताकि टेक्स्ट अधिक संक्षिप्त और स्पष्ट हो सके।",
'ai_command_6'          =>  "पेशेवर अनुभव और क्षमता व्यक्त करने के लिए पॉलिश, औपचारिक और सम्मानजनक भाषा का उपयोग करके इस टेक्स्ट को फिर से लिखें।",
'ai_command_7'          =>  "एक वास्तविक व्यक्ति के साथ अनौपचारिक बातचीत को व्यक्त करने के लिए इस टेक्स्ट को अनौपचारिक भाषा में फिर से लिखें।",
'ai_command_8'          =>  "केवल सबसे महत्वपूर्ण जानकारी का उपयोग करके इस टेक्स्ट को सीधे शब्दों में फिर से लिखें।",
'ai_command_9'          =>  "जो लिखा गया है उसमें विश्वास व्यक्त करने के लिए प्रेरक, आशावादी भाषा में इस टेक्स्ट को फिर से लिखें।",
'ai_command_10'         =>  "समझ और सहानुभूति व्यक्त करने के लिए दोस्ताना, आश्वस्त करने वाली भाषा में इस टेक्स्ट को फिर से लिखें।",
'ai_command_11'         =>  "पेशेवर और व्यावसायिक शैली में औपचारिक भाषा का उपयोग करके इस टेक्स्ट को फिर से लिखें।",
'ai_command_12'         =>  "सही कानूनी शब्दावली का उपयोग करके एक पेशेवर वकील की तरह इस टेक्स्ट को फिर से लिखें।",
'ai_command_13'         =>  "जानकारी के महत्व को व्यक्त करने के लिए आकर्षक भाषा का उपयोग करके एक पत्रकार की तरह इस टेक्स्ट को फिर से लिखें।",
'ai_command_14'         =>  "सामान्य चिकित्सा शब्दावली का उपयोग करके एक पेशेवर डॉक्टर की तरह इस टेक्स्ट को फिर से लिखें।",
'ai_command_15'         =>  "मूल अर्थ खोए बिना काव्य तकनीकों का उपयोग करके इस टेक्स्ट को कविता के रूप में फिर से लिखें।",
