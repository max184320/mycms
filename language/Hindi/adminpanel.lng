'opt_sys_qsn'			=>  "समाचार जोड़ते समय प्रश्न-उत्तर प्रणाली सक्षम करें",
'opt_sys_qsc'			=>  "कमेंट्स जोड़ते समय प्रश्न-उत्तर प्रणाली सक्षम करें",
'opt_sys_code_com'		=>	"कमेंट्स जोड़ते समय सुरक्षा कोड (CAPTCHA) सक्षम करें",
'opt_sys_qspm'			=>  "व्यक्तिगत संदेश भेजते समय प्रश्न-उत्तर प्रणाली सक्षम करें",
'hint_qcode_2'			=>	"इस सेटिंग को सक्षम करने पर, साइट पर व्यक्तिगत संदेश भेजते समय, उपयोगकर्ता को प्रस्तावित प्रश्नों में से एक का उत्तर देना होगा। यह विकल्प साइट को स्पैम बॉट्स से अतिरिक्त सुरक्षा प्रदान करने की अनुमति देता है। प्रश्नों और उनके उत्तरों की सूची स्क्रिप्ट के एडमिन पैनल में संबंधित प्रश्न सेटिंग्स अनुभाग में निर्दिष्ट की जाती है।",
'opt_sys_code_feed'		=>	"फीडबैक फॉर्म के लिए सुरक्षा कोड (CAPTCHA) सक्षम करें",
'opt_sys_code_feedd'	=>	"साइट पर फीडबैक फॉर्म के माध्यम से संदेश भेजते समय सुरक्षा कोड (CAPTCHA) का प्रदर्शन",
'opt_sys_qsfeed'		=>  "फीडबैक फॉर्म के लिए प्रश्न-उत्तर प्रणाली सक्षम करें",
'hint_qcode_3'			=>	"इस सेटिंग को सक्षम करने पर, साइट पर फीडबैक फॉर्म के माध्यम से E-mail संदेश भेजते समय, उपयोगकर्ता को प्रस्तावित प्रश्नों में से एक का उत्तर देना होगा। यह विकल्प साइट को स्पैम बॉट्स से अतिरिक्त सुरक्षा प्रदान करने की अनुमति देता है। प्रश्नों और उनके उत्तरों की सूची स्क्रिप्ट के एडमिन पैनल में संबंधित प्रश्न सेटिंग्स अनुभाग में निर्दिष्ट की जाती है।",
'opt_sys_rmip'			=>	"एक ही IP से कई उपयोगकर्ताओं के पंजीकरण की अनुमति दें",
'opt_sys_rmipd'			=>	"इस विकल्प को सक्षम करने पर, एक ही IP पते से उपयोगकर्ता को कई लॉगिन पंजीकृत करने की अनुमति होगी, अन्यथा यदि विज़िटर का IP किसी अन्य पंजीकृत उपयोगकर्ता द्वारा उपयोग किया गया था, तो पंजीकरण प्रतिबंधित कर दिया जाएगा।",
'opt_sys_top_num'		=>	"लोकप्रिय समाचार ब्लॉक में समाचारों की संख्या",
'opt_sys_top_numd'		=>	"लोकप्रिय समाचार ब्लॉक में प्रदर्शित होने वाले समाचारों की संख्या।",
'opt_sys_cloud_num'		=>	"साइट पर टैग क्लाउड ब्लॉक में कीवर्ड की संख्या",
'opt_sys_cloud_numd'	=>	"साइट पर टैग क्लाउड ब्लॉक में प्रदर्शित होने वाले कीवर्ड की संख्या।",
'opt_sys_mt'			=>	"ईमेल भेजते समय प्रेषक का शीर्षक",
'opt_sys_mtd'			=>	"साइट से ईमेल भेजते समय आप एक शीर्षक निर्दिष्ट कर सकते हैं जो प्रेषक के ईमेल में जोड़ा जाएगा। उदाहरण के लिए, आप वहां अपनी साइट का संक्षिप्त नाम निर्दिष्ट कर सकते हैं",
'opt_sys_sdefm'			=>	"मूल छवि के लिए डिफ़ॉल्ट पैरामीटर",
'opt_sys_sdefmd'		=>	"यदि आपने ऊपर की सेटिंग्स में मूल छवि के लिए अधिकतम आकार निर्दिष्ट किया है, तो आप निर्दिष्ट कर सकते हैं कि डिफ़ॉल्ट रूप से मूल छवि का नियंत्रण किस पक्ष पर किया जाएगा।",
'opt_sys_online'		=>	"साइट पर उपयोगकर्ताओं के लिए &#39;ऑनलाइन&#39; स्थिति समर्थन सक्षम करें",
'opt_sys_onlined'		=>	"इस सेटिंग को अक्षम करने से साइट पर उपयोगकर्ता प्रोफाइल के अपडेट होने की आवृत्ति कम हो जाती है, जो MySQL सर्वर संसाधनों को बचाने की अनुमति देती है। इस मामले में, अक्षम होने पर, [online][/online] और [offline][/offline] टैग ठीक से काम नहीं करेंगे, और उन्हें टेम्पलेट्स से हटाना होगा।",
'opt_sys_av'			=>	"प्रोफ़ाइल में उपयोगकर्ता द्वारा अपलोड किए गए अवतारों का अधिकतम स्वीकार्य वजन",
'opt_sys_avd'			=>	"प्रोफ़ाइल में उपयोगकर्ताओं द्वारा साइट पर अपलोड किए जाने वाले अवतारों का अधिकतम स्वीकार्य वजन निर्दिष्ट करें (किलोबाइट में)। साथ ही 0 वजन पर प्रतिबंध हटा देता है, और -1 अवतार अपलोड करने पर वैश्विक प्रतिबंध लगा देता है। ",
'news_add'				=>	"जोड़ें",
'news_save'				=>	"सहेजें",
'cat_delete'			=>	"क्या आप वास्तव में चुनी गई श्रेणी को हटाना चाहते हैं? इस क्रिया को पूर्ववत नहीं किया जा सकेगा।",
'cat_sort_ok'			=>	"सॉर्टिंग सफलतापूर्वक सहेजी गई।",
'cat_sort_fail'			=>	"सॉर्टिंग त्रुटि के साथ समाप्त हुई।",
'i_quote'				=>	"उद्धरण:",
