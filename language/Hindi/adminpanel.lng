'xfield_xi36'           =>  "आप पोस्ट लिखते समय इस फ़ील्ड में लिखे जाने वाले अक्षरों की न्यूनतम संख्या निर्दिष्ट कर सकते हैं। यदि आप यह प्रतिबंध नहीं लगाना चाहते हैं, तो फ़ील्ड को खाली छोड़ दें।",
'xfield_xi37'           =>  "आप पोस्ट लिखते समय इस फ़ील्ड में लिखे जाने वाले अक्षरों की अधिकतम संख्या निर्दिष्ट कर सकते हैं। यदि आप यह प्रतिबंध नहीं लगाना चाहते हैं, तो फ़ील्ड को खाली छोड़ दें।",
'xfield_f36'            =>  "फ़ील्ड में अक्षरों की न्यूनतम संख्या",
'xfield_f37'            =>  "फ़ील्ड में अक्षरों की अधिकतम संख्या",
'addnews_xf_alert_2'    =>  "फ़ील्ड <b>{field}</b> में कम से कम <b>{count}</b> अक्षर होने चाहिए",
'addnews_xf_alert_3'    =>  "फ़ील्ड <b>{field}</b> में अधिकतम <b>{count}</b> अक्षर होने चाहिए",
'group_acn'             =>  "पोस्ट पर शिकायतें भेजने की अनुमति दें",
'group_acnd'            =>  "इस सेटिंग को सक्षम करने पर उपयोगकर्ता साइट पर प्रकाशित पोस्टों के बारे में शिकायतें भेज सकेंगे",
'group_acc'             =>  "टिप्पणियों पर शिकायतें भेजने की अनुमति दें",
'group_accd'            =>  "इस सेटिंग को सक्षम करने से, उपयोगकर्ता साइट पर प्रकाशित टिप्पणियों के बारे में शिकायतें भेज सकेंगे",
'group_aco'             =>  "स्पेलिंग की गलतियों के बारे में शिकायतें भेजने की अनुमति दें",
'group_acod'            =>  "इस सेटिंग को सक्षम करने से, उपयोगकर्ता साइट पर स्पेलिंग की गलतियों के बारे में शिकायतें भेज सकेंगे",
