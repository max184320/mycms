'cat_resname'			=>	"श्रेणी के लिए दर्ज किया गया SEF नाम अमान्य है और अन्य आवश्यकताओं के लिए आरक्षित है।",
'opt_sys_spbs'			=>	"&#39;Speedbar&#39; मॉड्यूल के लिए विभाजक प्रतीक",
'opt_sys_spbsd'			=>	"आप एक विभाजक प्रतीक निर्दिष्ट कर सकते हैं जिसका उपयोग &#39;Speedbar&#39; मॉड्यूल में साइट पर विज़िटर के स्थान को परिभाषित करने वाले अनुभागों को अलग करने के लिए किया जाएगा। उदाहरण के लिए, &ampraquo; प्रतीक निर्दिष्ट करते समय, इस मॉड्यूल में लगभग निम्नलिखित आउटपुट का उपयोग किया जाएगा: होम &raquo; साइट अनुभाग &raquo; समाचार",
'opt_sys_cls'			=>	"समाचार को सौंपी गई श्रेणियों की सूची के लिए विभाजक प्रतीक",
'opt_sys_clsd'			=>	"आप एक विभाजक प्रतीक निर्दिष्ट कर सकते हैं जिसका उपयोग समाचार को सौंपी गई श्रेणियों की सूची में श्रेणियों को अलग करने के लिए किया जाएगा जब उन्हें साइट पर दिखाया जाएगा। उदाहरण के लिए, &ampraquo; प्रतीक निर्दिष्ट करते समय, साइट पर समाचार को सौंपी गई श्रेणियों की सूची दिखाते समय, लगभग निम्नलिखित आउटपुट का उपयोग किया जाएगा: श्रेणी &raquo; उपश्रेणी",
'opt_sys_mdl'			=>	"एडमिन पैनल में क्रिया लॉग को कितने दिनों तक संग्रहीत करना है",
'opt_sys_mdld'			=>	"उन दिनों की संख्या निर्दिष्ट करें जिनके लिए स्क्रिप्ट कंट्रोल पैनल में उपयोगकर्ता क्रियाओं के लॉग संग्रहीत किए जाएंगे। इस मामले में, न्यूनतम दिनों की संख्या 30 दिन है। आप अधिक दिन सेट कर सकते हैं, लेकिन आप कम सेट नहीं कर सकते।",
'opt_sys_mi'			=>	"अपलोड की गई छवि की मध्यम प्रति का आकार",
'opt_sys_mid'			=>	"इस सेटिंग का उपयोग करने की दो संभावनाएं हैं:<br /><br /><b>पहली:</b> आप अपलोड की गई छवि के किसी भी पक्ष का अधिकतम आकार पिक्सेल में सेट करते हैं, जिसे पार करने पर छवि की एक मध्यम प्रति बनाई जाएगी। उदाहरण के लिए: <b>400</b><br /><br /><b>दूसरी:</b> आप चौड़ाई x ऊँचाई प्रारूप में मध्यम छवि प्रति की चौड़ाई और ऊँचाई सेट करते हैं। उदाहरण के लिए: <b>100x100</b>.<br /><br />यदि आप सर्वर पर अपलोड की गई छवियों की मध्यम प्रति नहीं बनाना चाहते हैं तो आप 0 निर्दिष्ट कर सकते हैं।",
'images_amh'			=>	"आकार के साथ मध्यम प्रति बनाएँ:",
'upload_m_size'			=>	"छवि की मध्यम प्रति का आकार:",
'media_upload_ip6'		=>	"मध्यम प्रति",
'media_upload_ip7'		=>	"क्लिक करने पर बड़ा करें?",
'media_upload_ip8'		=>	"हाँ",
'media_upload_ip9'		=>	"नहीं",
'opt_social'			=>	"सोशल नेटवर्क सेटिंग",
'opt_socialc'			=>	"इस अनुभाग में आप सोशल नेटवर्क का उपयोग करके साइट पर उपयोगकर्ता प्रमाणीकरण कॉन्फ़िगर कर सकते हैं",
'opt_socialc1'			=>	"सोशल नेटवर्क का उपयोग करके उपयोगकर्ता प्रमाणीकरण की सेटिंग",
'hint_social'			=>	"यह अनुभाग सोशल नेटवर्क का उपयोग करके आपके साइट विज़िटर्स के लिए प्रमाणीकरण की संभावना को कॉन्फ़िगर करता है। इस प्रकार के प्रमाणीकरण के पूर्ण संचालन के लिए, आपको सोशल नेटवर्क में प्रमाणीकरण के लिए अपना स्वयं का एप्लिकेशन बनाना होगा, इस मॉड्यूल में प्रमाणीकरण समर्थन सक्षम करना होगा, और सोशल नेटवर्क में अपने एप्लिकेशन की आवश्यक कुंजियाँ सेट करनी होंगी।",
'hint_social3'			=>	"चेतावनी: स्क्रिप्ट सेटिंग्स में यह सुविधा अक्षम कर दी गई है। सोशल नेटवर्क में प्रमाणीकरण का समर्थन करने के लिए, आपको स्क्रिप्ट सेटिंग्स में जाना होगा और उपयोगकर्ता सेटिंग्स में सोशल नेटवर्क के माध्यम से प्रमाणीकरण समर्थन सक्षम करना होगा।",
'opt_sys_soc'			=>	"सोशल नेटवर्क के माध्यम से साइट पर लॉगिन की अनुमति दें",
'opt_sys_socd'			=>	"यदि &#39;सक्षम&#39; है, तो उपयोगकर्ता सोशल नेटवर्क का उपयोग करके आपकी साइट पर लॉगिन कर पाएंगे और उन्हें आपकी साइट पर विशेष रूप से पंजीकरण करने की आवश्यकता नहीं होगी। आप &#39;<a href=\"?mod=social\">सोशल नेटवर्क सेटिंग</a>&#39; अनुभाग में सोशल नेटवर्क सेटिंग्स कर सकते हैं",
'sconf_vk'				=>	"Vkontakte नेटवर्क का उपयोग करके प्रमाणीकरण सक्षम करें",
'sconf_vkd'				=>	"आप Vkontakte नेटवर्क का उपयोग करके प्रमाणीकरण समर्थन सक्षम या अक्षम कर सकते हैं",
'sconf_vk1'				=>	"Vkontakte नेटवर्क में एप्लिकेशन ID",
