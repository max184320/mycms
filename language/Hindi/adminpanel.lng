'storage_enabled'		=>	 "सक्षम",
'storage_on'            =>	 "स्टोरेज सक्षम है",
'storage_off'           =>	 "स्टोरेज अक्षम है",
'storage_add'           =>   "नया स्टोरेज जोड़ें",
'storage_name_d'        =>   "अपने बाहरी स्टोरेज का नाम निर्दिष्ट करें। उदाहरण के लिए: &#39;मेरा FTP सर्वर&#39;",
'storage_error'         =>   "आपके द्वारा चुना गया स्टोरेज मौजूद नहीं है",
'storage_error_1'       =>   "स्टोरेज का नाम एक आवश्यक फ़ील्ड है",
'storage_setd'          =>   "डिफ़ॉल्ट के रूप में सेट करें",
'storage_type'          =>   "प्रकार:",
'mass_storage_err'		=>	 "आपने ऑपरेशन करने के लिए कोई स्टोरेज नहीं चुना है।",
'storage_del'			=>	 "क्या आप वाकई स्टोरेज को हटाना चाहते हैं:",
'storage_upload'		=>	 "स्टोरेज में अपलोड करें:",
'group_sdel'			=>	 "अपना खाता स्वयं हटाने की अनुमति",
'hint_sdel'             =>	 "यह विकल्प उपयोगकर्ता के लिए साइट से अपने खाते और डेटा को स्वयं हटाने की क्षमता को सक्षम या अक्षम करने की अनुमति देता है। आप कई विकल्पों में से चुन सकते हैं:<br><br>1. अपना खाता हटाने पर रोक लगाएं<br><br>2. स्वयं निर्णय लेने और खाता हटाने की अनुमति दें<br><br>3. प्रशासन को अपना खाता हटाने का अनुरोध भेजें।",
'opt_sys_r7'			=>	 "प्रतिबंधित",
'opt_sys_r8'			=>	 "स्वयं हटाने की अनुमति है",
'opt_sys_r9'			=>	 "प्रशासन को हटाने का अनुरोध भेजने की अनुमति है",
'err_selfdel_1'			=>	 "आपके उपयोगकर्ता समूह के लिए खाता स्वयं हटाने की अनुमति नहीं है। साइट प्रशासन से संपर्क करें",
'err_selfdel_2'			=>	 "प्रशासकों के लिए खाता स्वयं हटाने की अनुमति नहीं है। केवल अन्य प्रशासक ही आपका खाता हटा सकते हैं",
'err_selfdel_3'			=>	 "आप पहले ही प्रशासन को अपना खाता हटाने का अनुरोध भेज चुके हैं। निर्णय की प्रतीक्षा करें",
'selfdel_wait'          =>   "उपयोगकर्ता संपादन अनुभाग में ऐसे उपयोगकर्ता हैं जिन्होंने अपना खाता साइट से हटाने का अनुरोध किया है और आपकी कार्रवाई की प्रतीक्षा कर रहे हैं। <a href=\"?mod=editusers\">प्रबंधन पर जाएँ</a>",
'selfdel_wait_1'        =>   "वे उपयोगकर्ता जिन्होंने हटाने का अनुरोध भेजा है:",
'selfdel_wait_2'        =>   "साइट से खाता हटाने का अनुरोध करने वाले उपयोगकर्ताओं की सूची",
'selfdel_wait_3'        =>   "हटाने के अनुरोध को अस्वीकार करें",
'selfdel_wait_4'        =>   "खाता हटाने की सूचना",
'selfdel_wait_5'        =>   "साइट {name} पर आपका खाता {site} आपके अनुरोध पर साइट व्यवस्थापक द्वारा हटा दिया गया है।",
'selfdel_wait_6'        =>   "आपका खाता हटाने का अनुरोध व्यवस्थापक द्वारा अस्वीकार कर दिया गया था। निम्नलिखित कारण बताए गए थे:",
'selfdel_text'			=>	 "खाता हटाने से इनकार करने के कारणों के बारे में सूचना का टेक्स्ट दर्ज करें, जिसे उपयोगकर्ता को व्यक्तिगत संदेश के रूप में प्राप्त होगा:",
'opt_s_acc_1'           =>   "उपयोगकर्ता प्रबंधन",
'opt_sys_fsearchr'		=>   "त्वरित खोज के दौरान मिले लेखों की संख्या",
'opt_sys_fsearchrd'     =>   "मिले पोस्ट की अधिकतम संख्या दर्ज करें जो त्वरित खोज परिणामों में प्रदर्शित की जाएगी",
