'search_nousers'        =>  "आपके द्वारा चुने गए मानदंडों के आधार पर कोई उपयोगकर्ता नहीं मिला",
'opt_sys_mpml'          =>  "प्रति पेज व्यक्तिगत संदेशों की संख्या",
