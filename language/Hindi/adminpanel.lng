// 10.6
'opt_sys_preload'		=>  "वीडियो मेटाडेटा का प्रीलोडिंग",
'opt_sys_preloadd'		=>  "यदि यह सेटिंग सक्षम है, तो वीडियो के लिए मेटाडेटा का प्रीलोडिंग किया जाएगा, जैसे प्रीव्यू के लिए स्टॉप फ्रेम, वीडियो की अवधि, आदि। यह सेटिंग ट्रैफ़िक की खपत करती है, भले ही उपयोगकर्ता वीडियो देखना शुरू न करे।",
'opt_sys_findr'			=>  "खोज परिणामों में पृष्ठों की संख्या",
'opt_sys_findrd'		=>  "खोज परिणामों में प्रदर्शित होने वाले पृष्ठों की अधिकतम संख्या निर्दिष्ट करें। सीमा हटाने के लिए, आप 0 निर्दिष्ट कर सकते हैं, उस स्थिति में सभी परिणाम दिखाए जाएंगे। प्रदर्शित पृष्ठों की संख्या को सीमित करने से आपके सर्वर पर लोड कम हो सकता है।",
// 10.6

// 10.5
'opt_sys_trc'			=>  "ट्री-स्टाइल टिप्पणियों का उपयोग",
'opt_sys_trcd'			=>  "आप ट्री-स्टाइल (नेस्टेड) टिप्पणियों के उपयोग की अनुमति दे सकते हैं या प्रतिबंधित कर सकते हैं। सक्षम होने पर, उपयोगकर्ता टिप्पणियों का उत्तर दे पाएंगे और वे ट्री के रूप में प्रदर्शित होंगे। अक्षम होने पर, टिप्पणियाँ चुनी गई सॉर्टिंग ऑर्डर के अनुसार सामान्य रूप से दिखाई देंगी।",
'opt_sys_trcl'			=>  "नेस्टेड टिप्पणियों की अधिकतम गहराई",
'opt_sys_trcld'			=>  "टिप्पणी नेस्टिंग का अधिकतम स्तर निर्दिष्ट करें। इस गहराई तक पहुँचने पर, साइट पर टिप्पणियों की नेस्टिंग केवल निर्दिष्ट स्तर तक ही दिखाई देगी।",
'opt_sys_trcf'			=>  "टिप्पणी उत्तर फ़ॉर्म का प्रदर्शन",
'opt_sys_trcfd'			=>  "निर्दिष्ट करें कि टिप्पणी उत्तर फ़ॉर्म कैसे प्रदर्शित किया जाना चाहिए। आप पॉप-अप विंडो में, या संपादक के साथ या बिना टिप्पणी के नीचे प्रदर्शन चुन सकते हैं।",
'editor_none'			=>	"बिना संपादक के",
'bb_t_sub'				=>	"सबस्क्रिप्ट टेक्स्ट",
'bb_t_sup'				=>	"सुपरस्क्रिप्ट टेक्स्ट",
'bb_t_j'				=>	"दोनों तरफ संरेखित (जस्टिफाई)",
'bb_t_header'			=>	"टेक्स्ट हेडिंग",
'bb_header'				=>	"हेडिंग",
'clear_poll'			=>	"मतदान परिणाम साफ़ करें",
'clear_poll_1'			=>	"क्या आप वाकई इस समाचार के मतदान परिणाम साफ़ करना चाहते हैं?",
'clear_poll_2'			=>	"इस मतदान के परिणाम साफ़ कर दिए गए हैं",
'group_edit_days'		=>	"समाचार संपादित करने की अनुमत दिनों की संख्या",
'hint_edit_days'		=>	"यदि इस उपयोगकर्ता समूह के लिए समाचार संपादन की अनुमति है, तो आप समाचार प्रकाशन के कितने दिनों बाद तक उसे संपादित किया जा सकता है, इसकी सीमा निर्दिष्ट कर सकते हैं। इस समय सीमा के बाद, इस समूह का उपयोगकर्ता उन समाचारों को संपादित नहीं कर पाएगा। इस सीमा को अक्षम करने के लिए 0 दर्ज करें।",
'group_fpmspam'			=>	"व्यक्तिगत संदेश लिखते समय स्वचालित स्पैम सुरक्षा सक्षम करें",
'hint_fpmspam'			=>	"यह विकल्प साइट पर व्यक्तिगत संदेश लिखते समय इस समूह के लिए स्वचालित स्पैम सुरक्षा सक्षम करने की अनुमति देता है। सुरक्षा क्लाउड संसाधन http://www.stopforumspam.com/. के उपयोग के माध्यम से की जाती है। यह संसाधन दुनिया भर के बड़ी संख्या में स्पैमर्स के बारे में जानकारी संग्रहीत और प्रदान करता है, जो इस जानकारी के आधार पर साइट पर स्पैम को रोकने की अनुमति देता है।",
'opt_sys_msec'			=>  "SMTP सर्वर के माध्यम से ईमेल भेजने के लिए सुरक्षित प्रोटोकॉल का उपयोग करें",
'opt_sys_msecd'			=>  "SMTP सर्वर का उपयोग करके ईमेल भेजते समय एन्क्रिप्शन प्रोटोकॉल चुनें",
