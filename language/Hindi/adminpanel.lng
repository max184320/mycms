// 13.0
'upgr_dbtitle'			=>	"डेटाबेस रूपांतरण",
'upgr_dbtitle_1'		=>	"डेटाबेस को utf-8 एन्कोडिंग में परिवर्तित करना",
'upgr_dbinfo'			=>	"जारी रखने के लिए आपके डेटाबेस और टेम्प्लेट को utf-8 एन्कोडिंग में परिवर्तित किया जाना चाहिए। DataLife Engine स्वचालित रूप से आपके डेटाबेस और टेम्प्लेट को इस एन्कोडिंग में परिवर्तित करने का प्रयास करेगा, हालांकि बहुत बड़े डेटाबेस पर इसके लिए सर्वर सीमाओं की कमी हो सकती है। इसलिए जारी रखने से पहले, आपको डेटाबेस और टेम्प्लेट का बैकअप लेना चाहिए, ताकि समस्या होने पर आप मैन्युअल रूप से अपना डेटाबेस और टेम्प्लेट रूपांतरित कर सकें।",
'upgr_file'				=>	"नाम",
'upgr_file_1'			=>	"लिखने की अनुमति नहीं है",
'upgr_file_2'			=>	"लिखने की अनुमति की कमी पाई गई। जारी रखने के लिए आपको फ़ोल्डरों पर <b>CHMOD 777</b> और फ़ाइलों पर <b>CHMOD 666</b> सेट करना होगा:",
'upgr_minsql'			=>	"आपके सर्वर पर MySQL संस्करण <b>{version}</b> स्थापित है, डेटाबेस रूपांतरण के लिए MySQL संस्करण कम से कम 5.5.3 होना चाहिए",
'upgr_btn_1'			=>	"फिर से जाँचें",
'upgr_btn_2'			=>	"रूपांतरण शुरू करें",
'upgr_c_err'			=>	"जारी रखने के लिए आपको निर्दिष्ट समस्याओं को ठीक करना होगा।",
'upgr_noclose'			=>	"ध्यान दें, साइट डेटा का रूपांतरण चल रहा है, इस विंडो को तब तक बंद न करें जब तक कि प्रक्रिया पूरी तरह से समाप्त न हो जाए",
'upgr_next'				=>	"जारी रखें",
'upgr_all_conv'			=>	"डेटाबेस रूपांतरण की आवश्यकता नहीं है। सभी तालिकाएं वर्तमान एन्कोडिंग में हैं।",
'upgr_table_conv'		=>	"तालिका रूपांतरण:",
'upgr_templ_conv'		=>	"टेम्प्लेट रूपांतरण ...",
'upgr_sett_conv'		=>	"सेटिंग्स रूपांतरण ...",
'upgr_error'			=>	"<span class=\"text-danger\">ऑपरेशन निष्पादित करने में त्रुटि</span>",
'upgr_utf8'				=>	"<b>ध्यान दें:</b><br>आपके डेटाबेस की एन्कोडिंग सामान्य utf-8 है। इस एन्कोडिंग के सभी वर्णों के पूर्ण समर्थन के लिए, चार बाइट एन्कोडिंग utf8mb4 का उपयोग करना आवश्यक है। utf8mb4 एन्कोडिंग का उपयोग करके आप, उदाहरण के लिए, अपनी साइट के लिए Emoji और कई अन्य वर्णों का समर्थन जोड़ सकते हैं। आप लिंक पर जाकर अपना डेटाबेस रूपांतरित कर सकते हैं: <a href=\"?mod=upgrade&action=dbconvert&subaction=onlymb4\" >डेटाबेस रूपांतरण</a>",
'upgr_demo'				=>	"<b>ध्यान दें:</b><br>आपके सर्वर पर क्लोज्ड सोर्स डेमो संस्करण की फ़ाइलें हैं। हालांकि, आपने लाइसेंस खरीदा और सक्रिय किया है, इसलिए आप सर्वर पर फ़ाइलों को ओपन सोर्स सशुल्क वितरण फ़ाइलों में अपडेट कर सकते हैं, उदाहरण के लिए, साइट पर प्लगइन सिस्टम का उपयोग करने के लिए। आप लिंक पर जाकर अपनी फ़ाइलें अपडेट कर सकते हैं: <a href=\"?mod=upgrade\" >DataLife Engine फ़ाइलों का अपडेट</a>",
'upgr_demo_1'			=>	"आप DataLife Engine स्क्रिप्ट के डेमो संस्करण का उपयोग कर रहे हैं। डेमो संस्करण में स्क्रिप्ट का सोर्स कोड बंद है, इसलिए दुर्भाग्य से प्लगइन सिस्टम आपके लिए उपलब्ध नहीं है, क्योंकि इसके काम करने के लिए ओपन सोर्स कोड की आवश्यकता होती है। आपको लाइसेंस खरीदना होगा, और स्क्रिप्ट फ़ाइलों को ओपन सोर्स सशुल्क वितरण फ़ाइलों में अपडेट करना होगा।",
'upgr_notadm'			=>	"स्क्रिप्ट को जारी रखने के लिए, इसे अपडेट करना आवश्यक है। स्क्रिप्ट एडमिन पैनल में साइट प्रशासक के रूप में लॉगिन करें",
'upgr_dbtitle_2'		=>	"DataLife Engine अपडेट विज़ार्ड",
'upgr_dbtitle_3'		=>	"स्क्रिप्ट को वर्तमान संस्करण में अपडेट करना",
'upgr_info'				=>	"अब आपके डेटाबेस का वर्तमान स्क्रिप्ट संस्करण में अपडेट किया जाएगा। आपका डेटाबेस चरण-दर-चरण संस्करण <b>{oldversion}</b> से <b>{newversion}</b> में अपडेट किया जाएगा।",
'upgr_all_upg'			=>	"स्क्रिप्ट अपडेट की आवश्यकता नहीं है। आप स्क्रिप्ट के वर्तमान संस्करण का उपयोग कर रहे हैं।",
'upgr_act_info'			=>	"DataLife Engine के स्वचालित अपडेट सिस्टम में आपका स्वागत है। अपडेट जारी रखने से पहले, सर्वर पर अपनी फ़ाइलों और डेटाबेस का बैकअप अवश्य लें, अन्यथा समस्या होने पर आपका डेटा पुनर्प्राप्त करना असंभव होगा।<br><br>स्क्रिप्ट अपडेट जारी रखने के लिए अपनी लाइसेंस कुंजी दर्ज करना आवश्यक है। स्क्रिप्ट के स्वचालित अपडेट के लिए, आपके सर्वर और साइट https://dle-news.com/ के बीच इंटरनेट कनेक्शन होना आवश्यक है।",
'upgr_noclose_2'		=>	"साइट अपडेट के दौरान, इस विंडो को तब तक बंद न करें जब तक कि प्रक्रिया पूरी तरह से समाप्त न हो जाए",
'upgr_no_upg_files'		=>	"संस्करण <b>{version}</b> से अपडेट दुर्भाग्य से संभव नहीं है। आवश्यक अपडेट फ़ाइलें मौजूद नहीं हैं।",
'upgr_db_ver'			=>	"स्क्रिप्ट अपडेट संस्करण तक:",
'upgr_db_success'		=>	"संस्करण <b>{version}</b> तक स्क्रिप्ट का अपडेट पूरा हो गया है। साइट पर प्रकाशित परिवर्तनों की सूची के अनुसार अपने टेम्प्लेट में परिवर्तन करें: <a href=\"https://dle-news.com/templates-changelog.html\" target=\"_blank\">https://dle-news.com/templates-changelog.html</a>",
'upgr_db_errors'		=>	"स्क्रिप्ट अपडेट के दौरान निम्नलिखित त्रुटियां आईं:",
'upgr_db_query'			=>	"क्वेरी:",
'upgr_db_errt'			=>	"त्रुटि:",
'upgr_f_error_1'		=>	"DataLife Engine अपडेट सर्वर से कनेक्शन स्थापित नहीं हो सका। कृपया कुछ समय बाद पुनः प्रयास करें। यह भी संभव है कि आपके सर्वर पर बाहरी साइटों से कनेक्शन प्रतिबंधित हो, इस स्थिति में आपको DataLife Engine को मैन्युअल रूप से अपडेट करना होगा।",
'upgr_f_error_2'		=>	"गलत लाइसेंस कुंजी दर्ज की गई",
'upgr_f_error_3'		=>	"आपके लाइसेंस की अवधि समाप्त हो गई है। अपनी साइट पर स्क्रिप्ट अपडेट करने के लिए, आपको dle-news.com साइट पर अपनी प्रोफ़ाइल में अपना लाइसेंस नवीनीकृत करना होगा",
'upgr_f_error_4'		=>	"आपकी कुंजी दूसरे डोमेन के लिए पंजीकृत है। आप इस कुंजी का उपयोग करके इस डोमेन पर स्क्रिप्ट अपडेट नहीं कर सकते",
'upgr_f_error_5'		=>	"दर्ज की गई लाइसेंस कुंजी का प्रारूप गलत है",
'upgr_f_error_6'		=>	"आप पहले से ही वर्तमान संस्करण का उपयोग कर रहे हैं। अपडेट की आवश्यकता नहीं है।",
'upgr_f_error_7'		=>	"आपने अभी तक सर्वर पर अपडेट वितरण फ़ाइलें अपलोड नहीं की हैं। FTP द्वारा फ़ाइलें अपलोड करें और इस पृष्ठ को रिफ्रेश करें",
'upgr_f_error_8'		=>	"सर्वर पर DataLife Engine अपडेट वितरण लोड करने में विफल",
'upgr_f_error_9'		=>	"अपलोड किए गए वितरण का चेकसम आवश्यक चेकसम से मेल नहीं खाता। संभवतः डाउनलोड के दौरान आर्काइव क्षतिग्रस्त हो गया था",
'upgr_f_error_10'		=>	"ssh2_connect फ़ंक्शन का समर्थन अनुपलब्ध है। आपको PHP के लिए SSH2 एक्सटेंशन स्थापित करना होगा",
'upgr_f_error_11'		=>	"सर्वर से कनेक्ट करने में असमर्थ:",
'upgr_f_error_12'		=>	"FTP सर्वर के लिए आपके द्वारा निर्दिष्ट लॉगिन या पासवर्ड सही नहीं हैं। इन क्रेडेंशियल्स के साथ सर्वर पर लॉगिन करना असंभव है।",
'upgr_f_error_13'		=>	"SFTP सबसिस्टम को इनिशियलाइज़ करना असंभव है।",
'upgr_f_error_14'		=>	"FTP सर्वर पर गैर-मौजूद पथ निर्दिष्ट किया गया है:",
'upgr_f_error_15'		=>	"निर्दिष्ट पथ पर DataLife Engine नहीं मिला",
'upgr_f_error_16'		=>	"आर्काइव क्षतिग्रस्त या गलत है",
'upgr_f_error_17'		=>	"डायरेक्टरी बनाने में विफल",
'upgr_f_error_18'		=>	"सर्वर पर फ़ाइल कॉपी करने में विफल",
'upgr_f_error_19'		=>	"आपके सर्वर पर &#39;ZipArchive&#39; का समर्थन अनुपलब्ध है। इसलिए आपके लिए केवल मैन्युअल डाउनलोड और फ़ाइल अपडेट उपलब्ध है। फ़ाइलों के स्वचालित इंस्टॉलेशन के लिए, आपको PHP इंटरप्रेटर के लिए ZIP एक्सटेंशन इंस्टॉल करने के लिए अपनी होस्टिंग सहायता टीम से संपर्क करना होगा",
'upgr_ftp_1'			=>	"DataLife Engine के पास अपनी फ़ाइलों को ओवरराइट करने की अनुमति नहीं है। इसलिए आप नए संस्करण की फ़ाइलों को लिखने के लिए FTP एक्सेस निर्दिष्ट कर सकते हैं। आपका FTP एक्सेस सर्वर पर सहेजा नहीं जाएगा। और अपडेट विज़ार्ड द्वारा इस एक्सेस का उपयोग समाप्त होने पर, इसे स्वचालित रूप से हटा दिया जाएगा।",
'upgr_ftp_2'			=>	"कनेक्शन प्रकार:",
'upgr_ftp_3'			=>	"सर्वर पता:",
'upgr_ftp_4'			=>	"पोर्ट:",
'upgr_ftp_5'			=>	"लॉगिन:",
'upgr_ftp_6'			=>	"पासवर्ड:",
'upgr_ftp_7'			=>	"स्क्रिप्ट का पथ:",
'upgr_ftp_8'			=>	"फ़ाइलों को मैन्युअल रूप से कॉपी करें",
'upgr_ftp_9'			=>	"सर्वर पर DataLife Engine फ़ाइलों की मैन्युअल कॉपी करना:",
'upgr_ftp_10'			=>	"<li>लिंक से अपडेट डिस्ट्रीब्यूशन डाउनलोड करें: {link}</li><li>आर्काइव को अनपैक करें और इसकी सामग्री को अपने सर्वर पर उस फोल्डर में कॉपी करें जहाँ DataLife Engine इंस्टॉल है</li><li>सभी फ़ाइलें कॉपी हो जाने के बाद &#39;आगे&#39; पर क्लिक करें</li>",
'upgr_ftp_11'			=>	"डिस्ट्रीब्यूशन डाउनलोड करें",
'upgr_ftp_12'			=>	"सर्वर पर डिस्ट्रीब्यूशन अनपैक करना",
'upgr_ftp_13'			=>	"ध्यान दें, सर्वर पर नए वर्ज़न की फ़ाइलें इंस्टॉल की जा रही हैं, प्रक्रिया पूरी होने तक इस विंडो को बंद न करें",
'upgr_ftp_14'			=>	"प्रोसेस्ड फ़ाइलें:",
'upgr_ftp_15'			=>	"DataLife Engine के पास कुछ फोल्डरों के लिए एक्सेस परमिशन नहीं है। इसलिए आप उनमें फ़ाइलें लिखने के लिए FTP एक्सेस सेट कर सकते हैं। आपका FTP एक्सेस सर्वर पर सेव नहीं किया जाएगा। और इस एक्सेस का उपयोग समाप्त होने के बाद, इसे स्वचालित रूप से हटा दिया जाएगा।",
'opt_plugins'			=>	"प्लगइन प्रबंधन",
'opt_pluginsc'			=>	"DataLife Engine के लिए प्लगइन्स की सेटिंग और प्रबंधन। इस सेक्शन में आप प्लगइन्स इंस्टॉल या एडिट कर सकते हैं",
'plugins_uploads'		=>	"प्लगइन अपलोड करें",
'plugins_not_found'		=>  "आपने अभी तक अपनी साइट पर कोई प्लगइन नहीं जोड़ा है",
'plugins_b_add'			=>  "प्लगइन जोड़ें",
'plugins_on'			=>	"प्लगइन सक्षम करें",
'plugins_off'			=>	"प्लगइन अक्षम करें",
'plugins_on_1'			=>	"प्लगइन सक्षम है और काम कर रहा है",
'plugins_off_1'			=>	"प्लगइन अक्षम है",
'plugins_download'		=>	"प्लगइन डाउनलोड करें",
'plugins_update'		=>	"प्लगइन का नया वर्ज़न अपलोड करें",
'plugins_del'			=>	"क्या आप वाकई चुने गए प्लगइन को हटाना चाहते हैं? इस क्रिया को रद्द नहीं किया जा सकेगा।",
'plugins_bread'			=>	"नया प्लगइन जोड़ना",
'plugins_bread_1'		=>	"प्लगइन एडिट करना",
'plugins_bread_2'		=>	"त्रुटियों की सूची",
'plugins_tab_1'			=>	"सामान्य जानकारी",
'plugins_tab_2'			=>	"फ़ाइलों में क्रियाएं",
'plugins_tab_3'			=>	"MySQL में क्रियाएं",
'plugins_list'			=>	"प्लगइन सूची",
'plugins_name'			=>	"प्लगइन का नाम:",
'plugins_name_h'		=>	"प्लगइन का नाम भरना अनिवार्य है और इसमें अधिकतम 100 वर्ण हो सकते हैं",
'plugins_descr'			=>	"प्लगइन का संक्षिप्त विवरण:",
'plugins_ver'			=>	"प्लगइन वर्ज़न:",
'plugins_dlever'		=>	"DLE वर्ज़न:",
'plugins_dleverh'		=>	"इस प्लगइन के काम करने के लिए आवश्यक न्यूनतम DLE वर्ज़न। यदि आप इस प्लगइन पर कोई प्रतिबंध नहीं लगाना चाहते हैं, तो इस फ़ील्ड को खाली छोड़ दें",
'plugins_icon_h'		=>	"अपनी साइट के रूट से प्लगइन आइकन का पूरा पथ दर्ज करें। उदाहरण के लिए engine/skins/images/my_icon.png",
'plugins_vc_1'			=>	"केवल",
