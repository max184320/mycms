'page_header_3'			=>	"टेक्स्ट जिसे साइट के पृष्ठों पर प्रदर्शित किया जा सकता है, HTML की अनुमति है",
'find_rpolls'			=>	"सर्वेक्षण और मतदान",
'news_mdel'				=>	"नियमन की प्रतीक्षा कर रहे आइटम हटाएं",
'news_mdelconfirm'		=>	"क्या आप वाकई इस उपयोगकर्ता के लिए नियमन की प्रतीक्षा कर रहे सभी समाचारों को हटाना चाहते हैं?",
'comm_mcdelconfirm'		=>	"क्या आप वाकई इस उपयोगकर्ता के लिए नियमन की प्रतीक्षा कर रहे सभी टिप्पणियों को हटाना चाहते हैं?",
'links_area_8'			=>	"केवल स्थिर पृष्ठों में",
'links_area_9'			=>	"स्थिर पृष्ठों, समाचारों और टिप्पणियों में",
'opt_sys_dfc'			=>	"फ़्रेम में साइट एम्बेडिंग को ब्लॉक करना सक्षम करें",
'opt_sys_dfcd'			=>	"इस सेटिंग को सक्षम करने पर, यदि आपकी साइट किसी अन्य साइट पर iframe में एम्बेड की गई है, तो स्क्रिप्ट स्वचालित रूप से आपकी साइट के प्रदर्शन को ब्लॉक कर देगी। इससे आप क्लिकजैकिंग जैसे हमलों को रोक सकते हैं।",
'xfield_xhtmljs'		=>	"शुद्ध HTML या JS कोड",
'xfield_xhtmljs_1'		=>	"इस प्रकार के अतिरिक्त फ़ील्ड का उपयोग करते समय, आप प्रकाशनों में कोई भी शुद्ध HTML या JS कोड जोड़ सकते हैं। यह कोड बिना किसी फ़िल्टरिंग या परिवर्तन के साइट पर प्रदर्शित किया जाएगा। सावधान रहें, यह फ़ील्ड किसी भी कोड को जोड़ने की अनुमति देती है, इसलिए निर्दिष्ट करें कि किन उपयोगकर्ता समूहों को इस फ़ील्ड को जोड़ने की अनुमति है। यह अनुशंसा की जाती है कि ये अधिकार केवल &#39;Administrators&#39; समूह को दिए जाएं।",
'xfield_xhtmljs_2'		=>	"सुरक्षा कारणों से इस फ़ील्ड का पूर्वावलोकन उपलब्ध नहीं है",
'xfield_separator'		=>	"क्रॉस-संदर्भ लिंक सूची के लिए विभाजक",
'xfield_separator_1'	=>	"यदि फ़ील्ड मानों का उपयोग क्रॉस-संदर्भ लिंक के रूप में किया जाता है, तो आप एक विभाजक निर्दिष्ट कर सकते हैं जिसका उपयोग प्रकाशनों को प्रदर्शित करते समय लिंक के बीच सूची में शब्दों के बीच किया जाएगा। HTML कोड के उपयोग की भी अनुमति है। यदि आप इस सेटिंग को खाली छोड़ देते हैं, तो अल्पविराम का उपयोग किया जाएगा।",
