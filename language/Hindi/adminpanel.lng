'redirects_err_4'		=>	"आपने उन पर संचालन करने के लिए लिंक नहीं चुने हैं।",
'redirects_del'			=>	"क्या आप वाकई लिंक हटाना चाहते हैं",
'redirects_del_1'		=>	"रीडायरेक्ट की सूची से?",
'opt_sys_redirects'		=>	"मॉड्यूल &#39;रीडायरेक्ट&#39; का समर्थन सक्षम करें",
'opt_sys_redirectsd'	=>	"इस मॉड्यूल को अक्षम करने से डेटाबेस प्रश्नों की बचत होती है और पृष्ठ निर्माण का समय कम हो जाता है। यदि आप एडमिन पैनल के संबंधित अनुभाग में व्यक्तिगत रीडायरेक्ट का उपयोग नहीं करते हैं, तो उन्हें अक्षम कर दें।",
'opt_sys_biw'			=>	"विजुअल एडिटर्स के लिए छवियों के लिए BB टैग का उपयोग करें",
'opt_sys_biwd'			=>	"यदि यह सेटिंग सक्षम है और विजुअल WYSIWYG एडिटर्स का उपयोग किया जाता है, तो छवियों को BB टैग के रूप में सम्मिलित किया जाएगा। यह टेक्स्ट के साथ अधिक सुविधाजनक काम के लिए संपादन योग्य क्षेत्र में जगह बचाएगा। इस सेटिंग को अक्षम करने पर एडिटर्स में पूर्ण विजुअल चित्र सम्मिलित किए जाएंगे।",
