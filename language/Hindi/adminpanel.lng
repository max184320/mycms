// 11.0
'xfield_ximage'			=>	"अपलोड करने योग्य इमेज",
'xfield_xfile'			=>	"अपलोड करने योग्य फ़ाइल",
'xfield_xyesorno'		=>	"स्विच &#39;हाँ&#39; या &#39;नहीं&#39;",
'xfield_xi1'			=>	"मूल इमेज का अधिकतम आकार",
'xfield_xi2'			=>	"आप सर्वर पर अपलोड की जाने वाली इमेज की अधिकतम चौड़ाई और ऊंचाई निर्धारित कर सकते हैं, इमेज का आकार कम कर दिया जाएगा। आप केवल एक पक्ष का आकार सेट कर सकते हैं, जैसे: 800, या दोनों पक्षों का आकार, जैसे: 800x600। यदि आप कोई सीमा निर्धारित नहीं करना चाहते हैं, तो फ़ील्ड को खाली छोड़ दें।",
'xfield_xi3'			=>	"इमेज का अधिकतम फ़ाइल आकार",
'xfield_xi4'			=>	"किलोबाइट में अपलोड की जाने वाली इमेज का अधिकतम अनुमेय आकार दर्ज करें। यदि आप सीमा नहीं लगाना चाहते हैं, तो आप इस फ़ील्ड को खाली छोड़ सकते हैं",
'xfield_xi5'			=>	"वॉटरमार्क लागू करें",
'xfield_xi6'			=>	"थंबनेल बनाएँ",
'xfield_xi7'			=>	"थंबनेल का आकार",
'xfield_xi8'			=>	"आप केवल एक पक्ष का आकार सेट कर सकते हैं, जैसे: 200, या दोनों पक्षों का आकार, जैसे: 150x100।",
'xfield_xf1'			=>	"अपलोड के लिए अनुमत फ़ाइल एक्सटेंशन",
'xfield_xf2'			=>	"इस फ़ील्ड के लिए अपलोड के लिए अनुमत फ़ाइल एक्सटेंशन निर्दिष्ट करें। एक्सटेंशन अल्पविराम द्वारा अलग किए गए हैं, बिना बिंदु के, जैसे zip,doc,rar",
'xfield_xfim'			=>	"इमेज अपलोड करें",
'xfield_xfif'			=>	"फ़ाइल अपलोड करें",
'xfield_xfid'			=>	"हटाएँ",
'image_delete'			=>	"क्या आप वाकई इमेज हटाना चाहते हैं? इस क्रिया को पूर्ववत नहीं किया जा सकता।",
'file_delete'			=>	"क्या आप वाकई इस फ़ाइल को हटाना चाहते हैं? इस क्रिया को पूर्ववत नहीं किया जा सकता।",
'xfield_xyes'			=>	"हाँ",
'xfield_xno'			=>	"नहीं",
'opt_sys_pn'			=>	"उपयोगकर्ता प्रोफ़ाइल में मॉडरेशन की प्रतीक्षा कर रहे समाचार दिखाएँ",
'opt_sys_pnd'			=>	"यदि &#39;सक्षम&#39; है, तो साइट पर समाचार जोड़ने वाले उपयोगकर्ता, जिनके समाचार मॉडरेशन की प्रतीक्षा कर रहे हैं, अपनी प्रोफ़ाइल में उन्हें देख सकते हैं और संपादित कर सकते हैं। यदि आपकी साइट पर उपयोगकर्ताओं द्वारा समाचार जोड़ने की सुविधा नहीं है, तो आप इस सेटिंग को अक्षम कर सकते हैं ताकि प्रोफ़ाइल में मॉडरेशन की प्रतीक्षा कर रहे समाचारों की कमी का संदेश न दिखे।",
'search_field'			=>	"खोजें",
'tags_s_not_found'		=>	"निर्दिष्ट कीवर्ड नहीं मिला।",
'search_full_name'		=>	"सटीक मिलान खोज",
'links_target'			=>	"लिंक को नई विंडो में खोलें",
'links_area_6'			=>	"ब्राउज़र की नई विंडो में लिंक खोलें",
'links_area_7'			=>	"ब्राउज़र की वर्तमान विंडो में लिंक खोलें",
'group_nlim'			=>	"निश्चित संख्या में समाचार होने पर दूसरे समूह में स्थानांतरित करें",
'group_nlimd'			=>	"इस सेटिंग को सक्षम करते समय, आपको समाचारों की संख्या और वह समूह निर्दिष्ट करना होगा जिसमें उपयोगकर्ता को इतनी संख्या में प्रकाशन होने पर स्वचालित रूप से स्थानांतरित कर दिया जाएगा।",
'force_group'			=>	"समूह में स्थानांतरित करें:",
'force_group_news'		=>	"समाचारों की संख्या:",
'group_clim'			=>	"निश्चित संख्या में टिप्पणियाँ होने पर दूसरे समूह में स्थानांतरित करें",
'group_climd'			=>	"इस सेटिंग को सक्षम करते समय, आपको टिप्पणियों की संख्या और वह समूह निर्दिष्ट करना होगा जिसमें उपयोगकर्ता को इतनी संख्या में टिप्पणियाँ होने पर स्वचालित रूप से स्थानांतरित कर दिया जाएगा।",
'force_group_comm'		=>	"टिप्पणियों की संख्या:",
'group_ratelim'			=>	"निश्चित प्रकाशन रेटिंग होने पर दूसरे समूह में स्थानांतरित करें",
'group_ratelimd'		=>	"इस सेटिंग को सक्षम करते समय, आपको उपयोगकर्ता की कुल संचयी प्रकाशन रेटिंग और वह समूह निर्दिष्ट करना होगा जिसमें उपयोगकर्ता को यह रेटिंग प्राप्त होने पर स्वचालित रूप से स्थानांतरित कर दिया जाएगा।",
'force_group_rating'	=>	"कुल रेटिंग:",
'group_reglim'			=>	"पंजीकरण के निश्चित दिनों के बाद दूसरे समूह में स्थानांतरित करें",
'group_reglimd'			=>	"इस सेटिंग को सक्षम करते समय, आपको यह निर्दिष्ट करना होगा कि साइट पर पहली बार पंजीकरण के कितने दिनों बाद उपयोगकर्ता को स्वचालित रूप से स्थानांतरित किया जाएगा।",
'force_group_days'		=>	"दिनों की संख्या:",
'group_nct'				=>	"देखने के लिए प्रतिबंधित श्रेणियाँ",
'group_nctd'			=>	"यह सेटिंग ऊपर वाली सेटिंग के विपरीत है। आप उन श्रेणियों की सूची निर्दिष्ट कर सकते हैं जिनमें उपयोगकर्ताओं की पहुँच प्रतिबंधित है। वे इन श्रेणियों के समाचार और स्वयं श्रेणियों को नहीं देख पाएंगे। इस सेटिंग या ऊपर वाली सेटिंग का उपयोग करें, यह इस पर निर्भर करता है कि आपके लिए क्या निर्दिष्ट करना आसान है - प्रतिबंधित या अनुमत श्रेणियों की सूची।",
