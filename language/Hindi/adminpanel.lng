'opt_sys_fcd'			=>	"कैश बनाना और अपडेट करना भी एक संसाधन-गहन कार्य है। समय बीतने के साथ, प्रकाशन अपनी लोकप्रियता खो देता है, और यदि इसे अक्सर नहीं पढ़ा जाता है, तो इसके लिए लगातार कैश बनाना और नियंत्रित करना उचित नहीं है। आप समाचार प्रकाशन के बाद उन दिनों की संख्या निर्दिष्ट कर सकते हैं जिसके बाद इसके लिए कैश नहीं बनाया जाएगा। उदाहरण के लिए, यदि आप 30 निर्दिष्ट करते हैं, तो समाचार के लिए प्रकाशन के 30 दिनों के भीतर कैश बनाया और उपयोग किया जाएगा, और उसके बाद नहीं। इस अवधि को बढ़ाने से डिस्क स्थान का अतिरिक्त उपयोग होता है।",
'count_subscribe'		=>	"इस प्रकाशन की टिप्पणियों के लिए {count} उपयोगकर्ताओं ने सदस्यता ली है।",
'group_up_image'		=>	"टिप्पणियों में इमेज अपलोड करने की अनुमति दें",
'hint_group_up_image'	=>	"आप उपयोगकर्ताओं को सर्वर पर इमेज अपलोड करने और उन्हें टिप्पणियों में प्रकाशित करने की अनुमति दे सकते हैं या प्रतिबंधित कर सकते हैं।",
'group_up_count_image'	=>	"एक टिप्पणी के लिए अपलोड की जाने वाली इमेजेस की अधिकतम संख्या",
'hint_up_count_image'	=>	"यदि उपयोगकर्ता को टिप्पणियों के लिए सर्वर पर इमेज अपलोड करने की अनुमति है, तो आप प्रति टिप्पणी अधिकतम इमेजेस की सीमा निर्धारित कर सकते हैं। इस सीमा को हटाने के लिए फ़ील्ड को खाली छोड़ दें या 0 दर्ज करें।",
'hint_up_watermark'		=>	"निर्दिष्ट करें कि टिप्पणियों में अपलोड की गई इमेजेस पर वॉटरमार्क लगाना आवश्यक है या नहीं।",
'hint_up_thumb'			=>	"निर्दिष्ट करें कि टिप्पणियों में अपलोड की गई इमेजेस के लिए थंबनेल बनाना आवश्यक है या नहीं।",
