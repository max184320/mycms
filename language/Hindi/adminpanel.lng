'opt_sys_minsearch'		=>  "खोज के लिए न्यूनतम वर्णों की संख्या",
'opt_sys_minsearchd'	=>  "किसी शब्द में वर्णों की न्यूनतम संख्या निर्दिष्ट करें जिस पर खोज की जाएगी। बहुत छोटा मान खोज के दौरान सर्वर पर भार बढ़ाता है। कम से कम चार वर्ण रखने की अनुशंसा की जाती है।",
'main_p_notice'			=>	"नोट्स",
'main_p_notice_1'		=>	"प्लगइन्स की सूची वाले पेज पर नोट्स प्रदर्शित करें",
'main_no_p_notice'		=>	"यहाँ आप नोट्स, मेमो और निर्देश सहेज सकते हैं। HTML टैग्स का उपयोग करना स्वीकार्य है।",
'opt_sys_ddate'			=>	"कस्टम तारीख टैग का उपयोग करके आउटपुट करते समय तारीखों का शब्द-रूप बदलें (Decline)",
'opt_sys_ddated'		=>	"यदि यह सेटिंग सक्षम है और प्रकाशन तिथि {date=date format} टैग के माध्यम से दिखाई जाती है, तो माह का नाम भाषा फ़ाइलों के अनुसार सही व्याकरणिक रूप में प्रदर्शित होगा।",
'meta_robots'			=>	"Robots मेटाटैग:",
'opt_sys_minside'		=>	"अपलोड के लिए छवि का न्यूनतम आकार",
'opt_sys_minsided'		=>	"इस सेटिंग का उपयोग करने की दो संभावनाएं हैं:<br /><br /><b>पहली:</b> आप मूल छवि के किसी भी पक्ष के पिक्सेल में आकार दर्ज करते हैं। उदाहरण के लिए: <b>800</b>।<br /><br /><b>दूसरी:</b> आप चौड़ाई x ऊँचाई के प्रारूप में मूल छवि की चौड़ाई और ऊँचाई निर्धारित करते हैं। उदाहरण के लिए: <b>800x600</b><br /><br />यदि आकार कम होगा, तो छवि सर्वर पर अपलोड नहीं की जाएगी। और उपयोगकर्ता को जानकारी दिखाई जाएगी कि छवि बहुत छोटी है। यदि आप यह सीमा नहीं लगाना चाहते हैं तो आप 0 निर्दिष्ट कर सकते हैं और सभी छवियां अपलोड की जाएंगी।",
'upload_error_7'		=>	"अपलोड की गई छवि {minsize} पिक्सेल से कम नहीं हो सकती।",
'xfield_xi22'			=>	"आप सर्वर पर अपलोड की जाने वाली छवि के लिए न्यूनतम चौड़ाई और ऊँचाई के आकार निर्धारित कर सकते हैं। आप केवल एक पक्ष का आकार निर्धारित कर सकते हैं, उदाहरण के लिए: 800, या आप एक साथ दो पक्षों का आकार निर्धारित कर सकते हैं, उदाहरण के लिए: 800x600। यदि आप कोई सीमा निर्धारित नहीं करना चाहते हैं, तो फ़ील्ड को खाली छोड़ दें।",
// 13.3

// 13.2
'plugins_pinfo_1'		=>	"आप PHP कोड निर्दिष्ट कर सकते हैं जो एडमिन पैनल में प्लगइन के साथ कुछ कार्य करते समय निष्पादित किया जाएगा:",
'plugins_aсt_l12'		=>	"इस प्रविष्टि से बदलें:",
'plugins_rep_hint'		=>	"निर्दिष्ट करें कि यदि कोड फ़ाइल में कई बार आता है तो किस प्रविष्टि से प्रतिस्थापन शुरू करना है। उदाहरण के लिए, यदि कोई पंक्ति फ़ाइल में कई बार आती है और आपको दूसरी पंक्ति से बदलना शुरू करना है, तो आप 2 निर्दिष्ट कर सकते हैं। यदि सभी प्रविष्टियों को बदलना है, तो इस फ़ील्ड को खाली छोड़ दें।",
'plugins_needp'			=>	"प्लॅगिन की अनिवार्यता:",
'plugins_needp_h'		=>	"अतिरिक्त प्लगइन का नाम निर्दिष्ट करें जिसकी आवश्यकता इस प्लगइन के काम करने के लिए अनिवार्य है। यदि इस प्लगइन को अन्य प्लगइन्स की आवश्यकता नहीं है, तो इस फ़ील्ड को खाली छोड़ दें। आप अल्पविराम द्वारा अलग करके कई प्लगइन्स भी सूचीबद्ध कर सकते हैं।",
'plugins_nerror_3'		=>	"इस प्लगइन के लिए अतिरिक्त स्थापित प्लगइन की आवश्यकता है: «{plugin}»",
