// 13.3
'news_err_42'			=>	"इस URL नाम के साथ एक प्रकाशन पहले से ही साइट पर मौजूद है। &#39;अतिरिक्त&#39; टैब में लेख का URL बदलें।",
'plugins_errors_11'		=>	"<b>ध्यान दें!</b><br><br>आपकी साइट पर स्थापित कुछ प्लगइन्स के काम में त्रुटियां दर्ज की गई हैं। इससे आपकी पूरी साइट की अस्थिरता हो सकती है।",
'plugins_errors_12'		=>	"उत्पन्न त्रुटियों की सूची देखें",
'opt_sys_jqv'			=>	"आपकी साइट के लिए jQuery संस्करण:",
'opt_sys_jqvd'			=>	"jQuery संस्करण चुनें जो आपकी साइट पर उपयोग के लिए कनेक्ट किया जाएगा",
'allow_rss_news'		=>	"समाचार को RSS फीड में प्रकाशित करें",
