'group_h_links'		    =>	 "यह विकल्प उन उपयोगकर्ताओं को अनुमति देगा जिनके पास एडमिन पैनल तक पहुंच है, वे साइट के पेजों के लिए क्रॉस-लिंक्स प्रबंधित कर सकते हैं।",
'group_a_redirects'	    =>	 "रीडायरेक्ट प्रबंधित करने की अनुमति दें",
'group_h_redirects'	    =>	 "यह विकल्प उन उपयोगकर्ताओं को अनुमति देगा जिनके पास एडमिन पैनल तक पहुंच है, वे साइट के पेजों के लिए रीडायरेक्ट प्रबंधित कर सकते हैं।",
'group_a_st'		    =>	 "इमेज और फ़ाइलें अपलोड करते समय उपयोगकर्ताओं को स्टोरेज चुनने की अनुमति दें",
'group_h_st'		    =>	 "यह विकल्प उपयोगकर्ताओं को पोस्ट के लिए सर्वर पर इमेज और फ़ाइलें अपलोड करते समय उपलब्ध स्टोरेज में से चुनने की अनुमति देगा कि ये फ़ाइलें कहाँ अपलोड की जाएंगी।",
'xfield_etitle'		    =>	 "अतिरिक्त फ़ील्ड का संपादन",
'opt_storages'          =>	 "स्टोरेज",
'opt_storagesc'         =>   "अपलोड की गई इमेज, मल्टीमीडिया और अन्य फ़ाइलों के लिए विभिन्न स्टोरेज को कॉन्फ़िगर करना।",
'header_s_1'			=>	 "स्टोरेज प्रबंधन",
'header_s_2'            =>	 "स्टोरेज की सूची",
'header_s_3'            =>	 "स्टोरेज जोड़ें",
'header_s_4'            =>	 "स्टोरेज संपादित करें",
'opt_storeagehelp'		=>	 "इस अनुभाग में आप विभिन्न बाहरी स्टोरेज जोड़ सकते हैं जहाँ इमेज, मल्टीमीडिया फ़ाइलें और अन्य अपलोड किए जाएंगे। बाहरी स्टोरेज जोड़ने के बाद, आप एडमिन पैनल में स्क्रिप्ट सेटिंग्स में चुन सकते हैं कि कौन सी फ़ाइलें किस स्टोरेज में अपलोड की जानी चाहिए। आप उपयोगकर्ता समूह सेटिंग्स में उपयोगकर्ता को फ़ाइल सर्वर पर अपलोड होने से ठीक पहले स्टोरेज चुनने की अनुमति भी दे सकते हैं।",
'storage_name'			=>	 "स्टोरेज का नाम:",
