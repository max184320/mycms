'com_gast'              =>  "अतिथि:",
'opt_sys_wwws'          =>  "WWW डोमेन से रीडायरेक्ट सक्षम करें",
'opt_sys_wwwsd'         =>  "यदि यह सेटिंग सक्षम है, तो जो उपयोगकर्ता WWW डोमेन का उपयोग करके आपकी साइट पर आते हैं, उन्हें स्वचालित रूप से बिना WWW वाले डोमेन पर रीडायरेक्ट कर दिया जाएगा। उदाहरण के लिए, यदि कोई उपयोगकर्ता www.site.ru पर जाता है, तो उसे स्वचालित रूप से site.ru पर रीडायरेक्ट कर दिया जाएगा।",
'filter_search_11'      =>  "पूरा नाम",
