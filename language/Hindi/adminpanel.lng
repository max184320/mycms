// 11.3
'delete_selected'		=>	"क्या आप वाकई चयनित फ़ाइलों को हटाना चाहते हैं? इस क्रिया को रद्द नहीं किया जा सकेगा।",
'find_rbanners'			=>	"विज्ञापन सामग्री",
'rebuild_s_1'			=>  "पुनर्निर्माण यहाँ से शुरू करें:",
'rebuild_s_2'			=>  "प्रकाशन (यदि आप शुरू से पुनर्निर्माण शुरू करना चाहते हैं तो 0 दर्ज करें)",
'rebuild_s_3'			=>  "टिप्पणी (यदि आप शुरू से पुनर्निर्माण शुरू करना चाहते हैं तो 0 दर्ज करें)",
'opt_crebuild'			=>  "टिप्पणियों का पुनर्निर्माण",
'rebuild_cinfo'			=>  "यह उपयोगिता साइट पर सभी टिप्पणियों का पुनर्निर्माण करती है। यह क्रिया तब की जानी चाहिए जब आपने स्क्रिप्ट सेटिंग्स में बदलाव किए हों जिन्हें प्रभावी होने के लिए टिप्पणियों को फिर से सहेजने की आवश्यकता हो, ताकि वे पुरानी टिप्पणियों में भी दिखाई दें। या स्क्रिप्ट पार्सर में अपने स्वयं के परिवर्तनों के मामले में, उदाहरण के लिए, BB टैग में परिवर्तन। या स्क्रिप्ट के नए संस्करणों में जोड़े गए नए फीचर्स को प्रभावी करने के लिए।<br /><br /><b>ध्यान दें:</b> शुरू करने से पहले डेटाबेस का बैकअप बनाना न भूलें, क्योंकि गलत या अप्रत्याशित काम के मामले में इस क्रिया को रद्द नहीं किया जा सकता है।",
'stat_m_fail_1'			=>	"<b>ध्यान दें:</b><br>आपने सर्वर सेटिंग्स में Memcache कैशिंग सक्षम की है, जबकि आपके सर्वर पर PHP Memcached एक्सटेंशन इंस्टॉल नहीं है। आपको PHP के लिए इस एक्सटेंशन को इंस्टॉल करने के लिए अपनी होस्टिंग सहायता सेवा से संपर्क करना होगा।",
'opt_sys_mcac'			=>  "संक्षिप्त प्रकाशन दिखाते समय कैश किए जाने वाले साइट पृष्ठों की संख्या",
'opt_sys_mcacd'			=>  "साइट नेविगेशन में उन पृष्ठों की संख्या निर्दिष्ट करें जिनके लिए संक्षिप्त समाचार आउटपुट का कैशिंग करना है। कैश बनाना और अपडेट करना भी एक संसाधन-गहन ऑपरेशन है, इसलिए कम विज़िट किए गए पृष्ठों के लिए कैश बनाना प्रभावी नहीं है। उदाहरण के लिए, यदि आप 10 निर्दिष्ट करते हैं, तो साइट नेविगेशन के पहले 10 पृष्ठ कैश किए जाएंगे, और बाद के पृष्ठ नहीं। पृष्ठों की संख्या बढ़ाने से अतिरिक्त डिस्क स्थान की खपत होती है।",
'opt_sys_https'			=>  "हमेशा HTTPS प्रोटोकॉल का उपयोग करें",
'opt_sys_httpsd'		=>  "यदि यह सेटिंग सक्षम है, तो जो उपयोगकर्ता सामान्य HTTP प्रोटोकॉल के माध्यम से आपकी साइट पर आते हैं, उन्हें स्वचालित रूप से सुरक्षित SSL कनेक्शन का उपयोग करने के लिए निर्देशित किया जाएगा।",
'group_fuf'				=>  "फीडबैक में फ़ाइलें भेजने की अनुमति दें",
'group_fufd'			=>  "इस सेटिंग को सक्षम करने पर उपयोगकर्ता फीडबैक में ईमेल के साथ संलग्न फ़ाइलें भी भेज सकेंगे।",
'group_fuf2'			=>  "फीडबैक में भेजी जाने वाली फ़ाइलों की अधिकतम संख्या",
'group_fufd2'			=>  "उपयोगकर्ताओं को फीडबैक के माध्यम से फ़ाइलें भेजने की अनुमति देने के मामले में। आप फ़ाइलों की अधिकतम संख्या निर्दिष्ट कर सकते हैं जिन्हें एक उपयोगकर्ता भेज सकता है।",
'group_fuf3'			=>  "फीडबैक के माध्यम से भेजने के लिए अनुमत सभी फ़ाइलों का अधिकतम आकार (किलोबाइट में)",
'group_fufd3'			=>  "किलोबाइट में सभी फ़ाइलों का अधिकतम आकार निर्दिष्ट करें जिन्हें फीडबैक के माध्यम से ईमेल में भेजने की अनुमति है।",
'group_fuf4'			=>  "फीडबैक के माध्यम से भेजने के लिए अनुमत फ़ाइल एक्सटेंशन",
'group_fufd4'			=>  "उन फ़ाइलों के एक्सटेंशन को कॉमा से अलग करके निर्दिष्ट करें जिन्हें फीडबैक के माध्यम से ईमेल में भेजने की अनुमति है",
'sess_error'			=>	"आपका उपयोगकर्ता सत्र समाप्त हो गया है, ब्राउज़र में पृष्ठ को पुन: लोड करें और यदि आवश्यक हो तो साइट पर फिर से लॉग इन करें।",
'opt_redirects'			=>	"रीडायरेक्ट",
'opt_redirectsc'		=>	"इस अनुभाग में आप एक पृष्ठ से दूसरे पृष्ठ पर विभिन्न रीडायरेक्ट बना सकते हैं।",
'opt_redirectshelp'		=>	"इस अनुभाग में आप एक पृष्ठ से दूसरे पृष्ठ पर रीडायरेक्ट बना सकते हैं। रीडायरेक्ट आपकी साइट के एक पृष्ठ से आपकी अपनी साइट के दूसरे URL या किसी बाहरी संसाधन पर किया जा सकता है। आप &#39;*&#39; प्रतीक का उपयोग करके URL के समूह को भी निर्दिष्ट कर सकते हैं, जिसका अर्थ है किसी भी वर्ण द्वारा खोज करना, उदाहरण के लिए /page/*/ निर्दिष्ट करने पर रीडायरेक्ट /page/1/, /page/2/, /page/कोई भी टेक्स्ट/ आदि पृष्ठों से किया जाएगा।",
'header_r_1'			=>	"साइट पर रीडायरेक्ट का प्रबंधन",
'header_r_2'			=>	"लिंक जहाँ से रीडायरेक्ट होगा",
'header_r_3'			=>	"लिंक जहाँ पर रीडायरेक्ट होगा",
'redirects_not_found'	=>	"आपने अभी तक साइट पर कोई रीडायरेक्ट नहीं बनाया है",
'redirects_not_found_1'	=>	"निर्दिष्ट मापदंड के अनुसार कुछ भी नहीं मिला",
'input_oldurl'			=>	"वह लिंक दर्ज करें जहाँ से रीडायरेक्ट करना आवश्यक है",
'input_newurl'			=>	"वह लिंक दर्ज करें जहाँ पर रीडायरेक्ट करना आवश्यक है",
'redirects_err'			=>	"रीडायरेक्ट के लिए लिंक निर्दिष्ट नहीं हैं",
'redirects_err_2'		=>	"पृष्ठों के लिंक समान नहीं होने चाहिए",
