'device_mobile'			=>	"स्मार्टफोन",
'xf_group_add'			=>	"निम्नलिखित उपयोगकर्ता समूहों के लिए जोड़ने की अनुमति दें:",
'xf_group_view'			=>	"निम्नलिखित उपयोगकर्ता समूहों के लिए देखने की अनुमति दें:",
'trial_act7'			=>	"आपकी लाइसेंस कुंजी की अवधि समाप्त हो चुकी है। आप इसका उपयोग स्क्रिप्ट के उन संस्करणों में नहीं कर सकते जो आपकी लाइसेंस अवधि समाप्त होने के बाद जारी किए गए थे। इस संस्करण में अपनी कुंजी का उपयोग करने के लिए आपको साइट <a href=\"https://dle-news.com\" target=\"_blank\">https://dle-news.com</a> पर अपना लाइसेंस नवीनीकृत करना होगा",
