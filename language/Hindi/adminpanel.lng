'plugins_upload'		=>	"साइट पर प्लगइन अपलोड करना",
'plugins_errors'		=>	"इस प्लगइन के काम में त्रुटियां पाई गई हैं।",
'plugins_errors_1'		=>	"त्रुटियां दिखाएं",
'plugins_errors_2'		=>	"त्रुटियां साफ़ करें",
'plugins_errors_3'		=>	"कोई त्रुटि नहीं मिली",
'plugins_errors_4'		=>	"कोड नहीं मिल सका:",
'plugins_errors_5'		=>	"सामान्य समस्या",
'stat_secfault_5'		=>	"<b>सुरक्षा अनुशंसा:</b><br><br>प्लगइन्स जोड़ने और एडिट करने का काम पूरा करने के बाद, सुरक्षा कारणों से, हम प्लगइन सिस्टम को केवल रीड-ओनली मोड में स्विच करने की सलाह देते हैं। ऐसा करने के लिए, फ़ाइल <b>engine/classes/plugins.class.php</b> खोलें, उसमें <b>define(&#39;PLUGINS_READ_ONLY&#39;, false);</b> खोजें और उसे <b>define(&#39;PLUGINS_READ_ONLY&#39;, true);</b> से बदल दें।<br><br>यह आपके प्लगइन्स को केवल कार्य और पढ़ने के मोड में बदल देगा। वे काम करना जारी रखेंगे, लेकिन उन्हें बदला नहीं जा सकेगा और नए प्लगइन नहीं जोड़े जा सकेंगे। इस तरह आप अपनी साइट को संशोधनों से सुरक्षित रखेंगे, भले ही बाहरी व्यक्तियों को स्क्रिप्ट के कंट्रोल पैनल का एक्सेस मिल जाए।",
'plugins_errors_6'		=>	"प्लगइन सिस्टम रीड-ओनली मोड में काम कर रहा है। साइट एडमिनिस्ट्रेटर ने प्लगइन्स पर किसी भी क्रिया को प्रतिबंधित कर दिया है। प्लगइन्स पर क्रियाओं को अनलॉक करने के लिए, आपको फ़ाइल <b>engine/classes/plugins.class.php</b> खोलनी होगी, उसमें <b>define(&#39;PLUGINS_READ_ONLY&#39;, true);</b> खोजना होगा और उसे <b>define(&#39;PLUGINS_READ_ONLY&#39;, false);</b> से बदलना होगा।",
'plugins_errors_7'		=>	"फ़ाइल <b>{file}</b> सुरक्षित फ़ाइलों की सूची में है। इसे प्लगइन सिस्टम का उपयोग करके संशोधित नहीं किया जा सकता है।",
'plugins_errors_8'		=>	"प्लगइन्स अपलोड करने के लिए केवल XML और ZIP फ़ाइलों का उपयोग किया जा सकता है।",
'plugins_errors_9'		=>	"आपके आर्काइव में प्लगइन नहीं मिला। प्लगइन फ़ाइल आर्काइव के रूट में होनी चाहिए और उसका एक्सटेंशन xml होना चाहिए",
'plugins_errors_10'		=>	"आपके आर्काइव में मूल DataLife Engine फ़ाइलें पाई गई हैं, जो डिस्ट्रीब्यूशन का हिस्सा हैं। आर्काइव में केवल अतिरिक्त फ़ाइलें हो सकती हैं जो प्लगइन के काम के लिए आवश्यक हैं। मानक फ़ाइलों में बदलाव आपके प्लगइन की XML फ़ाइल में वर्णित होने चाहिए",
'related_not_found'		=>	"साइट पर कोई संबंधित लेख नहीं मिला।",
'no_referer'			=>	"HTTP_REFERER हेडर गलत है या परिभाषित नहीं है। इस क्रिया को करने के लिए यह हेडर अनिवार्य है। यदि आपने सेटिंग्स में एडमिन पैनल का नाम बदल दिया है, तो सुनिश्चित करें कि आप पैनल में हैं और बदले हुए पते पर ही हैं। यह भी संभव है कि आप इस पेज पर किसी अनधिकृत पेज से आए हैं, या आप प्रॉक्सी सर्वर के पीछे हैं जिसने HTTP_REFERER हेडर हटा दिया है। प्रॉक्सी सर्वर का उपयोग करने के मामले में, इसे सही HTTP_REFERER हेडर पास करने के लिए कॉन्फ़िगर करें या इसे अक्षम करें।",
'only_unread_pm'		=>	"केवल पढ़े गए व्यक्तिगत संदेश",
'disabled_comments'		=>	"टिप्पणियों पर प्रतिबंध",
'disabled_news'			=>	"प्रकाशनों पर प्रतिबंध",
'have_poll'				=>	"प्रकाशन के लिए पोल सेट किया गया है",
'have_pass'				=>	"प्रकाशन के लिए पासवर्ड सेट किए गए हैं",
'add_s_5' 	    		=>  "साइट पर देखें",
'opt_sys_plugins'		=>	"&#39;प्लगइन्स&#39; मॉड्यूल का सपोर्ट सक्षम करें",
'opt_sys_pluginsd'		=>	"इस मॉड्यूल को अक्षम करने से डेटाबेस क्वेरी की बचत होती है और पेज लोड होने का समय कम हो जाता है। यदि आप स्क्रिप्ट के लिए अतिरिक्त प्लगइन्स का उपयोग नहीं करते हैं, तो उन्हें अक्षम कर दें।",
