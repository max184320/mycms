// 15.3
'opt_sys_acsort'		=>  "उपयोगकर्ताओं को प्रकाशन की श्रेणियों के सॉर्ट क्रम को बदलने की अनुमति दें",
'opt_sys_acsortd'		=>  "इस सेटिंग को सक्षम करने पर, प्रकाशन की श्रेणियां उस क्रम में प्रदर्शित होंगी जिसमें लेखक ने उन्हें चुना है। यदि अक्षम किया गया है, तो श्रेणियां उस क्रम में प्रदर्शित होंगी जिसमें वे श्रेणी सेटिंग्स अनुभाग में डिफ़ॉल्ट रूप से सॉर्ट की गई हैं",
'opt_sys_anedn'			=>  "संपादन करते समय सूचित करें कि समाचार पहले से ही संपादित किया जा रहा है",
'opt_sys_anednd'		=>  "इस सेटिंग को सक्षम करने पर, समाचार संपादित करने के लिए जाते समय, उपयोगकर्ता को एक सूचना प्राप्त होगी यदि प्रकाशन पहले से ही किसी अन्य उपयोगकर्ता द्वारा संपादित किया जा रहा है",
'ignore_error'			=>	"आप स्वयं को अनदेखा (ignore) नहीं कर सकते।",
'ignore_error_1'		=>	"यह उपयोगकर्ता पहले से ही अनदेखा किए गए उपयोगकर्ताओं की सूची में है।",
'ignore_error_2'		=>	"आप व्यवस्थापक (administrator) समूहों के उपयोगकर्ताओं को अनदेखा नहीं कर सकते।",
'ignore_ok'				=>	"उपयोगकर्ता को अनदेखा सूची में जोड़ दिया गया है। अब आपको इस उपयोगकर्ता से संदेश प्राप्त नहीं होंगे। आप अपनी साइट प्रोफ़ाइल में उपयोगकर्ता को अनब्लॉक कर सकते हैं।",
'ignore_del_ok'			=>	"उपयोगकर्ता को अनदेखा सूची से हटा दिया गया है।",
'cat_news_count'		=>	"प्रकाशन:",
'group_rateclim'		=>	"निश्चित टिप्पणी रेटिंग प्राप्त करने पर दूसरे समूह में स्थानांतरित करें",
'group_rateclimd'		=>	"इस सेटिंग को सक्षम करने पर, आपको उपयोगकर्ता की कुल टिप्पणी रेटिंग और वह समूह निर्दिष्ट करना होगा जिसमें उपयोगकर्ता को यह कुल रेटिंग प्राप्त करने पर स्वचालित रूप से स्थानांतरित किया जाएगा।",
'edit_news_alert'		=>  "यह प्रकाशन पहले से ही उपयोगकर्ता <b>{name}</b> द्वारा संपादित किया जा रहा है",
'opt_sys_rnctime'		=>  "समाचार दृश्य (view) गिनने के लिए पृष्ठ पर बिताया गया आवश्यक समय",
'opt_sys_rnctimed'		=>  "इस सेटिंग में आप सेकंड में वह समय निर्दिष्ट करते हैं जिसके बाद उपयोगकर्ता द्वारा इस प्रकाशन का दृश्य गिना जाएगा। यदि उपयोगकर्ता निर्दिष्ट अवधि से कम समय तक पृष्ठ पर रहा, तो पृष्ठ दृश्य नहीं गिना जाएगा। समय सेकंड में इंगित किया जाता है और एक सेकंड से कम नहीं हो सकता",
// 15.3

// 15.2
'opt_sys_recaptsc'		=>	"reCAPTCHA v.3 का उपयोग करते समय Score मान:",
'opt_sys_recaptscd'		=>	"इस मान का उपयोग उस संभावना की जांच करने के लिए किया जाता है कि उपयोगकर्ता रोबोट हो सकता है। यह फ़ील्ड 0 से 1 तक का मान ले सकती है, जहाँ उदाहरण के लिए, 0.1 का अर्थ है कि यह संभवतः रोबोट है, और 0.9 का अर्थ है संभवतः मानव है। आप वह मान निर्दिष्ट कर सकते हैं, जिस पर या उससे ऊपर पहुँचने पर उपयोगकर्ता को मानव माना जाएगा। अनुशंसित मान: 0.5",
'indexnow_error_202'	=>	"नई कुंजी सत्यापन की प्रतीक्षा कर रही है। यदि आप सुनिश्चित हैं कि यह सही है, तो कुछ समय प्रतीक्षा करें और कुछ अन्य पते भेजें।",
'indexnow_error_400'	=>	"अनुरोध के मुख्य भाग (body) में गलत पैरामीटर भेजे गए हैं।",
'indexnow_error_403'	=>	"कुंजी लोड नहीं की जा सकी या यह अनुरोध में निर्दिष्ट पतों से मेल नहीं खाती।",
'indexnow_error_422'	=>	"अमान्य कुंजी। या तो कुंजी का स्थान गलत बताया गया है, या कुंजी फ़ाइल में वह कुंजी ही नहीं है जो स्क्रिप्ट सेटिंग्स में निर्दिष्ट है",
'indexnow_error_429'	=>	"खोज इंजन (search engines) के लिए पहले ही बहुत अधिक सूचनाएं भेजी जा चुकी हैं।",
'opt_sys_turl'			=>	"URL लिप्यंतरण (transliteration) सक्षम करें:",
'opt_sys_turld'			=>	"इस विकल्प को सक्षम करने पर, URL बनाते समय गैर-लैटिन वर्णों का लैटिन में लिप्यंतरण किया जाएगा। उदाहरण के लिए, प्रकाशन का URL इस प्रकार हो सकता है: http://yoursite.com/id-news-title.html. यदि विकल्प अक्षम है, तो URL में मूल वर्ण सुरक्षित रहेंगे।",
'mass_add_cloud'		=>	"टैग क्लाउड के लिए शब्द जोड़ें",
'plugins_not_found_2'	=>  "आपकी खोज के लिए कोई प्लगइन नहीं मिला",
'opt_sys_imshr'			=>	"साझा छवियों (shared images) वाले फ़ोल्डर का स्टोरेज स्थान",
'opt_sys_imshrd'		=>	"वह स्टोरेज निर्दिष्ट करें जहाँ प्रकाशनों के लिए साझा छवियों वाला फ़ोल्डर स्थित है",
'files_max_info_4'		=>	"छवियां अपलोड की गईं: अधिकतम अनुमत <b>{uploaded}</b> में से <b>{count}</b>। आप <b>{allowed}</b> और अपलोड कर सकते हैं",
'files_max_info_5'		=>	"फ़ाइलें अपलोड की गईं: अधिकतम अनुमत <b>{uploaded}</b> में से <b>{count}</b>। आप <b>{allowed}</b> और अपलोड कर सकते हैं",
'google_save'			=>	"निर्धारित मानों को सहेजें?",
'google_changefreq'		=>	"परिवर्तन आवृत्ति (Changefreq):",
'sitemap_changefreq_1'	=>	"हमेशा",
'sitemap_changefreq_2'	=>	"प्रति घंटा",
'sitemap_changefreq_3'	=>	"दैनिक",
'sitemap_changefreq_4'	=>	"साप्ताहिक",
'sitemap_changefreq_5'	=>	"मासिक",
