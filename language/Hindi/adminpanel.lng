'opt_sys_imfsfppd'		=>	"बाहरी FTP / SFTP सर्वर से कनेक्ट करने के लिए उपयोग किया जाने वाला पासवर्ड निर्दिष्ट करें",
'opt_sys_imfsfpa'		=>	"स्टोरेज पर फ़ाइलों का पथ",
'opt_sys_imfsfpad'		=>	"बाहरी स्टोरेज पर फ़ाइलों का पथ निर्दिष्ट करें जिसका उपयोग कनेक्शन के बाद किया जाएगा, जहाँ अपलोड की गई फ़ाइलें सहेजी जाएँगी। उदाहरण के लिए: /root/path/files/",
'opt_sys_imfsfur'		=>	"बाहरी स्टोरेज के लिए HTTP URL पता",
'opt_sys_imfsfurd'		=>	"बाहरी स्टोरेज फ़ोल्डर के लिए HTTP URL पता निर्दिष्ट करें जहाँ फ़ाइलें अपलोड की जाएँगी, और जिसका उपयोग ब्राउज़र से फ़ाइलों को एक्सेस करते समय किया जाएगा। उदाहरण के लिए: https://yoursite.com/myfiles/",
'opt_sys_imerr'			=>	"यदि बाहरी स्टोरेज उपलब्ध नहीं है, तो फ़ाइलों को स्थानीय स्टोरेज में सहेजें",
'opt_sys_imerrd'		=>	"इस सेटिंग को सक्षम करने पर, यदि बाहरी स्टोरेज किसी कारण से उपलब्ध नहीं है, जैसे कि अस्थायी रूप से कोई कनेक्शन नहीं है, तो अपलोड की गई फ़ाइलें और छवियां स्थानीय स्टोरेज में सहेजी जाएँगी। यदि यह सेटिंग अक्षम है और निर्दिष्ट स्टोरेज अनुपलब्ध है, तो फ़ाइलें अपलोड नहीं की जाएँगी, और उपयोगकर्ता को अपलोड त्रुटि की संबंधित सूचना प्राप्त होगी।",
'opt_sys_immr'			=>	"प्रकाशनों के लिए छवियों का स्टोरेज स्थान",
'opt_sys_immrd'			=>	"सर्वर पर अपलोड करते समय प्रकाशनों के लिए छवियां किस स्टोरेज में सहेजी जाएँगी, यह निर्दिष्ट करें। आप स्टोरेज प्रबंधन अनुभाग में नियंत्रण कक्ष में बाहरी स्टोरेज बना सकते हैं",
'opt_sys_imcr'			=>	"टिप्पणियों के लिए छवियों का स्टोरेज स्थान",
'opt_sys_imcrd'			=>	"सर्वर पर अपलोड करते समय टिप्पणियों के लिए छवियां किस स्टोरेज में सहेजी जाएँगी, यह निर्दिष्ट करें।",
'opt_sys_imsr'			=>	"स्थिर पेजों के लिए छवियों का स्टोरेज स्थान",
'opt_sys_imsrd'			=>	"सर्वर पर अपलोड करते समय स्थिर पेजों के लिए छवियां किस स्टोरेज में सहेजी जाएँगी, यह निर्दिष्ट करें।",
'opt_sys_imfr'			=>	"डाउनलोड के लिए फ़ाइलों का स्टोरेज स्थान",
'opt_sys_imfrd'			=>	"सर्वर पर अपलोड करते समय डाउनलोड के लिए फ़ाइलें किस स्टोरेज में सहेजी जाएँगी, यह निर्दिष्ट करें।",
'opt_sys_imar'			=>	"उपयोगकर्ता अवतारों का स्टोरेज स्थान",
'opt_sys_imard'			=>	"सर्वर पर अपलोड करते समय उपयोगकर्ता अवतार किस स्टोरेज में सहेजे जाएँगे, यह निर्दिष्ट करें।",
