// 17.1
's_not_found'           =>   "कुछ नहीं मिला",
'system_find'           =>   "सेटिंग्स में खोजें",
'opt_sys_inden'			=>	 "IndexNow नोटिफिकेशन के लिए प्रदाता",
'opt_sys_indend'		=>	 "IndexNow नोटिफिकेशन के लिए वह प्रदाता चुनें जिसका उपयोग सर्च इंजन को सूचित करने के लिए किया जाएगा। प्रदाता का चयन इस बात को प्रभावित नहीं करता है कि किन सर्च इंजन को सूचित किया जाएगा, वे अंततः सभी स्वचालित रूप से सूचित हो जाएंगे। लेकिन प्रदाता का चयन प्रतिक्रिया की गति और नोटिफिकेशन के उत्तर को प्रभावित करता है, इसलिए वह चुनें जो आपकी साइट को सबसे तेज़ी से जवाब देता है और सबसे करीब स्थित है।",
'opt_sys_qemo'			=>	 "साइट पर पोस्ट के त्वरित संपादन का मोड:",
'opt_sys_qemod'			=>	 "आप वह मोड चुन सकते हैं जिसमें साइट पर त्वरित संपादन किया जाएगा। यदि केवल भरे हुए फ़ील्ड मोड को चुना जाता है, तो त्वरित संपादन के दौरान केवल वही फ़ील्ड प्रदर्शित किए जाएंगे जो समाचार जोड़ते समय पहले भरे गए थे। यदि सभी फ़ील्ड संपादन मोड चुना जाता है, तो त्वरित संपादन में इस पोस्ट के लिए उपलब्ध सभी फ़ील्ड को संपादित और भरा जा सकता है।",
'opt_sys_qemo1'			=>	 "केवल पहले भरे गए फ़ील्ड",
'opt_sys_qemo2'			=>	 "सभी फ़ील्ड",
'opt_sys_imuqid'		=>	 "अपलोड की गई इमेज के नाम में एक यूनिक प्रिफिक्स जोड़ें",
'opt_sys_imuqidd'		=>	 "यदि &#39;सक्षम&#39; है, तो पोस्ट पर अपलोड की गई इमेज के नाम में एक यूनिक प्रिफिक्स जोड़ा जाएगा, जो फ़ाइल नाम को यूनिक बनाता है। यदि &#39;अक्षम&#39; है, तो ऐसा नहीं होगा, और यदि सर्वर पर ऐसी फ़ाइल नहीं है, तो उसका नाम मूल ही रहेगा। यह आमतौर पर तब आवश्यक होता है जब आप एक साथ अलग-अलग फ़ोल्डरों से एक ही नाम वाली फ़ाइलें अपलोड करते हैं, या उदाहरण के लिए, यदि आप ब्राउज़र कैशिंग से बचने के लिए एक ही फ़ाइल को बार-बार अपलोड करते हैं",
'google_set_images'	    =>	 "साइटमैप में पोस्ट के लिए अपलोड की गई इमेज शामिल करें",
'plugins_a_1'		    =>	 "सक्षम करें",
'plugins_a_2'		    =>	 "अक्षम करें",
'plugins_a_3'		    =>	 "डाउनलोड करें",
'plugins_a_4'		    =>	 "अपडेट की जाँच करें",
'plugins_a_5'		    =>	 "अपडेट अपलोड करें",
'xfield_asm'			=>	 "एकाधिक मान चुनने की अनुमति दें",
'xfield_asm1'			=>	 "आप इस सूची से एकाधिक मान चुनने की अनुमति दे सकते हैं या प्रतिबंधित कर सकते हैं। इस विकल्प को अक्षम करने के मामले में, पोस्ट लिखते समय उपयोगकर्ता सूची से केवल एक मान चुन सकेगा।",
'xfield_separator_3'	=>	 "फ़ील्ड के कई मान प्रदर्शित करते समय विभाजक",
'xfield_separator_2'	=>	 "यदि फ़ील्ड के लिए एकाधिक मान चुनने की अनुमति है, तो आप एक विभाजक निर्दिष्ट कर सकते हैं जिसका उपयोग पोस्ट में मानों के बीच किया जाएगा। HTML कोड के उपयोग की भी अनुमति है। यदि आप इस सेटिंग को खाली छोड़ देते हैं, तो कोमा (,) का उपयोग किया जाएगा",
