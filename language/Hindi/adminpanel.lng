'plugins_mydisable'		=>	"प्लगइन अक्षम करते समय:",
'plugins_mydelete'		=>	"प्लगइन हटाते समय:",
'plugins_myinfo'		=>	"MySQL क्वेरी लिखते समय आप निम्नलिखित सर्विस टैग का भी उपयोग कर सकते हैं:<br><br><b>{prefix}</b> - यह टैग उस टेबल प्रीफ़िक्स से बदल दिया जाएगा जो स्क्रिप्ट इंस्टॉल करते समय निर्दिष्ट किया गया था, और DataLife Engine द्वारा अपनी टेबल के लिए उपयोग किया जाता है।<br><b>{userprefix}</b> - यह टैग यूजर टेबल के प्रीफ़िक्स से बदल दिया जाएगा, जिसका उपयोग कई वेबसाइटों पर एकल पंजीकरण और प्राधिकरण के लिए किया जाता है।<br><b>{charset}</b> - यह टैग डेटाबेस टेबल के एन्कोडिंग (charset) से बदल दिया जाएगा जिसका उपयोग स्क्रिप्ट करती है, उदाहरण के लिए utf8 या utf8mb4।<br><b>{engine}</b> - यह टैग उस MySQL इंजन से बदल दिया जाएगा जिसका उपयोग DLE डेटाबेस के लिए करता है। यह InnoDB या MyISAM हो सकता है।<br><br><b>कृपया ध्यान दें:</b> प्लगइन इंस्टॉल करते समय प्लगइन को सक्षम करने वाला ट्रिगर भी स्वचालित रूप से सक्रिय हो जाएगा, और प्लगइन हटाते समय प्लगइन को अक्षम करने वाला ट्रिगर सक्रिय नहीं होगा।",
'plugins_myinfo_1'		=>	"आप डेटाबेस के लिए MySQL क्वेरी निर्दिष्ट कर सकते हैं जो प्लगइन के साथ कुछ क्रियाएं करते समय निष्पादित की जाएंगी:",
'plugins_nerror'		=>	"प्लगइन का नाम भरना अनिवार्य है",
'plugins_nerror_1'		=>	"इस नाम वाला प्लगइन पहले से ही साइट पर इंस्टॉल है",
'plugins_nerror_2'		=>	"यह प्लगइन DLE के इंस्टॉल किए गए वर्ज़न के साथ संगत नहीं है। इस प्लगइन के काम करने के लिए DLE वर्ज़न <b>{version}</b> {versioncompare} की आवश्यकता है। आपका DataLife Engine वर्ज़न <b>{dleversion}</b> है",
'plugins_addfile'		=>	"फ़ाइल जोड़ें",
'plugins_addact'		=>	"क्रिया जोड़ें",
'plugins_filename'		=>	"फ़ाइल का नाम:",
'plugins_file_h'		=>	"उस फ़ाइल का नाम निर्दिष्ट करें जिसके लिए यह क्रिया होगी। केवल php या lng फ़ाइलें निर्दिष्ट की जानी चाहिए। फ़ाइल का पथ आपकी साइट के रूट के सापेक्ष निर्दिष्ट किया जाना चाहिए, उदाहरण के लिए engine/modules/main.php",
'plugins_f_del'			=>	"क्या आप वाकई इस फ़ाइल पर सभी क्रियाओं को हटाना चाहते हैं?",
'plugins_a_del'			=>	"क्या आप वाकई चुनी गई क्रिया को हटाना चाहते हैं?",
