// 9.6
'banners_s_opt'			=>	"संक्षिप्त समाचारों के बीच ब्लॉक का प्रदर्शन",
'banners_fpage'			=>	"केवल अनुभाग या श्रेणी के पहले पृष्ठ पर प्रदर्शित करें",
'dumper_32'				=>	"त्रुटि: आप एक ऐसे डेटाबेस को पुनर्स्थापित करने का प्रयास कर रहे हैं जो स्क्रिप्ट के संस्करण से मेल नहीं खाता है। अन्य संस्करणों से डेटाबेस पुनर्स्थापित करना डेटाबेस संरचना को बाधित कर सकता है और स्क्रिप्ट को निष्क्रिय कर सकता है।",
'send_pm'				=>	"संदेश भेजें",
'group_d_cc'			=>	"टिप्पणियों के लिए CAPTCHA सुरक्षा कोड और प्रश्न-उत्तर प्रणाली को अक्षम करना",
'hint_d_cc'				=>	"आप टिप्पणियों की वह संख्या निर्दिष्ट कर सकते हैं जिसके बाद इस समूह के लिए CAPTCHA और प्रश्न-उत्तर प्रणाली स्वचालित रूप से अक्षम हो जाएगी। इन प्रणालियों को कभी अक्षम न करने के लिए, 0 निर्दिष्ट करें।",
'group_d_nc'			=>	"समाचारों के लिए CAPTCHA सुरक्षा कोड और प्रश्न-उत्तर प्रणाली को अक्षम करना",
'hint_d_nc'				=>	"आप समाचारों की वह संख्या निर्दिष्ट कर सकते हैं जिनके प्रकाशन के बाद इस समूह के लिए CAPTCHA और प्रश्न-उत्तर प्रणाली स्वचालित रूप से अक्षम हो जाएगी। इन प्रणालियों को कभी अक्षम न करने के लिए, 0 निर्दिष्ट करें।",
'opt_relrebuild'		=>  "समान समाचार कैश का पुनर्निर्माण",
'rebuild_rel_info'		=>  "यह उपयोगिता साइट पर समान समाचारों के कैश का पुनर्निर्माण करती है। साइट पर समान समाचारों की खोज केवल प्रकाशन के पहले प्रदर्शन के दौरान की जाती है, जिसके बाद मिले प्रकाशनों के कैश का उपयोग किया जाता है। यदि साइट अन्य जानकारी से भर जाती है और आप चाहते हैं कि नए समाचार भी समान समाचारों की सूची में दिखाई दें, तो आप कैश को रीसेट कर सकते हैं और डेटाबेस में समान प्रकाशनों के लिए एक नई खोज की जाएगी।<br /><br /><b>ध्यान दें:</b> शुरू करने से पहले डेटाबेस का बैकअप बनाना न भूलें, क्योंकि गलत या अप्रत्याशित संचालन के मामले में इस क्रिया को पूर्ववत करना संभव नहीं होगा।",
'add_disable_index'		=>  "खोज इंजन के लिए अनुक्रमण (indexing) प्रतिबंधित करें",
'media_upload'			=>	"सर्वर पर चित्र और फ़ाइलें अपलोड करें",
'media_upload_url'		=>	"चित्र का लिंक:",
'media_upload_title'	=>	"चित्र का विवरण",
'media_upload_ip2'		=>	"पूर्वावलोकन",
'media_upload_ip3'		=>	"मूल",
'media_upload_ip4'		=>	"डाउनलोड लिंक",
