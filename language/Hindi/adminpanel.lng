'find_done_h'			=>  "प्रतिस्थापन पूरा हुआ",
'find_done'				=>  "डेटाबेस में टेक्स्ट सफलतापूर्वक बदल दिया गया है।",
'mail_info_3'			=>	"साइट पर नया समाचार जोड़ते समय भेजे जाने वाले ई-मेल संदेश की सेटिंग",
'mail_news_info'		=>	"इस संदेश के लिए टेम्पलेट लिखते समय आप निम्नलिखित टैग का उपयोग कर सकते हैं:<br /><b>{%title%}</b> - समाचार का शीर्षक<br /><b>{%username%}</b> - समाचार जोड़ने वाला उपयोगकर्ता<br /><b>{%date%}</b> - समाचार जोड़ने की तिथि<br /><b>{%category%}</b> - वह श्रेणी जिसमें समाचार जोड़ा गया है",
'mail_info_4'			=>	"साइट पर नई टिप्पणी जोड़ते समय भेजे जाने वाले ई-मेल संदेश की सेटिंग",
'mail_comm_info'		=>	"इस संदेश के लिए टेम्पलेट लिखते समय आप निम्नलिखित टैग का उपयोग कर सकते हैं:<br /><b>{%title%}</b> - समाचार का शीर्षक<br /><b>{%link%}</b> - समाचार का लिंक<br /><b>{%username%}</b> - टिप्पणी जोड़ने वाला उपयोगकर्ता<br /><b>{%date%}</b> - टिप्पणी जोड़ने की तिथि<br /><b>{%ip%}</b> - उपयोगकर्ता का IP<br /><b>{%text%}</b> - टिप्पणी का टेक्स्ट<br /><b>{%unsubscribe%}</b> - वह लिंक जिससे उपयोगकर्ता समाचार की टिप्पणियों से अनसब्सक्राइब कर सकता है",
'opt_sys_nmail'			=>	"नया समाचार प्राप्त होने पर ई-मेल अधिसूचना भेजें",
'opt_sys_cmaild'		=>	"यदि &#39;सक्षम&#39; है, तो साइट पर टिप्पणी जोड़ने पर सेटिंग्स में निर्दिष्ट ई-मेल पर संबंधित अधिसूचना भेजी जाएगी।",
'bb_t_leech'			=>	"सुरक्षित लिंक डालें",
'opt_sys_nmaild'		=>	"यदि &#39;सक्षम&#39; है, तो साइट से समाचार जोड़ते समय जो मॉडरेशन की प्रतीक्षा कर रहा है, सेटिंग्स में निर्दिष्ट ई-मेल पर संबंधित अधिसूचना भेजी जाएगी।",
'opt_sys_cmail'			=>	"टिप्पणियाँ जोड़े जाने पर व्यवस्थापक को ई-मेल अधिसूचना भेजें",
