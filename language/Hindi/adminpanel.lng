'media_upload_st5'		=>	"अपलोड शुरू करने के लिए फ़ाइलों को यहाँ खींचें",
'media_upload_st6'		=>	"फ़ाइल अपलोड हो रही है:",
'media_upload_st8'		=>	"में से",
'media_upload_st9'		=>	"सफलतापूर्वक पूर्ण हुई",
'media_upload_st10'		=>	"त्रुटि के साथ समाप्त हुआ",
'media_upload_st11'		=>	"फ़ाइल {file} का विस्तार गलत है। केवल {extensions} अपलोड करने की अनुमति है।",
'media_upload_st12'		=>	"फ़ाइल {file} का आकार बहुत बड़ा है, अधिकतम अनुमत फ़ाइल आकार: {sizeLimit}।",
'media_upload_st13'		=>	"फ़ाइल {file} खाली है, कृपया फ़ाइलें फिर से चुनें।",
'upload_error_3'		=>	"अपलोड करने के लिए कोई फ़ाइल नहीं चुनी गई।",
'upload_error_4'		=>	"चुना गया फ़ाइल नाम असुरक्षित है या अपलोड के लिए अनुमति नहीं है।",
'upload_error_5'		=>	"अपलोड की जा रही फ़ाइल खाली है या उस तक पहुँच संभव नहीं है।",
'upload_error_6'		=>	"यह फ़ाइल एक चित्र नहीं है।",
'uploaded_file_list'	=>	"अपलोड की गई फ़ाइलों की सूची",
'opt_sys_ccache'		=>	"साइट पर टिप्पणियों का कैशिंग सक्षम करें",
'opt_sys_ccached'		=>	"यह विकल्प आपको पूर्ण समाचार दिखाते समय साइट पर टिप्पणियों के कैशिंग को सक्षम करने की अनुमति देता है, जो साइट पर लोड कम करने में मदद करता है। टिप्पणियों का कैशिंग केवल तभी काम करता है जब साइट पर सामान्य कैशिंग सक्षम हो। यदि आप टिप्पणी पृष्ठों पर उपयोगकर्ताओं की <b>online</b> स्थिति प्रदर्शित करते हैं, तो कैशिंग सक्षम करने से इस स्थिति में आंशिक रूप से पुरानी जानकारी दिखाई दे सकती है।",
