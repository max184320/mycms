'filter_search_8'		=>	"विवरण",
'filter_search_9'		=>	"पृष्ठ टेक्स्ट",
'drop_search'			=>	"खोज रीसेट करें",
'change_domain'			=>	"साइट को दूसरे डोमेन पर ले जाएं",
'old_domain'			=>	"पुराना डोमेन नाम दर्ज करें:",
'new_domain'			=>	"नया डोमेन नाम दर्ज करें:",
'change_domain_h'		=>	"ध्यान दें, डोमेन बदलने से प्रकाशनों, सेटिंग्स और उपयोगकर्ता अवतारों में डोमेन जानकारी बदल जाएगी। शुरू करने से पहले, डेटाबेस और सेटिंग्स का बैकअप लें। नया डोमेन नाम पूरा दर्ज किया जाना चाहिए, जिसमें प्रोटोकॉल और अंत में स्लैश शामिल हो।",
'opt_sys_laz'			=>	"छवियों की लेज़ी लोडिंग",
